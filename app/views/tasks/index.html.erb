<% content_for :title, "Задачи — Echo" %>
<%= render "shared/unified_header" %>

<div class="echo-page">
  <header class="echo-page__heading">
    <div>
      <p class="echo-kicker">Работа, а не календарные квадраты</p>
      <h1 class="echo-title">Задачи</h1>
      <p class="echo-subtitle">Здесь живёт намерение. Планер хранит только выбранное время.</p>
    </div>
    <div class="echo-actions">
      <%= link_to "Проекты", projects_path, class: "echo-button echo-button--quiet" %>
      <%= link_to "Ритмы", rhythms_path, class: "echo-button echo-button--quiet" %>
      <%= link_to "Открыть планер", calendar_events_path(view: "month"), class: "echo-button" %>
    </div>
  </header>

  <% if flash[:task_notice] %><div class="echo-notice"><%= flash[:task_notice] %></div><% end %>
  <% if alert.present? %><div class="echo-notice" role="alert"><%= alert %></div><% end %>

  <% if @focus_tasks.any? %>
    <section class="echo-weekly-focus mb-5" data-weekly-focus aria-labelledby="weekly-focus-heading">
      <div class="echo-weekly-focus__header">
        <div>
          <p class="echo-label echo-label--accent">Сначала</p>
          <h2 id="weekly-focus-heading" class="echo-section-heading mt-1">Три ближайшие задачи</h2>
        </div>
        <p>Сроки впереди, затем порядок добавления.</p>
      </div>
      <div class="echo-weekly-focus__list">
        <% @focus_tasks.each_with_index do |task, index| %>
          <%= render "task_row", task: task, status: @status, focus_rank: index + 1 %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section id="quick-add" class="echo-surface echo-surface--accent mb-5">
    <div class="echo-surface__header">
      <p class="echo-label echo-label--accent">Quick add</p>
      <h2 class="echo-section-heading mt-1">Зафиксировать и продолжить день</h2>
    </div>
    <div class="echo-surface__body">
      <%= render "tasks/quick_capture", task: @new_task, projects: @active_projects, return_to: "tasks" %>
    </div>
  </section>

  <nav class="echo-tabs mb-4" aria-label="Статусы задач">
    <% labels = { "inbox" => "Входящие", "next" => "Следующие", "scheduled" => "Запланировано", "waiting" => "Жду", "someday" => "Когда-нибудь", "completed" => "Готово", "dropped" => "Убрано" } %>
    <% labels.each do |status, label| %>
      <% active = status == @status %>
      <%= link_to tasks_path(status: status), class: "echo-tab", aria: (active ? { current: "page" } : {}) do %>
        <%= label %><span class="echo-count"><%= @task_counts[status].to_i %></span>
      <% end %>
    <% end %>
  </nav>

  <% if @status == "someday" %>
    <p class="echo-section-copy mb-4">Оставить без изменений — значит сохранить задачу здесь. Отдельного действия не требуется.</p>
    <div class="echo-someday-sections">
      <% @task_groups.sort_by { |project, _| project ? [0, project.position, project.name] : [1, 0, ""] }.each do |project, tasks| %>
        <section class="echo-surface" data-project-section="<%= project&.id || 'none' %>">
          <div class="echo-surface__header"><h2 class="echo-section-heading"><%= project&.name || "Без проекта" %></h2></div>
          <div><%= render partial: "task_row", collection: tasks, as: :task, locals: { status: @status } %></div>
        </section>
      <% end %>
      <% if @tasks.empty? %><div class="echo-empty">Здесь пусто. Ничего не нужно сохранять ради системы.</div><% end %>
    </div>
  <% else %>
    <section class="echo-surface" data-task-list>
      <% if @focus_tasks.any? %>
        <div class="echo-surface__header echo-task-list-heading">
          <div><p class="echo-label">Дальше</p><h2 class="echo-section-heading mt-1">Остальная очередь</h2></div>
          <span class="echo-badge"><%= @listed_tasks.size %></span>
        </div>
      <% end %>
      <%= render partial: "task_row", collection: @listed_tasks, as: :task, locals: { status: @status } %>
      <% if @tasks.empty? %><div class="m-5 echo-empty"><p class="m-0 font-semibold" style="color:var(--ink-secondary)">Здесь пусто</p><p class="mt-2 text-sm">Хорошо. Пустая колонка не требует заполнения ради системы.</p></div><% end %>
      <% if @tasks.any? && @listed_tasks.empty? %><div class="m-5 echo-empty">Вся ближайшая очередь уже показана выше.</div><% end %>
    </section>
  <% end %>
</div>
