<% content_for :title, "Обзор — Echo" %>
<%= render "shared/unified_header" %>
<div class="mx-auto max-w-[1300px] px-4 pb-28 pt-7 sm:px-6 md:pb-12">
  <div class="mb-7"><p class="text-xs font-bold uppercase tracking-[.18em] text-violet-400">Закрыть день за две минуты</p><h1 class="mt-2 text-3xl font-semibold text-white">Обзор и восстановление</h1><p class="mt-2 text-sm text-zinc-500">Не собирай данные руками. Реши только, что завершить, перенести, делегировать или убрать.</p></div>
  <div class="grid gap-5 lg:grid-cols-2">
    <section class="rounded-2xl border border-white/10 bg-[#12151d] p-5"><div class="mb-4 flex items-center justify-between"><h2 class="text-xl font-semibold text-white">Сегодня завершено</h2><span class="text-2xl font-semibold text-emerald-300"><%= @completed_tasks.count %></span></div><% @completed_tasks.each do |task| %><div class="mb-2 rounded-xl bg-emerald-400/[.05] p-3"><p class="font-medium text-zinc-200"><%= task.title %></p><p class="mt-1 text-xs text-zinc-600"><%= task.completed_at && l(task.completed_at, format: :short) %></p></div><% end %><% if @completed_tasks.empty? %><p class="text-sm text-zinc-500">Ничего не отмечено завершённым. Это факт, не оценка дня.</p><% end %></section>
    <section class="rounded-2xl border <%= @overdue_tasks.any? ? 'border-amber-400/25' : 'border-white/10' %> bg-[#12151d] p-5"><div class="mb-4 flex items-center justify-between"><h2 class="text-xl font-semibold text-white">Риск и просрочка</h2><span class="text-2xl font-semibold text-amber-300"><%= @overdue_tasks.count %></span></div><% @overdue_tasks.limit(8).each do |task| %><div class="mb-2 rounded-xl bg-amber-400/[.05] p-3"><p class="font-medium text-zinc-200"><%= task.title %></p><p class="mt-1 text-xs text-amber-300">дедлайн <%= l(task.due_on, format: :short) %> · не переносим молча</p></div><% end %><% if @overdue_tasks.empty? %><p class="text-sm text-zinc-500">Критической просрочки нет.</p><% end %></section>
    <section class="rounded-2xl border border-white/10 bg-[#12151d] p-5"><h2 class="mb-4 text-xl font-semibold text-white">Жду</h2><% @waiting_tasks.limit(8).each do |task| %><div class="mb-2 rounded-xl bg-white/[.025] p-3"><p class="font-medium text-zinc-200"><%= task.title %></p><p class="mt-1 text-xs text-zinc-600"><%= task.next_action.presence || "Нужно указать, от кого и чего ждём" %></p></div><% end %><% if @waiting_tasks.empty? %><p class="text-sm text-zinc-500">Никто не держит следующий ход.</p><% end %></section>
    <section class="rounded-2xl border border-white/10 bg-[#12151d] p-5"><h2 class="mb-4 text-xl font-semibold text-white">Проверенные результаты ассистента</h2><% @recent_evidence.each do |receipt| %><div class="mb-2 rounded-xl bg-violet-400/[.05] p-3"><p class="font-medium text-zinc-200"><%= receipt.summary %></p><p class="mt-1 text-xs text-zinc-600"><%= receipt.receipt_type.humanize %> · <%= l(receipt.occurred_at, format: :short) %></p></div><% end %><% if @recent_evidence.empty? %><p class="text-sm text-zinc-500">Новых verified evidence нет.</p><% end %></section>
  </div>
  <section class="mt-5 rounded-2xl border border-violet-400/20 bg-violet-500/[.06] p-5"><p class="text-xs font-bold uppercase tracking-wider text-violet-300">Первый credible outcome завтра</p><div class="mt-3 flex flex-wrap gap-2"><% @tomorrow_tasks.each do |task| %><span class="rounded-xl border border-violet-400/15 bg-black/10 px-3 py-2 text-sm text-zinc-200"><%= task.title %></span><% end %><% if @tomorrow_tasks.empty? %><span class="text-sm text-zinc-500">Завтра ещё не перегружено. Выбери один результат утром.</span><% end %></div></section>
</div>
