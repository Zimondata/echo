<% content_for :title, "Дневник здоровья" %>

<style>
  /* === AURI HEALTH PAGE - Linear + Amie Style === */

  .animated-bg {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: -1;
    overflow: hidden;
  }

  .animated-bg::before {
    content: '';
    position: absolute;
    top: -50%; left: -50%;
    width: 200%; height: 200%;
    background:
      radial-gradient(circle at 20% 80%, rgba(139, 92, 246, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 40% 40%, rgba(59, 130, 246, 0.08) 0%, transparent 40%);
    animation: gradientMove 20s ease-in-out infinite;
  }

  @keyframes gradientMove {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(2%, 2%) rotate(1deg); }
    50% { transform: translate(-1%, 3%) rotate(-1deg); }
    75% { transform: translate(3%, -2%) rotate(2deg); }
  }

  .gradient-text {
    background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 50%, #6366f1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-link {
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }

  .nav-link:hover { color: var(--text-primary); background: rgba(255, 255, 255, 0.05); }
  .nav-link.active { color: var(--text-primary); background: var(--violet-glow); box-shadow: 0 0 20px var(--violet-glow); }

  .glass-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    backdrop-filter: blur(20px);
    transition: all 0.2s ease;
  }

  .glass-card:hover {
    border-color: var(--border-glow);
    background: var(--bg-card-hover);
  }

  .stat-card {
    padding: 20px;
    border-radius: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .stat-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--accent-color, var(--violet-500));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .stat-card:hover::before { opacity: 1; }
  .stat-card:hover { transform: translateY(-2px); border-color: var(--border-glow); }

  .tab-button {
    flex: 1;
    padding: 12px 20px;
    border-radius: 10px;
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    color: var(--text-secondary);
    font-weight: 500;
    font-size: 14px;
  }

  .tab-button:hover { background: rgba(255, 255, 255, 0.05); color: var(--text-primary); }
  .tab-button.active { background: var(--violet-glow); color: var(--text-primary); border-color: var(--border-glow); }

  .tab-panel { transition: all 0.3s ease; }
  .tab-panel.hidden { display: none; }
  .tab-panel.active { display: block; animation: fadeIn 0.3s ease; }

  .meal-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 16px;
    transition: all 0.2s ease;
  }

  .meal-card:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--border-glow);
    transform: translateX(4px);
  }

  .meal-type-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 500;
  }

  .macro-pill {
    padding: 4px 8px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
  }

  .macro-protein { background: rgba(59, 130, 246, 0.15); color: #60a5fa; }
  .macro-fat { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
  .macro-carbs { background: rgba(236, 72, 153, 0.15); color: #f472b6; }

  .action-btn {
    padding: 8px;
    border-radius: 8px;
    transition: all 0.2s ease;
    opacity: 0;
  }

  .meal-card:hover .action-btn { opacity: 1; }
  .action-btn:hover { background: rgba(255, 255, 255, 0.1); }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in { animation: fadeIn 0.4s ease forwards; }
</style>

<!-- Animated Background -->
<div class="animated-bg"></div>

<div class="min-h-screen w-full relative">

  <%= render 'shared/unified_header' %>

  <!-- === MAIN CONTENT === -->
  <div class="w-full px-6 lg:px-8 py-8">

    <!-- Page Header -->
    <div class="mb-8 animate-fade-in">
      <h1 class="text-3xl font-bold text-white mb-2 flex items-center gap-3">
        <svg class="w-8 h-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
        Дневник здоровья
      </h1>
      <p class="text-zinc-500">Питание, активность и анализ дня</p>
    </div>

    <!-- Tabs -->
    <div class="mb-8 glass-card p-1.5 rounded-xl animate-fade-in" style="animation-delay: 0.1s; opacity: 0;">
      <div class="flex gap-1">
        <button class="tab-button active" onclick="switchTab('nutrition')" id="nutrition-tab">
          <span class="flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
            </svg>
            <span>Питание</span>
          </span>
        </button>
        <button class="tab-button" onclick="switchTab('activity')" id="activity-tab">
          <span class="flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            <span>Активность</span>
          </span>
        </button>
        <button class="tab-button" onclick="switchTab('analysis')" id="analysis-tab">
          <span class="flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
            <span>Анализ</span>
          </span>
        </button>
      </div>
    </div>

    <!-- Nutrition Tab -->
    <div id="nutrition-panel" class="tab-panel active">
      <!-- Stats -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="stat-card animate-fade-in" style="--accent-color: var(--violet-500); animation-delay: 0.15s; opacity: 0;">
          <div class="flex items-center gap-4">
            <div class="p-3 rounded-xl bg-violet-500/20">
              <svg class="w-6 h-6 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <div>
              <p class="text-2xl font-bold text-white"><%= @daily_totals[:calories].to_i %></p>
              <p class="text-sm text-zinc-500">ккал</p>
            </div>
          </div>
        </div>

        <div class="stat-card animate-fade-in" style="--accent-color: var(--blue-500); animation-delay: 0.2s; opacity: 0;">
          <div class="flex items-center gap-4">
            <div class="p-3 rounded-xl bg-blue-500/20">
              <span class="text-xl">🥩</span>
            </div>
            <div>
              <p class="text-2xl font-bold text-white"><%= @daily_totals[:protein].to_f.round(1) %></p>
              <p class="text-sm text-zinc-500">г белка</p>
            </div>
          </div>
        </div>

        <div class="stat-card animate-fade-in" style="--accent-color: var(--amber-500); animation-delay: 0.25s; opacity: 0;">
          <div class="flex items-center gap-4">
            <div class="p-3 rounded-xl bg-amber-500/20">
              <span class="text-xl">🥑</span>
            </div>
            <div>
              <p class="text-2xl font-bold text-white"><%= @daily_totals[:fat].to_f.round(1) %></p>
              <p class="text-sm text-zinc-500">г жиров</p>
            </div>
          </div>
        </div>

        <div class="stat-card animate-fade-in" style="--accent-color: var(--pink-500); animation-delay: 0.3s; opacity: 0;">
          <div class="flex items-center gap-4">
            <div class="p-3 rounded-xl bg-pink-500/20">
              <span class="text-xl">🍞</span>
            </div>
            <div>
              <p class="text-2xl font-bold text-white"><%= @daily_totals[:carbs].to_f.round(1) %></p>
              <p class="text-sm text-zinc-500">г углеводов</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Meals -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2">
          <div class="glass-card p-6 animate-fade-in" style="animation-delay: 0.35s; opacity: 0;">
            <div class="flex items-center justify-between mb-6">
              <h2 class="text-lg font-semibold text-white flex items-center gap-2">
                <span class="text-xl">📋</span>
                Приёмы пищи
              </h2>
              <div class="flex gap-1">
                <button onclick="changeDate(-1)" class="p-2 rounded-lg hover:bg-white/10 transition-colors">
                  <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                  </svg>
                </button>
                <button onclick="changeDate(1)" class="p-2 rounded-lg hover:bg-white/10 transition-colors">
                  <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </button>
              </div>
            </div>

            <div class="space-y-6">
              <% meal_types = {
                'breakfast' => ['sunrise', 'Завтрак', '#f59e0b'],
                'lunch' => ['sun', 'Обед', '#eab308'],
                'dinner' => ['moon', 'Ужин', '#6366f1'],
                'snack' => ['apple', 'Перекус', '#10b981']
              } %>
              <% meal_types.each do |meal_type, (icon, name, color)| %>
                <% meals = @meals[meal_type] || [] %>
                <div class="border-l-2 border-violet-500/30 pl-4">
                  <div class="flex items-center justify-between mb-3">
                    <h3 class="font-medium text-white flex items-center gap-2">
                      <svg class="w-5 h-5" style="color: <%= color %>;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <% case icon %>
                        <% when 'sunrise' %>
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        <% when 'sun' %>
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707"></path>
                        <% when 'moon' %>
                          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                        <% when 'apple' %>
                          <circle cx="12" cy="12" r="10"></circle>
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 2a3 3 0 013 3"></path>
                        <% end %>
                      </svg>
                      <%= name %>
                      <span class="text-xs bg-violet-500/20 text-violet-400 px-2 py-0.5 rounded-full"><%= meals.count %></span>
                    </h3>
                    <%= link_to new_nutrition_entry_path(meal_type: meal_type), class: "text-violet-400 hover:text-violet-300 text-sm flex items-center gap-1" do %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                      </svg>
                      Добавить
                    <% end %>
                  </div>

                  <% if meals.any? %>
                    <div class="space-y-2">
                      <% meals.each do |entry| %>
                        <div id="nutrition-entry-<%= entry.id %>" class="meal-card">
                          <div class="flex items-start justify-between gap-3">
                            <div class="flex-1">
                              <p class="text-white font-medium mb-1"><%= entry.meal_description.presence || entry.food_items.presence || 'Приём пищи' %></p>
                              <div class="flex flex-wrap items-center gap-2 text-sm">
                                <span class="text-violet-400 font-semibold"><%= entry.calories.to_i %> ккал</span>
                                <span class="macro-pill macro-protein">Б: <%= entry.protein.to_f.round(1) %>г</span>
                                <span class="macro-pill macro-fat">Ж: <%= entry.fat.to_f.round(1) %>г</span>
                                <span class="macro-pill macro-carbs">У: <%= entry.carbs.to_f.round(1) %>г</span>
                              </div>
                            </div>
                            <div class="flex items-center gap-1">
                              <span class="text-xs text-zinc-600"><%= entry.recorded_at.strftime('%H:%M') %></span>
                              <%= link_to edit_nutrition_entry_path(entry), class: "action-btn text-zinc-400" do %>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                              <% end %>
                              <button onclick="deleteNutritionEntry('<%= entry.id %>')" class="action-btn text-red-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                              </button>
                            </div>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="text-center py-6">
                      <p class="text-zinc-600 text-sm">Пока нет записей</p>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <div class="glass-card p-6 animate-fade-in" style="animation-delay: 0.4s; opacity: 0;">
            <h3 class="font-semibold text-white mb-4 flex items-center gap-2">
              <span class="text-lg">📊</span>
              Статистика недели
            </h3>
            <div class="space-y-3">
              <div class="flex justify-between items-center">
                <span class="text-sm text-zinc-500">Ккал в среднем</span>
                <span class="font-semibold text-violet-400"><%= @weekly_averages[:avg_calories] %></span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-sm text-zinc-500">Белки</span>
                <span class="font-medium text-blue-400"><%= @weekly_averages[:avg_protein] %>г</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-sm text-zinc-500">Жиры</span>
                <span class="font-medium text-amber-400"><%= @weekly_averages[:avg_fat] %>г</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-sm text-zinc-500">Углеводы</span>
                <span class="font-medium text-pink-400"><%= @weekly_averages[:avg_carbs] %>г</span>
              </div>
              <div class="pt-3 border-t border-white/5">
                <div class="flex justify-between items-center">
                  <span class="text-sm text-zinc-500">Всего приёмов</span>
                  <span class="font-medium text-green-400"><%= @weekly_averages[:total_meals] %></span>
                </div>
              </div>
            </div>
          </div>

          <div class="glass-card p-6 animate-fade-in" style="animation-delay: 0.45s; opacity: 0;">
            <h3 class="font-semibold text-white mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              Быстрые действия
            </h3>
            <div class="space-y-2">
              <% meal_types.each do |meal_type, (icon, name, color)| %>
                <%= link_to new_nutrition_entry_path(meal_type: meal_type), class: "w-full flex items-center gap-3 px-4 py-3 rounded-xl bg-white/5 border border-white/5 text-zinc-300 hover:bg-white/10 hover:text-white transition-all" do %>
                  <svg class="w-5 h-5" style="color: <%= color %>;" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <% case icon %>
                    <% when 'sunrise' %>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                    <% when 'sun' %>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707"></path>
                    <% when 'moon' %>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                    <% when 'apple' %>
                      <circle cx="12" cy="12" r="10"></circle>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 2a3 3 0 013 3"></path>
                    <% end %>
                  </svg>
                  <span><%= name %></span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Activity Tab -->
    <div id="activity-panel" class="tab-panel hidden">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="stat-card" style="--accent-color: var(--blue-500);">
          <div class="flex items-center gap-4">
            <div class="p-3 rounded-xl bg-blue-500/20"><span class="text-xl">⏱️</span></div>
            <div>
              <% duration = @activity_totals[:total_duration] %>
              <p class="text-2xl font-bold text-white"><%= duration > 0 ? (duration >= 60 ? "#{duration/60}ч #{duration%60}м" : "#{duration}м") : "0м" %></p>
              <p class="text-sm text-zinc-500">Время</p>
            </div>
          </div>
        </div>

        <div class="stat-card" style="--accent-color: var(--green-500);">
          <div class="flex items-center gap-4">
            <div class="p-3 rounded-xl bg-green-500/20"><span class="text-xl">📏</span></div>
            <div>
              <p class="text-2xl font-bold text-white"><%= @activity_totals[:total_distance] > 0 ? "#{@activity_totals[:total_distance].round(1)} км" : "0 км" %></p>
              <p class="text-sm text-zinc-500">Дистанция</p>
            </div>
          </div>
        </div>

        <div class="stat-card" style="--accent-color: var(--amber-500);">
          <div class="flex items-center gap-4">
            <div class="p-3 rounded-xl bg-amber-500/20">
              <svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"></path>
              </svg>
            </div>
            <div>
              <p class="text-2xl font-bold text-white"><%= @activity_totals[:total_calories_burned] %></p>
              <p class="text-sm text-zinc-500">Сожжено</p>
            </div>
          </div>
        </div>

        <div class="stat-card" style="--accent-color: var(--violet-500);">
          <div class="flex items-center gap-4">
            <div class="p-3 rounded-xl bg-violet-500/20"><span class="text-xl">🏃‍♂️</span></div>
            <div>
              <p class="text-2xl font-bold text-white"><%= @activity_totals[:activity_count] %></p>
              <p class="text-sm text-zinc-500">Тренировок</p>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 glass-card p-6">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-lg font-semibold text-white">📊 Активность за день</h2>
            <%= link_to new_activity_entry_path, class: "px-4 py-2 rounded-lg bg-gradient-to-r from-violet-600 to-violet-500 text-white text-sm font-medium hover:from-violet-500 hover:to-violet-400 transition-all flex items-center gap-2" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              Добавить
            <% end %>
          </div>

          <% if @activity_entries.any? %>
            <div class="space-y-3">
              <% @activity_entries.each do |activity| %>
                <div id="activity-entry-<%= activity.id %>" class="meal-card">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-4">
                      <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center">
                        <span class="text-xl"><%= activity.activity_emoji %></span>
                      </div>
                      <div>
                        <h3 class="font-medium text-white"><%= activity.activity_name %></h3>
                        <div class="flex items-center gap-4 text-sm text-zinc-500">
                          <span class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <%= activity.formatted_duration %>
                          </span>
                          <% if activity.distance_km %>
                            <span class="flex items-center gap-1">
                              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                              </svg>
                              <%= activity.formatted_distance %>
                            </span>
                          <% end %>
                          <% if activity.calories_burned %>
                            <span class="flex items-center gap-1">
                              <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path>
                              </svg>
                              <%= activity.calories_burned %> ккал
                            </span>
                          <% end %>
                        </div>
                      </div>
                    </div>
                    <div class="flex items-center gap-2">
                      <span class="text-xs text-zinc-600"><%= activity.activity_date.strftime("%H:%M") %></span>
                      <button onclick="deleteActivity('<%= activity.id %>')" class="action-btn text-red-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                      </button>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-12">
              <div class="text-4xl mb-3">🏃‍♂️</div>
              <p class="text-zinc-500">Пока нет записей о тренировках</p>
              <p class="text-sm text-zinc-600 mt-1">Отправьте скриншот из Garmin в Telegram бота</p>
            </div>
          <% end %>
        </div>

        <div class="glass-card p-6">
          <h3 class="font-semibold text-white mb-4">⚡ Быстрые действия</h3>
          <div class="space-y-2">
            <% [['running', '🏃‍♂️', 'Бег'], ['cycling', '🚴‍♂️', 'Велосипед'], ['strength', '🏋️‍♂️', 'Силовая'], ['swimming', '🏊‍♂️', 'Плавание']].each do |type, emoji, name| %>
              <%= link_to new_activity_entry_path(activity_type: type), class: "w-full flex items-center gap-3 px-4 py-3 rounded-xl bg-white/5 border border-white/5 text-zinc-300 hover:bg-white/10 hover:text-white transition-all" do %>
                <span class="text-lg"><%= emoji %></span>
                <span><%= name %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Analysis Tab -->
    <div id="analysis-panel" class="tab-panel hidden">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="glass-card p-6">
          <h2 class="text-lg font-semibold text-white mb-6">📊 Сводка дня</h2>
          <div class="space-y-4">
            <% if @daily_analysis %>
              <% balance = @daily_analysis[:calorie_balance] %>
              <div class="flex justify-between items-center p-4 bg-violet-500/10 rounded-xl border border-violet-500/20">
                <span class="text-zinc-300">Потреблено калорий</span>
                <span class="text-lg font-bold text-violet-400"><%= balance[:consumed] %> ккал</span>
              </div>
              <div class="flex justify-between items-center p-4 bg-amber-500/10 rounded-xl border border-amber-500/20">
                <span class="text-zinc-300">Сожжено калорий</span>
                <span class="text-lg font-bold text-amber-400"><%= balance[:burned] %> ккал</span>
              </div>
              <div class="flex justify-between items-center p-4 bg-blue-500/10 rounded-xl border border-blue-500/20">
                <span class="text-zinc-300">Активное время</span>
                <% duration = @daily_analysis[:activity_analysis][:total_duration_minutes] %>
                <span class="text-lg font-bold text-blue-400"><%= duration >= 60 ? "#{duration/60}ч #{duration%60}м" : "#{duration}м" %></span>
              </div>
            <% else %>
              <div class="text-center py-8">
                <p class="text-zinc-500">Добавьте данные для анализа</p>
              </div>
            <% end %>
          </div>
        </div>

        <div class="glass-card p-6">
          <h2 class="text-lg font-semibold text-white mb-6">🤖 AI анализ</h2>
          <% if @daily_analysis %>
            <div class="space-y-4">
              <% if @daily_analysis[:tomorrow_recommendations]&.any? %>
                <div class="p-4 bg-blue-500/10 rounded-xl border border-blue-500/20">
                  <h3 class="font-medium text-white mb-2">💡 Рекомендации</h3>
                  <ul class="text-sm text-zinc-400 space-y-1">
                    <% @daily_analysis[:tomorrow_recommendations].take(3).each do |rec| %>
                      <li>• <%= rec %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
              <% if @daily_analysis[:achievements]&.any? %>
                <div class="p-4 bg-green-500/10 rounded-xl border border-green-500/20">
                  <h3 class="font-medium text-white mb-2">✅ Достижения</h3>
                  <ul class="text-sm text-zinc-400 space-y-1">
                    <% @daily_analysis[:achievements].take(3).each do |a| %>
                      <li>• <%= a %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8">
              <div class="text-4xl mb-3">🤖</div>
              <p class="text-zinc-500">Недостаточно данных для анализа</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
function switchTab(tabName) {
  document.querySelectorAll('.tab-button').forEach(btn => {
    btn.classList.remove('active');
    btn.setAttribute('aria-selected', 'false');
  });
  document.querySelectorAll('.tab-panel').forEach(panel => {
    panel.classList.remove('active');
    panel.classList.add('hidden');
  });

  const tab = document.getElementById(`${tabName}-tab`);
  const panel = document.getElementById(`${tabName}-panel`);
  if (tab && panel) {
    tab.classList.add('active');
    tab.setAttribute('aria-selected', 'true');
    panel.classList.remove('hidden');
    panel.classList.add('active');
  }
}

function changeDate(days) {
  const currentDate = new Date('<%= @selected_date.iso8601 %>');
  currentDate.setDate(currentDate.getDate() + days);
  const newDate = currentDate.toISOString().split('T')[0];
  window.location.href = '<%= nutrition_entries_path %>?date=' + newDate;
}

function deleteNutritionEntry(entryId) {
  if (!confirm('Удалить запись о питании?')) return;
  fetch(`/nutrition/${entryId}.json`, {
    method: 'DELETE',
    headers: {
      'Accept': 'application/json',
      'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
    }
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) location.reload();
    else alert('Ошибка при удалении');
  })
  .catch(e => alert('Ошибка: ' + e.message));
}

function deleteActivity(activityId) {
  if (!confirm('Удалить тренировку?')) return;
  fetch(`/activity_entries/${activityId}`, {
    method: 'DELETE',
    headers: {
      'Accept': 'application/json',
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
    }
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) location.reload();
    else alert('Ошибка при удалении');
  })
  .catch(e => alert('Ошибка: ' + e.message));
}
</script>
