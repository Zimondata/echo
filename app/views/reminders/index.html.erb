<% content_for :title, "Напоминания" %>

<style>
  /* === AURI REMINDERS PAGE - Linear + Amie Style === */

  .animated-bg {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: -1;
    overflow: hidden;
  }

  .animated-bg::before {
    content: '';
    position: absolute;
    top: -50%; left: -50%;
    width: 200%; height: 200%;
    background:
      radial-gradient(circle at 20% 80%, rgba(139, 92, 246, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 40% 40%, rgba(59, 130, 246, 0.08) 0%, transparent 40%);
    animation: gradientMove 20s ease-in-out infinite;
  }

  @keyframes gradientMove {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(2%, 2%) rotate(1deg); }
    50% { transform: translate(-1%, 3%) rotate(-1deg); }
    75% { transform: translate(3%, -2%) rotate(2deg); }
  }

  .glass-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    backdrop-filter: blur(20px);
    transition: all 0.2s ease;
  }

  .glass-card:hover {
    border-color: var(--border-glow);
    background: var(--bg-card-hover);
  }

  .gradient-text {
    background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 50%, #6366f1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-link {
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-link.active {
    color: var(--text-primary);
    background: var(--violet-glow);
    box-shadow: 0 0 20px var(--violet-glow);
  }

  .stat-card {
    padding: 20px;
    border-radius: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    transition: all 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-glow);
  }

  .reminder-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    padding: 20px;
    transition: all 0.2s ease;
  }

  .reminder-card:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--border-glow);
    transform: translateX(4px);
  }

  .reminder-card.smart {
    border-left: 3px solid var(--violet-500);
  }

  .reminder-card.high-priority {
    box-shadow: 0 0 20px var(--violet-glow);
    border-color: rgba(139, 92, 246, 0.3);
  }

  .reminder-card.overdue {
    border-left: 3px solid var(--red-500);
    background: rgba(239, 68, 68, 0.05);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
  }

  .badge.high { background: var(--red-glow); color: var(--red-500); border: 1px solid rgba(239, 68, 68, 0.3); }
  .badge.medium { background: var(--amber-glow); color: var(--amber-500); border: 1px solid rgba(245, 158, 11, 0.3); }
  .badge.low { background: var(--green-glow); color: var(--green-500); border: 1px solid rgba(16, 185, 129, 0.3); }
  .badge.smart-type { background: var(--violet-glow); color: var(--violet-500); border: 1px solid rgba(139, 92, 246, 0.3); }
  .badge.overdue { background: var(--red-glow); color: var(--red-500); border: 1px solid rgba(239, 68, 68, 0.3); }
  .badge.soon { background: var(--amber-glow); color: var(--amber-500); border: 1px solid rgba(245, 158, 11, 0.3); }

  .action-btn {
    padding: 8px 14px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 500;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .action-btn.snooze {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }

  .action-btn.snooze:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
    border-color: var(--border-glow);
  }

  .action-btn.cancel {
    background: var(--red-glow);
    color: var(--red-500);
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .action-btn.cancel:hover {
    background: rgba(239, 68, 68, 0.2);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in {
    animation: fadeIn 0.4s ease forwards;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .animate-pulse {
    animation: pulse 2s ease-in-out infinite;
  }
</style>

<!-- Animated Background -->
<div class="animated-bg"></div>

<div class="min-h-screen w-full relative">

  <%= render 'shared/unified_header' %>

  <!-- === MAIN CONTENT === -->
  <div class="w-full px-6 lg:px-8 py-8 max-w-6xl mx-auto">

    <!-- Page Header -->
    <div class="mb-8 animate-fade-in">
      <h1 class="text-3xl font-bold text-white mb-2 flex items-center gap-3">
        <svg class="w-8 h-8 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
        </svg>
        Напоминания
      </h1>
      <p class="text-zinc-500">Управление обычными и умными напоминаниями</p>
    </div>

    <!-- Stats Row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <div class="stat-card animate-fade-in" style="animation-delay: 0.1s; opacity: 0;">
        <div class="flex items-center gap-4">
          <div class="p-3 rounded-xl bg-blue-500/20">
            <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm text-zinc-500">Активных</p>
            <p class="text-2xl font-bold text-white"><%= @pending_reminders.count %></p>
          </div>
        </div>
      </div>

      <div class="stat-card animate-fade-in" style="animation-delay: 0.15s; opacity: 0;">
        <div class="flex items-center gap-4">
          <div class="p-3 rounded-xl bg-violet-500/20">
            <svg class="w-6 h-6 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm text-zinc-500">Умных</p>
            <p class="text-2xl font-bold text-white"><%= @smart_total %></p>
          </div>
        </div>
      </div>

      <div class="stat-card animate-fade-in" style="animation-delay: 0.2s; opacity: 0;">
        <div class="flex items-center gap-4">
          <div class="p-3 rounded-xl bg-green-500/20">
            <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/>
            </svg>
          </div>
          <div>
            <p class="text-sm text-zinc-500">Полезных</p>
            <p class="text-2xl font-bold text-white"><%= @helpful_count %></p>
          </div>
        </div>
      </div>
    </div>

    <% if @pending_reminders.empty? %>
      <!-- Empty State -->
      <div class="glass-card p-12 text-center animate-fade-in">
        <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-violet-500/20 to-amber-500/20 flex items-center justify-center">
          <span class="text-4xl">🔔</span>
        </div>
        <h3 class="text-xl font-semibold text-white mb-2">Нет активных напоминаний</h3>
        <p class="text-zinc-500 max-w-md mx-auto mb-6">
          Напоминания можно создать через Telegram бота
        </p>
        <div class="glass-card inline-block px-4 py-3 rounded-xl">
          <code class="text-violet-400 text-sm">/remind 17:00 Позвонить маме</code>
        </div>
      </div>
    <% else %>
      <!-- Regular Reminders -->
      <% if @regular_reminders.any? %>
        <div class="mb-8 animate-fade-in" style="animation-delay: 0.25s; opacity: 0;">
          <h2 class="text-xl font-semibold text-white mb-4 flex items-center gap-2">
            <span class="text-amber-400">⏰</span>
            Обычные напоминания
          </h2>
          <div class="space-y-3">
            <% @regular_reminders.each do |reminder| %>
              <div class="reminder-card <%= 'overdue' if reminder.remind_at < Time.current %>">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-start gap-4 flex-1">
                    <div class="text-3xl">🔔</div>
                    <div class="flex-1">
                      <p class="text-lg font-medium text-white mb-1"><%= reminder.message %></p>
                      <div class="flex items-center gap-3 text-sm">
                        <span class="text-zinc-500">
                          <%= reminder.remind_at.in_time_zone(current_user.timezone).strftime('%d.%m.%Y в %H:%M') %>
                        </span>
                        <% if reminder.remind_at < Time.current %>
                          <span class="badge overdue">Просрочено</span>
                        <% elsif reminder.remind_at < 1.hour.from_now %>
                          <span class="badge soon animate-pulse">Скоро</span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <%= button_to snooze_reminder_path(reminder), method: :post, params: { duration: 60 }, class: "action-btn snooze" do %>
                      ⏰ Отложить
                    <% end %>
                    <%= button_to reminder_path(reminder), method: :delete, data: { turbo_confirm: 'Точно отменить?' }, class: "action-btn cancel" do %>
                      ❌ Отменить
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Smart Reminders -->
      <% if @smart_reminders.any? %>
        <div class="mb-8 animate-fade-in" style="animation-delay: 0.3s; opacity: 0;">
          <h2 class="text-xl font-semibold text-white mb-4 flex items-center gap-2">
            <span class="text-violet-400">🤖</span>
            Умные напоминания
          </h2>
          <div class="space-y-4">
            <% @smart_reminders.each do |reminder| %>
              <div class="reminder-card smart <%= 'high-priority' if reminder.priority == 'high' %>">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-start gap-4 flex-1">
                    <div class="text-3xl">
                      <%= case reminder.smart_type
                          when "idea" then "💡"
                          when "pattern" then "📊"
                          when "goal" then "🎯"
                          when "context" then "🧠"
                          when "suggestion" then "✨"
                          else "🤖"
                          end %>
                    </div>
                    <div class="flex-1">
                      <div class="flex items-center gap-2 mb-2">
                        <span class="badge <%= reminder.priority %>">
                          <%= { 'high' => 'Высокий', 'medium' => 'Средний', 'low' => 'Низкий' }[reminder.priority] %>
                        </span>
                        <span class="badge smart-type">
                          <%= { 'idea' => 'Идея', 'pattern' => 'Паттерн', 'goal' => 'Цель', 'context' => 'Контекст', 'suggestion' => 'Предложение' }[reminder.smart_type] %>
                        </span>
                        <% if reminder.confidence_score %>
                          <span class="text-xs text-zinc-500">Уверенность: <%= reminder.confidence_score %>%</span>
                        <% end %>
                      </div>
                      <p class="text-lg font-medium text-white mb-2"><%= reminder.message %></p>
                      <p class="text-sm text-zinc-500 mb-3">
                        📅 <%= reminder.remind_at.in_time_zone(current_user.timezone).strftime('%d.%m.%Y в %H:%M') %>
                      </p>
                      <% if reminder.related_entries.any? %>
                        <div class="glass-card p-3 rounded-xl">
                          <p class="text-xs font-medium text-zinc-400 mb-2">💭 Связанные записи:</p>
                          <% reminder.related_entries.first(2).each do |entry| %>
                            <p class="text-sm text-zinc-300 mb-1">• <%= entry.content.truncate(80) %></p>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <%= button_to snooze_reminder_path(reminder), method: :post, params: { duration: 60 }, class: "action-btn snooze" do %>
                      ⏰ Отложить
                    <% end %>
                    <%= button_to reminder_path(reminder), method: :delete, data: { turbo_confirm: 'Точно отменить?' }, class: "action-btn cancel" do %>
                      ❌ Отменить
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <!-- Recently Sent -->
    <% if @sent_reminders.any? %>
      <div class="mt-8 animate-fade-in" style="animation-delay: 0.35s; opacity: 0;">
        <h2 class="text-xl font-semibold text-white mb-4 flex items-center gap-2">
          <span class="text-green-400">✅</span>
          Недавно отправленные
        </h2>
        <div class="glass-card overflow-hidden">
          <div class="divide-y divide-white/5">
            <% @sent_reminders.first(5).each do |reminder| %>
              <div class="p-4 hover:bg-white/5 transition-colors">
                <div class="flex items-center gap-4">
                  <span class="text-xl opacity-50">
                    <%= reminder.smart_reminder? ?
                        case reminder.smart_type
                        when "idea" then "💡"
                        when "pattern" then "📊"
                        when "goal" then "🎯"
                        when "context" then "🧠"
                        when "suggestion" then "✨"
                        else "🤖"
                        end : "🔔" %>
                  </span>
                  <div class="flex-1">
                    <p class="text-sm text-zinc-300"><%= reminder.message.truncate(80) %></p>
                    <div class="flex items-center gap-3 mt-1">
                      <span class="text-xs text-zinc-600">
                        Отправлено: <%= reminder.sent_at&.in_time_zone(current_user.timezone)&.strftime('%d.%m.%Y в %H:%M') %>
                      </span>
                      <% if reminder.user_feedback == 'helpful' %>
                        <span class="text-xs text-green-400">👍 Полезно</span>
                      <% elsif reminder.user_feedback == 'not_helpful' %>
                        <span class="text-xs text-red-400">👎 Не полезно</span>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Info Box -->
    <div class="mt-8 glass-card p-6 animate-fade-in" style="animation-delay: 0.4s; opacity: 0;">
      <h3 class="text-lg font-medium text-white mb-4 flex items-center gap-2">
        <span class="text-blue-400">ℹ️</span>
        Как работают умные напоминания?
      </h3>
      <ul class="text-sm text-zinc-400 space-y-2">
        <li class="flex items-center gap-2"><span class="text-amber-400">💡</span> Напоминают о забытых идеях (3+ дня без действий)</li>
        <li class="flex items-center gap-2"><span class="text-violet-400">📊</span> Напоминают о нарушенных привычках (питание, тренировки)</li>
        <li class="flex items-center gap-2"><span class="text-green-400">🎯</span> Напоминают о приближающихся целях и планах</li>
        <li class="flex items-center gap-2"><span class="text-blue-400">🧠</span> Анализируют дневник и дают контекстные предложения</li>
        <li class="flex items-center gap-2"><span class="text-pink-400">✨</span> AI генерирует персонализированные рекомендации</li>
      </ul>
      <p class="mt-4 text-sm text-zinc-500">
        Умные напоминания генерируются автоматически каждые 6 часов на основе анализа ваших записей.
      </p>
    </div>
  </div>
</div>
