<% content_for :title, "Напоминания — Echo" %>
<%= render "shared/unified_header" %>

<div class="echo-page echo-page--narrow">
  <header class="echo-page__heading">
    <div>
      <p class="echo-kicker">Ручное расписание</p>
      <h1 class="echo-title">Напоминания</h1>
      <p class="echo-subtitle">Локальная альфа сохраняет расписание, но доставка и фоновые jobs выключены.</p>
    </div>
  </header>

  <% if flash[:notice] %><div class="echo-notice"><%= flash[:notice] %></div><% end %>

  <section class="echo-surface echo-surface--accent mb-5">
    <div class="echo-surface__header"><p class="echo-label echo-label--accent">Одноразовая запись</p><h2 class="echo-section-heading mt-1">Что сохранить в расписании</h2></div>
    <div class="echo-surface__body">
      <%= form_with model: @new_reminder, url: reminders_path, class: "grid gap-3 sm:grid-cols-[minmax(220px,1fr)_220px_130px_auto]" do |form| %>
        <%= form.text_field :message, placeholder: "Какое действие потребуется?", required: true, class: "echo-input" %>
        <%= form.datetime_local_field :remind_at, value: @new_reminder.remind_at&.in_time_zone(current_user.timezone)&.strftime("%Y-%m-%dT%H:%M"), class: "echo-input", required: true %>
        <%= form.select :priority, [["Обычное", "medium"], ["Срочное", "high"], ["Мягкое", "low"]], {}, class: "echo-select" %>
        <%= form.submit "Создать", class: "echo-button echo-button--primary" %>
      <% end %>
      <% if @new_reminder.errors.any? %><p class="mt-3 text-sm" style="color:var(--danger)"><%= @new_reminder.errors.full_messages.to_sentence %></p><% end %>
    </div>
  </section>

  <section class="echo-surface">
      <div class="echo-surface__header"><p class="echo-label">Сохранено: <%= @regular_reminders.size %></p><h2 class="echo-section-heading mt-1">Одноразовые напоминания</h2></div>
      <div class="echo-surface__body grid gap-3">
        <% @regular_reminders.each do |reminder| %>
          <% overdue = reminder.remind_at < Time.current %>
          <article class="echo-row" style="background:var(--surface-inset);border-color:<%= overdue ? 'color-mix(in srgb,var(--danger) 28%,var(--line))' : 'var(--line)' %>">
            <span class="echo-row__marker echo-row__marker--fixed" aria-hidden="true"></span>
            <div class="min-w-0 flex-1">
              <p class="echo-row__title"><%= reminder.message %></p>
              <p class="echo-row__meta" style="color:<%= overdue ? 'var(--danger)' : 'var(--ink-muted)' %>"><%= russian_datetime(reminder.remind_at, current_user.timezone) %> · <%= reminder_priority_label(reminder.priority) %></p>
            </div>
            <div class="flex shrink-0 flex-wrap gap-2">
              <%= button_to "+60 мин", snooze_reminder_path(reminder), method: :post, params: { duration: 60 }, class: "echo-button echo-button--small" %>
              <%= button_to "Отменить", reminder_path(reminder), method: :delete, data: { turbo_confirm: "Отменить напоминание?" }, class: "echo-button echo-button--danger echo-button--small" %>
            </div>
          </article>
        <% end %>
        <% if @regular_reminders.empty? %><div class="echo-empty">Запланированных напоминаний нет.</div><% end %>
      </div>
  </section>
</div>
