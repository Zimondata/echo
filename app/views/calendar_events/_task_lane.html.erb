<%= turbo_frame_tag "task_lane", class: "calendar-tasks" do %>
  <details class="task-lane" data-controller="task-lane">
    <summary class="task-lane-summary">
      <span class="task-lane-heading">Задачи без времени</span>
      <span id="task_lane_count" class="task-lane-count"><%= tasks.size %></span>
      <span class="task-lane-chevron" aria-hidden="true">▾</span>
    </summary>

    <div class="task-lane-body">
      <%= render "tasks/task_feedback", message: flash[:task_notice] %>

      <%= render "tasks/quick_capture",
                 task: task,
                 projects: @active_projects,
                 namespace: "new_task",
                 calendar_view: calendar_view,
                 calendar_date: calendar_date %>

      <% if %w[day week].include?(calendar_view) && tasks.any? %>
        <p class="task-drag-hint" data-planner-drag-hint><strong>Перетащи задачу</strong> на нужный час. Кнопка «Запланировать» остаётся для точного ввода.</p>
      <% end %>

      <%= render "tasks/task_items",
                 tasks: tasks,
                 calendar_view: calendar_view,
                 calendar_date: calendar_date %>
    </div>
  </details>
<% end %>
