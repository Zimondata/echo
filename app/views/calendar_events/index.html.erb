<% content_for :title, "Календарь" %>

<%
  russian_months = {
    1 => 'Январь', 2 => 'Февраль', 3 => 'Март', 4 => 'Апрель',
    5 => 'Май', 6 => 'Июнь', 7 => 'Июль', 8 => 'Август',
    9 => 'Сентябрь', 10 => 'Октябрь', 11 => 'Ноябрь', 12 => 'Декабрь'
  }
  russian_day_names = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс']
  calendar_days = (@start_of_calendar..@end_of_calendar).to_a
%>

<style>
  /* === AURI CALENDAR PAGE - Linear + Amie Style === */

  :root {
    --bg-darkest: #0a0a0f;
    --bg-card: #1a1a24;
    --bg-card-hover: #22222e;
    --border-subtle: rgba(255, 255, 255, 0.06);
    --border-glow: rgba(139, 92, 246, 0.3);
    --text-primary: #ffffff;
    --text-secondary: #a1a1aa;
    --text-muted: #71717a;
    --violet-500: #8b5cf6;
    --violet-glow: rgba(139, 92, 246, 0.15);
    --amber-500: #f59e0b;
    --blue-500: #3b82f6;
    --green-500: #10b981;
    --red-500: #ef4444;
  }

  .animated-bg {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: -1;
    overflow: hidden;
  }

  .animated-bg::before {
    content: '';
    position: absolute;
    top: -50%; left: -50%;
    width: 200%; height: 200%;
    background:
      radial-gradient(circle at 20% 80%, rgba(139, 92, 246, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 40% 40%, rgba(59, 130, 246, 0.08) 0%, transparent 40%);
    animation: gradientMove 20s ease-in-out infinite;
  }

  @keyframes gradientMove {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(2%, 2%) rotate(1deg); }
    50% { transform: translate(-1%, 3%) rotate(-1deg); }
    75% { transform: translate(3%, -2%) rotate(2deg); }
  }

  .gradient-text {
    background: linear-gradient(135deg, #8b5cf6 0%, #ec4899 50%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-link {
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-link.active {
    color: var(--text-primary);
    background: var(--violet-glow);
    box-shadow: 0 0 20px var(--violet-glow);
  }

  .glass-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    backdrop-filter: blur(20px);
  }

  .sidebar {
    background: var(--bg-card);
    border-right: 1px solid var(--border-subtle);
  }

  .calendar-day {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    transition: all 0.2s ease;
    min-height: 100px;
  }

  .calendar-day:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--border-glow);
  }

  .calendar-day.today {
    background: rgba(139, 92, 246, 0.05);
    border-color: rgba(139, 92, 246, 0.3);
  }

  .calendar-day.other-month {
    opacity: 0.4;
  }

  .day-number {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 500;
  }

  .day-number.today {
    background: linear-gradient(135deg, var(--violet-500), #7c3aed);
    color: white;
  }

  .event-pill {
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 500;
    transition: all 0.2s ease;
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .event-pill:hover {
    opacity: 0.8;
    transform: translateX(2px);
  }

  .event-pill.done {
    opacity: 0.5;
    text-decoration: line-through;
  }

  /* Event Colors */
  .event-health { background: rgba(239, 68, 68, 0.2); color: #f87171; border-left: 2px solid #ef4444; }
  .event-work { background: rgba(59, 130, 246, 0.2); color: #60a5fa; border-left: 2px solid #3b82f6; }
  .event-personal { background: rgba(16, 185, 129, 0.2); color: #34d399; border-left: 2px solid #10b981; }
  .event-learning { background: rgba(139, 92, 246, 0.2); color: #a78bfa; border-left: 2px solid #8b5cf6; }
  .event-plan { background: rgba(16, 185, 129, 0.2); color: #34d399; border-left: 2px solid #10b981; }
  .event-idea { background: rgba(245, 158, 11, 0.2); color: #fbbf24; border-left: 2px solid #f59e0b; }
  .event-reminder { background: rgba(239, 68, 68, 0.2); color: #f87171; border-left: 2px solid #ef4444; }
  .event-default { background: rgba(139, 92, 246, 0.2); color: #a78bfa; border-left: 2px solid #8b5cf6; }

  .mini-calendar-day {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mini-calendar-day:hover {
    background: rgba(139, 92, 246, 0.2);
  }

  .mini-calendar-day.today {
    background: linear-gradient(135deg, var(--violet-500), #7c3aed);
    color: white;
  }

  .mini-calendar-day.has-events::after {
    content: '';
    position: absolute;
    bottom: 2px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--violet-500);
  }

  .view-btn {
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .view-btn:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .view-btn.active {
    background: linear-gradient(135deg, var(--violet-500), #7c3aed);
    color: white;
  }

  /* Modal */
  .modal-backdrop {
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }

  .modal-content {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 20px;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in {
    animation: fadeIn 0.4s ease forwards;
  }
</style>

<!-- Animated Background -->
<div class="animated-bg"></div>

<div class="min-h-screen w-full relative">

  <!-- === HEADER === -->
  <header class="sticky top-0 z-50 border-b border-white/5 bg-[#0a0a0f]/80 backdrop-blur-xl">
    <div class="w-full px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <div class="flex items-center gap-8">
          <a href="/" class="text-2xl font-bold gradient-text">Auri</a>
          <nav class="hidden md:flex items-center gap-1">
            <%= link_to dashboard_path, class: "nav-link" do %>Dashboard<% end %>
            <%= link_to diary_entries_path, class: "nav-link" do %>Дневник<% end %>
            <%= link_to ideas_entries_path, class: "nav-link" do %>Идеи<% end %>
            <%= link_to plans_entries_path, class: "nav-link" do %>Планы<% end %>
            <%= link_to nutrition_entries_path, class: "nav-link" do %>Здоровье<% end %>
            <%= link_to calendar_events_path, class: "nav-link active" do %>Календарь<% end %>
            <%= link_to reminders_path, class: "nav-link" do %>Напоминания<% end %>
          </nav>
        </div>
      </div>
    </div>
  </header>

  <div class="flex" style="height: calc(100vh - 64px);">

    <!-- === SIDEBAR === -->
    <div class="sidebar w-72 p-6 overflow-y-auto hidden lg:block">

      <!-- Create Button -->
      <button class="w-full flex items-center gap-3 px-5 py-3 rounded-xl bg-gradient-to-r from-violet-600 to-violet-500 text-white font-medium hover:from-violet-500 hover:to-violet-400 transition-all mb-6 shadow-lg shadow-violet-500/20">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Создать событие
      </button>

      <!-- Mini Calendar -->
      <div class="glass-card p-4 mb-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-white">
            <%= russian_months[@current_date.month] %> <%= @current_date.year %>
          </h3>
          <div class="flex gap-1">
            <%= link_to calendar_events_path(year: @prev_month.year, month: @prev_month.month), class: "p-1.5 rounded-lg hover:bg-white/10 transition-colors" do %>
              <svg class="w-4 h-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
            <% end %>
            <%= link_to calendar_events_path(year: @next_month.year, month: @next_month.month), class: "p-1.5 rounded-lg hover:bg-white/10 transition-colors" do %>
              <svg class="w-4 h-4 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            <% end %>
          </div>
        </div>

        <div class="grid grid-cols-7 gap-1 text-center mb-2">
          <% russian_day_names.each do |day| %>
            <div class="text-xs text-zinc-500 font-medium py-1"><%= day %></div>
          <% end %>
        </div>

        <div class="grid grid-cols-7 gap-1">
          <% calendar_days.each do |date| %>
            <%
              is_current_month = date.month == @current_date.month
              is_today = date == Date.current
              has_events = @calendar_events.any? { |e| e.start_time.in_time_zone(@user.timezone).to_date == date }
            %>
            <div class="mini-calendar-day relative <%= 'today' if is_today %> <%= is_current_month ? 'text-zinc-300' : 'text-zinc-600' %> <%= 'has-events' if has_events %>">
              <%= date.day %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Calendar Legend -->
      <div class="glass-card p-4">
        <h3 class="text-sm font-semibold text-white mb-4">Категории</h3>
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full bg-blue-500"></div>
            <span class="text-sm text-zinc-400">Работа</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
            <span class="text-sm text-zinc-400">Личное</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <span class="text-sm text-zinc-400">Здоровье</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full bg-violet-500"></div>
            <span class="text-sm text-zinc-400">Обучение</span>
          </div>
          <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full bg-amber-500"></div>
            <span class="text-sm text-zinc-400">Идеи</span>
          </div>
        </div>
      </div>
    </div>

    <!-- === MAIN CALENDAR === -->
    <div class="flex-1 flex flex-col overflow-hidden">

      <!-- Calendar Header -->
      <div class="px-6 py-4 border-b border-white/5 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <h1 class="text-2xl font-semibold text-white">
            <%= russian_months[@current_date.month] %> <%= @current_date.year %>
          </h1>
          <div class="flex gap-1">
            <%= link_to calendar_events_path(year: @prev_month.year, month: @prev_month.month), class: "p-2 rounded-lg hover:bg-white/10 transition-colors" do %>
              <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
            <% end %>
            <%= link_to calendar_events_path(year: @next_month.year, month: @next_month.month), class: "p-2 rounded-lg hover:bg-white/10 transition-colors" do %>
              <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            <% end %>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button class="view-btn text-zinc-400">День</button>
          <button class="view-btn text-zinc-400">Неделя</button>
          <button class="view-btn active">Месяц</button>
        </div>
      </div>

      <!-- Days Header -->
      <div class="grid grid-cols-7 border-b border-white/5">
        <% %w[Понедельник Вторник Среда Четверг Пятница Суббота Воскресенье].each do |day| %>
          <div class="px-4 py-3 text-center text-xs font-medium text-zinc-500 uppercase tracking-wider">
            <%= day %>
          </div>
        <% end %>
      </div>

      <!-- Calendar Grid -->
      <div class="flex-1 overflow-y-auto">
        <div class="grid grid-cols-7 h-full">
          <% calendar_days.each do |date|
               is_current_month = date.month == @current_date.month
               is_today = date == Date.current
               day_events = @calendar_events.select { |event|
                 event.start_time.in_time_zone(@user.timezone).to_date == date
               }
          %>
            <div class="calendar-day p-2 <%= 'today' if is_today %> <%= 'other-month' unless is_current_month %>"
                 onclick="showDayEvents('<%= date.strftime('%Y-%m-%d') %>', '<%= date.strftime('%d %B %Y') %>')">

              <div class="flex items-center justify-between mb-2">
                <div class="day-number <%= 'today' if is_today %> <%= is_current_month ? 'text-zinc-300' : 'text-zinc-600' %>">
                  <%= date.day %>
                </div>
              </div>

              <div class="space-y-1">
                <% day_events.first(3).each do |event|
                     event_class = case event.life_category
                                   when 'health' then 'event-health'
                                   when 'work' then 'event-work'
                                   when 'personal' then 'event-personal'
                                   when 'learning' then 'event-learning'
                                   else
                                     case event.entry&.entry_type
                                     when 'plan' then 'event-plan'
                                     when 'idea' then 'event-idea'
                                     else
                                       event.event_type == 'reminder' ? 'event-reminder' : 'event-default'
                                     end
                                   end
                %>
                  <div class="event-pill <%= event_class %> <%= 'done' if event.done %>" title="<%= event.title %>">
                    <% if event.start_time && event.end_time %>
                      <span class="font-semibold"><%= event.start_time.in_time_zone(@user.timezone).strftime("%H:%M") %></span>
                    <% end %>
                    <%= event.title.truncate(15) %>
                  </div>
                <% end %>
                <% if day_events.count > 3 %>
                  <div class="text-xs text-violet-400 px-2 py-1 cursor-pointer hover:text-violet-300">
                    +<%= day_events.count - 3 %> еще
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div id="dayEventsModal" class="hidden fixed inset-0 z-50 flex items-center justify-center modal-backdrop" onclick="closeDayEventsModal(event)">
  <div class="modal-content w-full max-w-lg mx-4 max-h-[80vh] flex flex-col animate-fade-in" onclick="event.stopPropagation()">
    <div class="flex items-center justify-between px-6 py-4 border-b border-white/5">
      <h3 class="text-lg font-semibold text-white" id="dayEventsTitle">События</h3>
      <button onclick="closeDayEventsModal()" class="p-2 rounded-lg hover:bg-white/10 transition-colors">
        <svg class="w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div class="px-6 py-4 overflow-y-auto flex-1" id="dayEventsContent">
    </div>
  </div>
</div>

<script>
  const eventsData = {
    <% calendar_days.each do |date| %>
      '<%= date.strftime('%Y-%m-%d') %>': [
        <% day_events = @calendar_events.select { |event| event.start_time.in_time_zone(@user.timezone).to_date == date } %>
        <% day_events.each do |event|
             event_class = case event.life_category
                           when 'health' then 'event-health'
                           when 'work' then 'event-work'
                           when 'personal' then 'event-personal'
                           when 'learning' then 'event-learning'
                           else
                             case event.entry&.entry_type
                             when 'plan' then 'event-plan'
                             when 'idea' then 'event-idea'
                             else
                               event.event_type == 'reminder' ? 'event-reminder' : 'event-default'
                             end
                           end
        %>
          {
            title: <%= event.title.to_json.html_safe %>,
            time: '<%= event.start_time.in_time_zone(@user.timezone).strftime("%H:%M") %>',
            endTime: '<%= event.end_time&.in_time_zone(@user.timezone)&.strftime("%H:%M") || "" %>',
            description: <%= event.description.to_json.html_safe %>,
            eventClass: '<%= event_class %>',
            done: <%= event.done || false %>
          },
        <% end %>
      ],
    <% end %>
  };

  function showDayEvents(dateStr, dateTitle) {
    const events = eventsData[dateStr] || [];
    const modal = document.getElementById('dayEventsModal');
    const title = document.getElementById('dayEventsTitle');
    const content = document.getElementById('dayEventsContent');

    title.textContent = dateTitle;

    if (events.length === 0) {
      content.innerHTML = `
        <div class="text-center py-12">
          <div class="text-4xl mb-3">📅</div>
          <p class="text-zinc-500">Нет событий на этот день</p>
        </div>`;
    } else {
      content.innerHTML = events.map(event => `
        <div class="mb-3 p-4 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 transition-colors">
          <div class="flex items-start gap-3">
            <div class="w-1 h-12 rounded ${event.eventClass.replace('event-', 'bg-').replace('-500/20', '-500')}"></div>
            <div class="flex-1">
              <h4 class="font-medium text-white ${event.done ? 'line-through opacity-50' : ''}">${event.title}</h4>
              <p class="text-sm text-zinc-500 mt-1">
                ${event.time}${event.endTime ? ' - ' + event.endTime : ''}
              </p>
              ${event.description ? `<p class="text-sm text-zinc-400 mt-2">${event.description}</p>` : ''}
            </div>
            ${event.done ? '<span class="text-green-400 text-sm">✓</span>' : ''}
          </div>
        </div>
      `).join('');
    }

    modal.classList.remove('hidden');
  }

  function closeDayEventsModal(event) {
    if (!event || event.target === event.currentTarget) {
      document.getElementById('dayEventsModal').classList.add('hidden');
    }
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeDayEventsModal();
    }
  });
</script>
