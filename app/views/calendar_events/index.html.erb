<% content_for :title, "Календарь — Echo" %>

<style>
  .calendar-app { min-height: calc(100vh - 64px); background: #0b0b10; color: #f5f5f7; }
  .calendar-frame { max-width: 1680px; margin: 0 auto; padding: 22px 24px 32px; }
  .calendar-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-bottom: 18px; }
  .calendar-title-row, .calendar-toolbar-actions, .calendar-nav, .calendar-view-switch { display: flex; align-items: center; }
  .calendar-title-row { gap: 12px; min-width: 0; }
  .calendar-title { margin: 0; font-size: clamp(24px, 3vw, 34px); line-height: 1.1; letter-spacing: -.035em; font-weight: 650; white-space: nowrap; }
  .calendar-subtitle { margin-top: 5px; color: #85858f; font-size: 13px; }
  .calendar-toolbar-actions { gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
  .calendar-nav { gap: 4px; padding: 4px; border-radius: 11px; background: #14141a; box-shadow: inset 0 0 0 1px rgba(255,255,255,.065); }
  .calendar-icon-link, .calendar-today-link, .calendar-view-link, .calendar-primary-link { display: inline-flex; align-items: center; justify-content: center; text-decoration: none; font-weight: 600; transition: background .15s ease, color .15s ease, transform .15s ease; }
  .calendar-icon-link { width: 34px; height: 34px; border-radius: 8px; color: #a5a5ae; }
  .calendar-icon-link:hover { color: #fff; background: #22222a; }
  .calendar-today-link { min-height: 42px; padding: 0 15px; border-radius: 10px; color: #d7d7dc; background: #14141a; box-shadow: inset 0 0 0 1px rgba(255,255,255,.065); font-size: 13px; }
  .calendar-today-link:hover { background: #1c1c24; }
  .calendar-view-switch { gap: 3px; padding: 4px; border-radius: 11px; background: #14141a; box-shadow: inset 0 0 0 1px rgba(255,255,255,.065); }
  .calendar-view-link { min-height: 34px; padding: 0 13px; border-radius: 8px; color: #7f7f89; font-size: 12px; }
  .calendar-view-link:hover { color: #d7d7dc; }
  .calendar-view-link.active { color: #fff; background: #2b2b35; box-shadow: 0 1px 4px rgba(0,0,0,.3), inset 0 0 0 1px rgba(255,255,255,.06); }
  .calendar-primary-link { gap: 8px; min-height: 42px; padding: 0 16px; border-radius: 10px; color: #fff; background: #7c3aed; box-shadow: 0 7px 20px rgba(124,58,237,.22), inset 0 1px 0 rgba(255,255,255,.18); font-size: 13px; }
  .calendar-primary-link:hover { background: #8b5cf6; transform: translateY(-1px); }
  .calendar-workspace { display: grid; grid-template-columns: minmax(0,1fr); gap: 14px; align-items: start; }
  .calendar-surface, .calendar-side-card { background: #111116; border-radius: 16px; box-shadow: 0 0 0 1px rgba(255,255,255,.065), 0 16px 40px rgba(0,0,0,.18); overflow: hidden; }
  .calendar-sidebar { display: grid; gap: 14px; }
  .calendar-side-card { padding: 17px; }
  .calendar-side-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; color: #f2f2f4; font-size: 13px; font-weight: 650; }
  .calendar-count { color: #777782; font-size: 11px; font-variant-numeric: tabular-nums; }
  .calendar-upcoming { display: grid; gap: 8px; }
  .calendar-upcoming-item { display: grid; grid-template-columns: 3px minmax(0,1fr); gap: 10px; padding: 10px; border-radius: 10px; color: inherit; text-decoration: none; background: #17171e; }
  .calendar-upcoming-item:hover { background: #1d1d26; }
  .calendar-upcoming-line { border-radius: 99px; }
  .calendar-upcoming-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #e7e7eb; font-size: 12px; font-weight: 600; }
  .calendar-upcoming-meta { margin-top: 3px; color: #777782; font-size: 11px; }
  .calendar-empty-compact { color: #777782; font-size: 12px; line-height: 1.5; }
  .calendar-category-list { display: grid; gap: 10px; }
  .calendar-category { display: flex; align-items: center; justify-content: space-between; color: #a6a6af; font-size: 12px; }
  .calendar-category-label { display: flex; align-items: center; gap: 9px; }
  .calendar-category-dot { width: 8px; height: 8px; border-radius: 50%; }
  .calendar-shortcut { color: #676772; font-size: 11px; }
  .calendar-weekdays { display: grid; grid-template-columns: repeat(7,minmax(0,1fr)); background: #0f0f14; border-bottom: 1px solid rgba(255,255,255,.06); }
  .calendar-weekday { padding: 11px 8px; color: #6f6f79; font-size: 10px; font-weight: 700; letter-spacing: .08em; text-align: center; text-transform: uppercase; }
  .calendar-weekday-short { display: none; }
  .calendar-month-grid { display: grid; grid-template-columns: repeat(7,minmax(0,1fr)); }
  .calendar-month-day { min-width: 0; min-height: 128px; padding: 9px; border-right: 1px solid rgba(255,255,255,.055); border-bottom: 1px solid rgba(255,255,255,.055); background: #111116; }
  .calendar-month-day:nth-child(7n) { border-right: 0; }
  .calendar-month-day.outside { background: #0e0e13; }
  .calendar-month-day.today { background: linear-gradient(180deg, rgba(124,58,237,.085), #111116 44%); }
  .calendar-month-day.is-month-drop-target { position: relative; background: rgba(124,58,237,.14); box-shadow: inset 0 0 0 2px #8b5cf6; }
  .calendar-month-day.is-month-drop-target::after { content: "Перенести сюда"; position: absolute; z-index: 5; right: 7px; bottom: 7px; padding: 4px 6px; border-radius: 6px; color: #fff; background: #7c3aed; font-size: 9px; font-weight: 750; pointer-events: none; }
  .calendar-month-day:focus-visible { outline: 2px solid #8b5cf6; outline-offset: -2px; }
  .calendar-day-link { display: inline-flex; width: 27px; height: 27px; align-items: center; justify-content: center; border-radius: 8px; color: #b7b7bf; text-decoration: none; font-size: 11px; font-weight: 650; }
  .outside .calendar-day-link { color: #484852; }
  .today .calendar-day-link { color: #fff; background: #7c3aed; }
  .calendar-month-events { display: grid; gap: 4px; margin-top: 7px; }
  .calendar-event-chip { min-width: 0; display: grid; grid-template-columns: 3px minmax(0,1fr); gap: 7px; padding: 6px 7px; border-radius: 7px; color: inherit; text-decoration: none; background: #191920; box-shadow: inset 0 0 0 1px rgba(255,255,255,.035); }
  .calendar-event-chip:hover { background: #202029; }
  .calendar-time-block-chip { min-width: 0; display: grid; grid-template-columns: 3px minmax(0,1fr); gap: 7px; padding: 6px 7px; border-radius: 7px; color: inherit; text-decoration: none; background: rgba(124,58,237,.12); box-shadow: inset 0 0 0 1px rgba(167,139,250,.2); }
  .calendar-time-block-accent { border-radius: 99px; background: repeating-linear-gradient(to bottom, #a78bfa 0 4px, transparent 4px 8px); }
  .calendar-event-accent { border-radius: 99px; }
  .calendar-event-copy { min-width: 0; overflow: hidden; }
  .calendar-event-time { color: #85858f; font-size: 9px; font-variant-numeric: tabular-nums; }
  .calendar-event-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #dedee3; font-size: 10px; font-weight: 600; }
  .calendar-more { display: block; margin-top: 5px; color: #8b5cf6; text-decoration: none; font-size: 10px; font-weight: 650; }
  .calendar-week-desktop { display: block; overflow: auto; }
  .calendar-week-head { display: grid; grid-template-columns: 58px repeat(7,minmax(0,1fr)); position: sticky; top: 0; z-index: 4; min-width: 760px; background: #0f0f14; border-bottom: 1px solid rgba(255,255,255,.06); }
  .calendar-week-head-spacer { border-right: 1px solid rgba(255,255,255,.055); }
  .calendar-week-head-day { min-height: 72px; padding: 9px 7px; border-right: 1px solid rgba(255,255,255,.055); color: inherit; text-align: center; text-decoration: none; }
  .calendar-week-head-day:last-child { border-right: 0; }
  .calendar-week-head-day.today { background: rgba(124,58,237,.06); }
  .calendar-week-head-name { display: block; color: #71717b; font-size: 9px; font-weight: 700; text-transform: uppercase; }
  .calendar-week-head-number { display: inline-flex; width: 29px; height: 29px; margin-top: 4px; align-items: center; justify-content: center; border-radius: 9px; color: #d7d7dd; font-size: 12px; font-weight: 650; }
  .calendar-week-head-day.today .calendar-week-head-number { background: #7c3aed; color: #fff; }
  .calendar-all-day-chip { display: block; margin-top: 3px; overflow: hidden; color: #c9c9d0; font-size: 8px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
  .calendar-week-timeline { position: relative; display: grid; grid-template-columns: 58px repeat(7,minmax(0,1fr)); min-width: 760px; height: 1008px; background-color: var(--surface); background-image: linear-gradient(to bottom, transparent 27px, rgba(255,255,255,.025) 27px, rgba(255,255,255,.025) 28px, transparent 28px, transparent 55px, rgba(255,255,255,.065) 55px, rgba(255,255,255,.065) 56px); background-size: 100% 56px; }
  .calendar-current-time-line { position: absolute; z-index: 8; left: 58px; right: 0; height: 2px; background: #ef4444; pointer-events: none; }
  .calendar-current-time-line::before { content: ""; position: absolute; left: -4px; top: -3px; width: 8px; height: 8px; border-radius: 50%; background: #ef4444; }
  .calendar-week-times { position: relative; border-right: 1px solid rgba(255,255,255,.055); }
  .calendar-week-time-label { position: absolute; right: 9px; transform: translateY(-6px); color: #52525c; font-size: 9px; font-variant-numeric: tabular-nums; }
  .calendar-week-column { position: relative; border-right: 1px solid rgba(255,255,255,.055); }
  .calendar-week-column.is-planner-drop-target { background: rgba(124,58,237,.07); }
  .calendar-week-column.is-planner-drop-target::after { content: ""; position: absolute; z-index: 6; left: 4px; right: 4px; top: var(--planner-drop-y); height: 2px; border-radius: 99px; background: #f5b544; box-shadow: 0 0 0 4px rgba(245,181,68,.12); pointer-events: none; }
  .calendar-week-column.is-planner-drop-target::before { content: attr(data-planner-drop-time); position: absolute; z-index: 7; right: 6px; top: calc(var(--planner-drop-y) - 22px); padding: 3px 6px; border-radius: 6px; color: #1c1405; background: #f5b544; font-size: 9px; font-weight: 750; pointer-events: none; }
  .calendar-week-time-block[draggable="true"] { cursor: grab; }
  .calendar-week-time-block[draggable="true"]:active { cursor: grabbing; }
  .calendar-week-time-block.is-dragging { opacity: .38; }
  .calendar-week-time-block.is-locked { cursor: default; box-shadow: inset 3px 0 0 #7c3aed, inset 0 0 0 1px rgba(167,139,250,.26); }
  .planner-drag-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .calendar-workspace.is-planner-submitting { cursor: progress; }
  .calendar-week-column:last-child { border-right: 0; }
  .calendar-week-column.today { background: rgba(124,58,237,.028); }
  .calendar-week-event-timed { position: absolute; z-index: 2; left: 5px; right: 5px; display: block; overflow: hidden; padding: 7px 7px 5px 9px; border-radius: 8px; color: #f4f4f6; text-decoration: none; background: color-mix(in srgb, var(--event-color) 17%, #181820); box-shadow: inset 3px 0 0 var(--event-color), inset 0 0 0 1px rgba(255,255,255,.05), 0 3px 10px rgba(0,0,0,.12); }
  .calendar-week-event-timed:hover { z-index: 3; filter: brightness(1.13); }
  .calendar-week-event-timed[draggable="true"] { cursor: grab; }
  .calendar-week-event-timed[draggable="true"]:active { cursor: grabbing; }
  [data-planner-touch-enabled="true"] { touch-action: none; -webkit-user-select: none; user-select: none; }
  .is-pointer-dragging { z-index: 30 !important; opacity: .42 !important; pointer-events: none; }
  .calendar-week-event-timed.is-dragging { opacity: .38; }
  .calendar-week-time-block { position: absolute; z-index: 2; left: 5px; right: 5px; overflow: hidden; padding: 7px 7px 5px 9px; border-radius: 8px; color: #f4f4f6; background: rgba(124,58,237,.16); box-shadow: inset 3px 0 0 #a78bfa, inset 0 0 0 1px rgba(167,139,250,.2); text-decoration: none; }
  .calendar-time-block-mobile, .calendar-agenda-time-block { color: #f4f4f6; background: rgba(124,58,237,.09); box-shadow: inset 3px 0 0 #a78bfa, inset 0 0 0 1px rgba(167,139,250,.16); text-decoration: none; }
  .calendar-time-block-undo, .calendar-time-block-edit, .calendar-time-block-reschedule-undo { min-height: 32px; padding: 0 9px; border: 0; border-radius: 8px; color: #d9ccff; background: rgba(124,58,237,.18); font: inherit; font-size: 10px; cursor: pointer; }
  .calendar-time-block-edit { display: inline-flex; align-items: center; text-decoration: none; }
  .calendar-week-event-timed .calendar-week-event-time { font-size: 8px; }
  .calendar-week-event-timed .calendar-week-event-title { margin-top: 2px; font-size: 9px; }
  .calendar-week { display: none; }
  .calendar-week-day { min-width: 0; min-height: 560px; padding: 12px 8px; border-right: 1px solid rgba(255,255,255,.055); }
  .calendar-week-day:last-child { border-right: 0; }
  .calendar-week-day.today { background: rgba(124,58,237,.045); }
  .calendar-week-day-head { display: block; margin-bottom: 14px; color: inherit; text-decoration: none; text-align: center; }
  .calendar-week-day-name { color: #71717b; font-size: 10px; font-weight: 700; text-transform: uppercase; }
  .calendar-week-day-number { display: inline-flex; width: 32px; height: 32px; margin-top: 6px; align-items: center; justify-content: center; border-radius: 10px; color: #d7d7dd; font-size: 13px; font-weight: 650; }
  .calendar-week-day.today .calendar-week-day-number { background: #7c3aed; color: #fff; }
  .calendar-week-events { display: grid; gap: 7px; }
  .calendar-week-event { display: block; padding: 9px; border-radius: 9px; color: #f6f6f7; text-decoration: none; background: color-mix(in srgb, var(--event-color) 16%, #17171e); box-shadow: inset 3px 0 0 var(--event-color), inset 0 0 0 1px rgba(255,255,255,.045); }
  .calendar-week-event:hover { filter: brightness(1.12); }
  .calendar-week-event-time { color: #aaaab2; font-size: 9px; }
  .calendar-week-event-title { margin-top: 3px; overflow: hidden; text-overflow: ellipsis; color: #ededf0; font-size: 10px; font-weight: 650; }
  .calendar-day-view { min-height: 610px; }
  .calendar-day-header { display: flex; justify-content: space-between; gap: 18px; padding: 20px 22px 17px; border-bottom: 1px solid rgba(255,255,255,.06); }
  .calendar-day-heading { margin: 0; color: #f4f4f5; font-size: 20px; letter-spacing: -.02em; }
  .calendar-day-summary { margin-top: 5px; color: #777782; font-size: 12px; }
  .calendar-day-progress { position: relative; width: min(410px, 45vw); min-height: 126px; align-self: center; overflow: hidden; border-radius: 16px; background: #101923; box-shadow: inset 0 0 0 1px rgba(255,255,255,.11), 0 14px 34px rgba(0,0,0,.24); isolation: isolate; }
  .calendar-day-progress__image { position: absolute; z-index: -2; inset: 0 auto 0 0; width: 58%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.82) brightness(.72); transform: scale(1.015); transform-origin: left center; }
  .calendar-day-progress__veil { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, rgba(5,12,18,.04) 0%, rgba(5,12,18,.2) 34%, rgba(5,12,18,.9) 63%, rgba(5,12,18,.98) 100%); }
  .calendar-day-progress__content { width: 51%; margin-left: auto; display: grid; align-content: center; min-height: 126px; padding: 16px 17px 14px; }
  .calendar-day-progress__kicker { color: #e5aa55; font-size: 10px; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  .calendar-day-progress__headline { margin-top: 5px; color: #f4f1eb; font-size: 13px; font-weight: 760; line-height: 1.25; }
  .calendar-day-progress__hint { margin-top: 4px; color: #aeb8c1; font-size: 10px; line-height: 1.35; }
  .calendar-day-progress__track { height: 3px; margin-top: 11px; overflow: hidden; border-radius: 99px; background: rgba(255,255,255,.13); }
  .calendar-day-progress__track span { display: block; height: 100%; border-radius: inherit; background: #e7aa54; box-shadow: 0 0 10px rgba(231,170,84,.46); transition: width 180ms ease-out; }
  .calendar-day-progress--fog .calendar-day-progress__image { filter: saturate(.55) brightness(.48); }
  .calendar-day-progress--fog .calendar-day-progress__track span { opacity: 0; }
  .calendar-day-progress--harbor .calendar-day-progress__image { filter: saturate(.92) brightness(.88); }
  .calendar-day-progress--harbor .calendar-day-progress__track span { background: #f2bd69; box-shadow: 0 0 13px rgba(242,189,105,.58); }
  @media (prefers-reduced-motion: reduce) { .calendar-day-progress__track span { transition: none; } }
  .calendar-day-all-day { display: grid; grid-template-columns: 72px minmax(0,1fr); min-height: 46px; border-bottom: 1px solid rgba(255,255,255,.06); background: #0f0f14; }
  .calendar-day-all-day-label { padding: 14px 10px; border-right: 1px solid rgba(255,255,255,.055); color: #6f6f79; font-size: 9px; text-align: right; text-transform: uppercase; }
  .calendar-day-all-day-items { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px; }
  .calendar-day-all-day-item { display: inline-flex; align-items: center; min-height: 30px; padding: 0 10px; border-radius: 8px; color: #f1f1f3; background: color-mix(in srgb, var(--event-color) 16%, #17171e); box-shadow: inset 3px 0 0 var(--event-color), inset 0 0 0 1px rgba(255,255,255,.045); font-size: 11px; font-weight: 650; text-decoration: none; }
  .calendar-day-timeline-shell { position: relative; display: grid; grid-template-columns: 72px minmax(0,1fr); height: 1008px; background-color: var(--surface); background-image: linear-gradient(to bottom, transparent 27px, color-mix(in srgb, var(--line) 52%, transparent) 27px, color-mix(in srgb, var(--line) 52%, transparent) 28px, transparent 28px, transparent 55px, var(--line) 55px, var(--line) 56px); background-size: 100% 56px; }
  .calendar-day-times { position: relative; border-right: 1px solid rgba(255,255,255,.055); }
  .calendar-day-time-label { position: absolute; right: 11px; transform: translateY(-6px); color: #52525c; font-size: 9px; font-variant-numeric: tabular-nums; }
  .calendar-day-column { position: relative; min-width: 0; }
  .calendar-day-column.today { background: rgba(124,58,237,.028); }
  .calendar-day-column.is-planner-drop-target { background: rgba(124,58,237,.07); }
  .calendar-day-column.is-planner-drop-target::after { content: ""; position: absolute; z-index: 6; left: 6px; right: 6px; top: var(--planner-drop-y); height: 2px; border-radius: 99px; background: #f5b544; box-shadow: 0 0 0 4px rgba(245,181,68,.12); pointer-events: none; }
  .calendar-day-column.is-planner-drop-target::before { content: attr(data-planner-drop-time); position: absolute; z-index: 7; right: 8px; top: calc(var(--planner-drop-y) - 22px); padding: 3px 6px; border-radius: 6px; color: #1c1405; background: #f5b544; font-size: 9px; font-weight: 750; pointer-events: none; }
  .calendar-day-timeline-shell .calendar-current-time-line { left: 72px; }
  .calendar-day-column .calendar-week-event-timed, .calendar-day-column .calendar-week-time-block { left: 8px; right: 8px; }
  .calendar-day-free-state { position: absolute; z-index: 1; top: 70px; left: 18px; right: 18px; padding: 13px 14px; border-radius: 10px; color: #777782; background: color-mix(in srgb, var(--surface-raised) 82%, transparent); box-shadow: inset 0 0 0 1px var(--line); font-size: 12px; line-height: 1.45; white-space: normal; pointer-events: none; }
  .calendar-day-controls { border-top: 1px solid var(--line); background: var(--surface-inset); }
  .calendar-day-controls > summary { display: flex; align-items: center; justify-content: space-between; min-height: 48px; padding: 0 18px; color: var(--ink-secondary); font-size: 11px; font-weight: 700; cursor: pointer; list-style: none; }
  .calendar-day-controls > summary::-webkit-details-marker { display: none; }
  .calendar-day-controls > summary::after { content: "▾"; color: var(--ink-muted); transition: transform .15s ease; }
  .calendar-day-controls[open] > summary::after { transform: rotate(180deg); }
  .calendar-day-control-list { display: grid; gap: 7px; padding: 0 12px 12px; }
  .calendar-day-control-list .calendar-agenda-event { display: grid; grid-template-columns: 84px 3px minmax(0,1fr) auto; gap: 10px; align-items: center; padding: 10px; border-radius: 10px; color: inherit; background: var(--surface-raised); box-shadow: inset 0 0 0 1px var(--line); }
  .calendar-day-control-list .calendar-agenda-time { color: var(--ink-secondary); font-size: 10px; font-weight: 650; }
  .calendar-day-control-list .calendar-agenda-accent { align-self: stretch; border-radius: 99px; }
  .calendar-day-control-list .calendar-agenda-title { color: var(--ink); font-size: 11px; font-weight: 650; }
  .calendar-day-control-list .calendar-agenda-description { margin-top: 3px; color: var(--ink-muted); font-size: 9px; }
  .calendar-day-control-list .calendar-agenda-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 6px; color: var(--ink-muted); font-size: 9px; }
  .calendar-day-checklist { border-bottom: 1px solid var(--line); background: var(--surface-inset); }
  .calendar-day-checklist__header { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding: 11px 18px 8px; }
  .calendar-day-checklist__title { color: var(--ink-secondary); font-size: 11px; font-weight: 750; }
  .calendar-day-checklist__hint { color: var(--ink-muted); font-size: 9px; }
  .calendar-day-checklist__items { display: grid; gap: 5px; padding: 0 12px 12px; }
  .calendar-day-checklist__item { min-width: 0; display: grid; grid-template-columns: auto minmax(0,1fr) auto; align-items: center; gap: 10px; min-height: 44px; padding: 7px 9px; border-radius: 10px; background: var(--surface-raised); box-shadow: inset 0 0 0 1px var(--line); }
  .calendar-day-checklist__item.is-complete { background: var(--success-soft); }
  .calendar-day-checklist__copy { min-width: 0; }
  .calendar-day-checklist__time { color: var(--ink-muted); font-size: 9px; font-variant-numeric: tabular-nums; }
  .calendar-day-checklist__event { overflow: hidden; color: var(--ink); font-size: 11px; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
  .calendar-day-checklist__item.is-complete .calendar-day-checklist__event { color: var(--success); text-decoration: line-through; text-decoration-thickness: 1px; }
  .calendar-day-checklist__edit { min-height: 30px; display: inline-flex; align-items: center; padding: 0 9px; border-radius: 8px; color: var(--ink-muted); background: var(--surface-inset); font-size: 9px; font-weight: 700; text-decoration: none; }
  .calendar-event-complete-form { margin: 0; line-height: 0; }
  .calendar-event-complete-button { width: 32px; height: 32px; display: inline-grid; place-items: center; padding: 0; border: 1px solid var(--line-strong); border-radius: 999px; color: var(--ink-muted); background: var(--surface); font: inherit; font-size: 17px; font-weight: 800; line-height: 1; cursor: pointer; }
  .calendar-event-complete-button:hover { border-color: var(--success); color: var(--success); background: var(--success-soft); }
  .calendar-event-complete-button.is-complete { border-color: var(--success); color: var(--canvas); background: var(--success); }
  .calendar-event-complete-button:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .calendar-mobile-only { display: none; }
  .calendar-flash { max-width: 1680px; margin: 12px auto 0; padding: 0 24px; }
  .calendar-flash-message { padding: 10px 13px; border-radius: 10px; color: #d8d8dd; background: #181820; box-shadow: inset 0 0 0 1px rgba(255,255,255,.06); font-size: 12px; }
  button.calendar-primary-link, button.calendar-icon-link { border: 0; font: inherit; cursor: pointer; }
  .calendar-quick-dialog { width: min(620px, calc(100vw - 32px)); max-height: min(760px, calc(100vh - 32px)); margin: auto; padding: 0; overflow: auto; border: 0; border-radius: 20px; color: var(--ink); background: var(--surface); box-shadow: 0 26px 80px rgba(0,0,0,.5), inset 0 0 0 1px var(--line-strong); }
  .calendar-quick-dialog::backdrop { background: rgba(5,5,12,.68); backdrop-filter: blur(6px); }
  .calendar-quick-shell { padding: 22px; }
  .calendar-quick-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }
  .calendar-quick-kicker { color: var(--accent-text); font-size: 9px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .calendar-quick-header h2 { margin: 5px 0 0; color: var(--ink); font-size: 22px; letter-spacing: -.03em; }
  .calendar-quick-close { width: 34px; height: 34px; border: 0; border-radius: 9px; color: var(--ink-secondary); background: var(--surface-inset); font-size: 20px; cursor: pointer; }
  .calendar-quick-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 3px; margin: 20px 0 18px; padding: 3px; border-radius: 11px; background: var(--surface-inset); }
  .calendar-quick-tabs button { min-height: 38px; border: 0; border-radius: 8px; color: var(--ink-muted); background: transparent; font: inherit; font-size: 12px; font-weight: 700; cursor: pointer; }
  .calendar-quick-tabs button[aria-selected="true"] { color: var(--accent-text); background: var(--surface-raised); box-shadow: inset 0 0 0 1px var(--line); }
  .calendar-quick-form { display: grid; gap: 16px; }
  .calendar-quick-field { min-width: 0; display: grid; gap: 7px; color: var(--ink-secondary); font-size: 11px; font-weight: 650; }
  .calendar-quick-field input, .calendar-quick-field textarea, .calendar-quick-field select { width: 100%; min-height: 43px; border: 1px solid var(--line); border-radius: 10px; padding: 0 11px; color: var(--ink); background: var(--surface-inset); outline: none; font: inherit; font-size: 13px; }
  .calendar-quick-field textarea { min-height: 92px; padding: 11px; resize: vertical; line-height: 1.45; }
  .calendar-quick-field input:focus, .calendar-quick-field textarea:focus, .calendar-quick-field select:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .calendar-quick-when { display: grid; grid-template-columns: minmax(140px,1.15fr) minmax(100px,.75fr) auto; gap: 10px; align-items: end; }
  .calendar-quick-range { min-height: 43px; display: flex; align-items: center; padding: 0 10px; border-radius: 10px; color: var(--accent-text); background: var(--accent-soft); font-size: 11px; font-weight: 750; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .calendar-quick-duration { display: flex; flex-wrap: wrap; gap: 6px; }
  .calendar-quick-duration button { min-height: 34px; padding: 0 10px; border: 1px solid var(--line); border-radius: 9px; color: var(--ink-secondary); background: var(--surface-inset); font: inherit; font-size: 11px; cursor: pointer; }
  .calendar-quick-duration button[aria-pressed="true"] { border-color: color-mix(in srgb, var(--accent) 44%, var(--line)); color: var(--accent-text); background: var(--accent-soft); }
  .calendar-quick-all-day { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-secondary); font-size: 11px; cursor: pointer; }
  .calendar-quick-all-day input { width: 16px; height: 16px; accent-color: var(--accent); }
  .calendar-quick-details { border-top: 1px solid var(--line); padding-top: 13px; }
  .calendar-quick-details summary { color: var(--ink-muted); font-size: 11px; font-weight: 700; cursor: pointer; }
  .calendar-quick-details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 13px; }
  .calendar-quick-field--full { grid-column: 1 / -1; }
  .calendar-quick-actions { display: flex; justify-content: flex-end; gap: 8px; padding-top: 15px; border-top: 1px solid var(--line); }
  .calendar-quick-secondary, .calendar-quick-submit { min-height: 42px; padding: 0 15px; border: 0; border-radius: 10px; font: inherit; font-size: 12px; font-weight: 700; cursor: pointer; }
  .calendar-quick-secondary { color: var(--ink-secondary); background: var(--surface-inset); }
  .calendar-quick-submit { color: var(--accent-ink); background: var(--accent); }


  @media (max-width: 700px) {
    .calendar-frame { padding: 16px 10px calc(96px + env(safe-area-inset-bottom)); overflow-x: clip; }
    .calendar-toolbar { display: block; margin-bottom: 12px; }
    .calendar-title-row { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: start; }
    .calendar-title { font-size: 25px; }
    .calendar-subtitle { display: none; }
    .calendar-toolbar-actions { display: grid; grid-template-columns: auto minmax(0,1fr) auto; margin-top: 13px; gap: 7px; }
    .calendar-today-link { grid-column: 1; grid-row: 1; }
    .calendar-view-switch { grid-column: 1 / -1; grid-row: 2; width: 100%; justify-content: center; }
    .calendar-view-link { flex: 1; padding: 0 10px; }
    .calendar-primary-link { grid-column: 3; grid-row: 1; width: 42px; padding: 0; }
    .calendar-primary-label { display: none; }
    .calendar-today-link { padding: 0 11px; }
    .calendar-surface { border-radius: 12px; }
    .calendar-weekday { padding: 9px 2px; font-size: 9px; letter-spacing: 0; }
    .calendar-weekday-long { display: none; }
    .calendar-weekday-short { display: inline; }
    .calendar-month-day { min-height: 82px; padding: 4px; }
    .calendar-day-link { width: 24px; height: 24px; border-radius: 7px; font-size: 10px; }
    .calendar-month-events { gap: 3px; margin-top: 4px; }
    .calendar-event-chip { display: block; padding: 4px; border-radius: 5px; background: #181820; box-shadow: inset 2px 0 0 var(--event-color); }
    .calendar-event-accent, .calendar-event-time { display: none; }
    .calendar-event-title { overflow: hidden; display: block; color: var(--ink-secondary); font-size: 8px; line-height: 1.15; text-overflow: ellipsis; white-space: nowrap; }
    .calendar-more { margin-top: 3px; font-size: 8px; }
    .calendar-week-desktop { display: none; }
    .calendar-week { display: block; }
    .calendar-week-day { min-height: auto; padding: 13px; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.055); }
    .calendar-week-day-head { display: flex; align-items: center; gap: 9px; margin-bottom: 10px; text-align: left; }
    .calendar-week-day-number { order: -1; margin-top: 0; }
    .calendar-week-events { grid-template-columns: 1fr; }
    .calendar-week-empty { color: #555560; font-size: 11px; }
    .calendar-day-view { min-height: 520px; }
    .calendar-day-header { align-items: flex-start; flex-wrap: wrap; }
    .calendar-day-heading { font-size: 17px; }
    .calendar-day-progress { width: 100%; min-width: 0; min-height: 142px; flex: 1 0 100%; order: 3; }
    .calendar-day-progress__content { width: 58%; min-height: 142px; padding: 15px 14px; }
    .calendar-day-progress__veil { background: linear-gradient(90deg, rgba(5,12,18,.04) 0%, rgba(5,12,18,.25) 31%, rgba(5,12,18,.91) 58%, rgba(5,12,18,.98) 100%); }
    .calendar-day-progress__headline { font-size: 12px; }
    .calendar-day-progress__hint { font-size: 10px; }
    .calendar-day-all-day, .calendar-day-timeline-shell { grid-template-columns: 52px minmax(0,1fr); }
    .calendar-day-all-day-label { padding-inline: 4px; font-size: 8px; }
    .calendar-day-time-label { right: 7px; font-size: 8px; }
    .calendar-day-timeline-shell .calendar-current-time-line { left: 52px; }
    .calendar-day-column .calendar-week-event-timed, .calendar-day-column .calendar-week-time-block { left: 5px; right: 5px; }
    .calendar-day-control-list .calendar-agenda-event { grid-template-columns: 62px 3px minmax(0,1fr); }
    .calendar-day-control-list .calendar-agenda-meta { grid-column: 3; justify-content: flex-start; }
    .calendar-mobile-only { display: inline-flex; }
    .calendar-quick-dialog { width: 100%; max-width: none; max-height: calc(100vh - 12px); margin: auto 0 0; border-radius: 20px 20px 0 0; }
    .calendar-quick-shell { padding: 18px 14px calc(18px + env(safe-area-inset-bottom)); }
    .calendar-quick-when { grid-template-columns: 1fr 1fr; }
    .calendar-quick-range { grid-column: 1 / -1; justify-content: center; }
    .calendar-quick-details-grid { grid-template-columns: 1fr; }
    .calendar-quick-field--full { grid-column: auto; }
    .calendar-quick-actions { position: sticky; bottom: 0; margin: 0 -14px -18px; padding: 12px 14px calc(12px + env(safe-area-inset-bottom)); background: var(--surface); }
  }
  /* Echo 2026 theme bridge: calendar is an Operate surface in both native themes. */
  .calendar-app { background: var(--canvas); color: var(--ink); }
  .calendar-title, .calendar-side-heading, .calendar-day-heading, .calendar-empty-title { color: var(--ink); }
  .calendar-subtitle, .calendar-count, .calendar-empty-compact, .calendar-shortcut, .calendar-event-time,
  .calendar-week-time-label, .calendar-week-head-name, .calendar-day-summary, .calendar-agenda-description,
  .calendar-agenda-meta, .calendar-week-event-time, .calendar-weekday { color: var(--ink-muted); }
  .calendar-nav, .calendar-today-link, .calendar-view-switch { background: var(--surface-inset); box-shadow: inset 0 0 0 1px var(--line); }
  .calendar-icon-link, .calendar-today-link, .calendar-view-link { color: var(--ink-secondary); }
  .calendar-icon-link:hover, .calendar-today-link:hover, .calendar-view-link:hover { color: var(--ink); background: var(--surface-hover); }
  .calendar-view-link.active { color: var(--ink); background: var(--surface-raised); box-shadow: 0 1px 3px rgba(0,0,0,.08), inset 0 0 0 1px var(--line); }
  .calendar-primary-link { color: var(--accent-ink); background: var(--accent); box-shadow: none; }
  .calendar-primary-link:hover { background: var(--accent-strong); }
  .calendar-surface, .calendar-side-card { background: var(--surface); box-shadow: var(--shadow-card), inset 0 0 0 1px var(--line); }
  .calendar-upcoming-item, .calendar-event-chip, .calendar-agenda-event { background: var(--surface-raised); box-shadow: inset 0 0 0 1px var(--line); }
  .calendar-upcoming-item:hover, .calendar-event-chip:hover, .calendar-agenda-event:hover { background: var(--surface-hover); }
  .calendar-upcoming-title, .calendar-event-title, .calendar-week-event-title, .calendar-agenda-title { color: var(--ink); }
  .calendar-category { color: var(--ink-secondary); }
  .calendar-weekdays, .calendar-week-head { background: var(--surface-inset); border-color: var(--line); }
  .calendar-month-day { background: var(--surface); border-color: var(--line); }
  .calendar-month-day.outside { background: var(--canvas-subtle); }
  .calendar-month-day.today { background: var(--accent-soft); }
  .calendar-month-day.is-month-drop-target { background: color-mix(in srgb, var(--accent) 16%, var(--surface)); box-shadow: inset 0 0 0 2px var(--accent); }
  .calendar-month-day.is-month-drop-target::after { color: var(--accent-ink); background: var(--accent); }
  .calendar-month-day:focus-visible { outline-color: var(--accent); }
  .calendar-day-link, .calendar-week-head-number, .calendar-week-day-number { color: var(--ink-secondary); }
  .today .calendar-day-link, .calendar-week-head-day.today .calendar-week-head-number, .calendar-week-day.today .calendar-week-day-number { color: var(--accent-ink); background: var(--accent); }
  .calendar-more { color: var(--accent); }
  .calendar-time-block-chip, .calendar-week-time-block, .calendar-time-block-mobile, .calendar-agenda-time-block {
    color: var(--ink); background: var(--fixed-soft); box-shadow: inset 3px 0 0 var(--fixed), inset 0 0 0 1px color-mix(in srgb, var(--fixed) 28%, var(--line));
  }
  .calendar-time-block-accent { background: repeating-linear-gradient(to bottom, var(--fixed) 0 4px, transparent 4px 8px); }
  .calendar-week-timeline { background-color: var(--surface); background-image: linear-gradient(to bottom, transparent 27px, color-mix(in srgb, var(--line) 52%, transparent) 27px, color-mix(in srgb, var(--line) 52%, transparent) 28px, transparent 28px, transparent 55px, var(--line) 55px, var(--line) 56px); background-size: 100% 56px; }
  .calendar-week-times, .calendar-week-column, .calendar-week-head-spacer, .calendar-week-head-day, .calendar-week-day, .calendar-day-header, .calendar-day-times, .calendar-day-all-day, .calendar-day-all-day-label { border-color: var(--line); }
  .calendar-week-column.today, .calendar-week-head-day.today, .calendar-week-day.today { background: var(--accent-soft); }
  .calendar-week-column.is-planner-drop-target { background: var(--accent-soft); }
  .calendar-week-column.is-planner-drop-target::after { background: var(--fixed); box-shadow: 0 0 0 4px var(--fixed-soft); }
  .calendar-week-column.is-planner-drop-target::before { color: var(--canvas); background: var(--fixed); }
  .calendar-week-event-timed, .calendar-week-event { color: var(--ink); background: color-mix(in srgb, var(--event-color) 13%, var(--surface-raised)); box-shadow: inset 3px 0 0 var(--event-color), inset 0 0 0 1px var(--line); }
  .calendar-time-block-undo, .calendar-time-block-edit, .calendar-time-block-reschedule-undo { color: var(--accent); background: var(--accent-soft); }
  .calendar-empty-icon { color: var(--accent); background: var(--accent-soft); }
  .calendar-empty-text { color: var(--ink-muted); }
  .calendar-flash-message { color: var(--ink-secondary); background: var(--surface-raised); box-shadow: inset 0 0 0 1px var(--line); }

</style>

<%= render "calendar_events/task_lane_styles" %>
<%= render "shared/unified_header" %>

<% if notice.present? || alert.present? %>
  <div class="calendar-flash"><div class="calendar-flash-message"><%= notice || alert %></div></div>
<% end %>

<section class="calendar-app" data-calendar-view="<%= @calendar_view %>" data-controller="calendar-quick-create">
  <div class="calendar-frame">
    <header class="calendar-toolbar">
      <div class="calendar-title-row">
        <div>
          <h1 class="calendar-title"><%= calendar_period_title(@calendar_view, @current_date) %></h1>
          <div class="calendar-subtitle"><%= @calendar_events.size %> событий · <%= current_user.timezone %></div>
        </div>
        <div class="calendar-nav" aria-label="Навигация по датам">
          <%= link_to calendar_view_path(@calendar_view, @previous_date), class: "calendar-icon-link", aria: { label: "Назад" } do %>
            <span aria-hidden="true">‹</span>
          <% end %>
          <%= link_to calendar_view_path(@calendar_view, @next_date), class: "calendar-icon-link", aria: { label: "Вперёд" } do %>
            <span aria-hidden="true">›</span>
          <% end %>
        </div>
      </div>

      <div class="calendar-toolbar-actions">
        <%= link_to "Сегодня", calendar_view_path(@calendar_view, Time.current.in_time_zone(current_user.timezone).to_date), class: "calendar-today-link" %>
        <nav class="calendar-view-switch" aria-label="Вид календаря">
          <% [["День", "day"], ["Неделя", "week"], ["Месяц", "month"]].each do |label, view| %>
            <%= link_to label, calendar_view_path(view, @current_date), class: "calendar-view-link #{'active' if @calendar_view == view}", aria: { current: (@calendar_view == view ? "page" : nil) } %>
          <% end %>
        </nav>
        <button type="button"
                class="calendar-primary-link"
                data-action="calendar-quick-create#open"
                data-quick-create-date="<%= @current_date.iso8601 %>"
                data-quick-create-time="09:00">
          <span aria-hidden="true">＋</span><span class="calendar-primary-label">Создать</span>
        </button>
      </div>
    </header>

    <div class="calendar-workspace"
         data-controller="planner-drag"
         data-planner-drag-timezone-value="<%= current_user.timezone %>"
         data-planner-drag-view-value="<%= @calendar_view %>">
      <div class="planner-drag-status" data-planner-drag-target="status" role="status" aria-live="polite"></div>
      <%= render "calendar_events/task_lane",
                 task: @task,
                 tasks: @unscheduled_tasks,
                 calendar_view: @calendar_view,
                 calendar_date: @current_date.iso8601 %>

      <main class="calendar-surface">
        <% if @calendar_view == "month" %>
          <div class="calendar-weekdays" aria-hidden="true">
            <% CalendarEventsHelper::RUSSIAN_WEEKDAYS.each_with_index do |day, index| %>
              <div class="calendar-weekday"><span class="calendar-weekday-long"><%= day %></span><span class="calendar-weekday-short"><%= CalendarEventsHelper::SHORT_WEEKDAYS[index] %></span></div>
            <% end %>
          </div>
          <div class="calendar-month-grid">
            <% @calendar_days.each do |date| %>
              <% events = @events_by_date.fetch(date, []) %>
              <% blocks = @time_blocks_by_date.fetch(date, []) %>
              <% items = (events + blocks).sort_by { |item| item.is_a?(TimeBlock) ? item.starts_at : item.start_time } %>
              <article class="calendar-month-day <%= 'outside' unless date.month == @current_date.month %> <%= 'today' if date == Time.current.in_time_zone(current_user.timezone).to_date %>"
                       tabindex="0"
                       data-calendar-date="<%= date.iso8601 %>"
                       data-planner-drag-target="day"
                       data-action="click->calendar-quick-create#openMonth keydown.enter->calendar-quick-create#openMonth dragover->planner-drag#monthOver dragleave->planner-drag#leave drop->planner-drag#monthDrop">
                <%= link_to date.day, calendar_view_path("day", date), class: "calendar-day-link", aria: { label: calendar_day_heading(date) } %>
                <div class="calendar-month-events">
                  <% items.first(3).each do |item| %>
                    <% if item.is_a?(TimeBlock) %>
                      <%= render "calendar_events/time_block_month", time_block: item %>
                    <% else %>
                      <%= link_to edit_calendar_event_path(item),
                                  class: "calendar-event-chip",
                                  style: "--event-color: #{calendar_event_color(item)}",
                                  draggable: calendar_event_draggable?(item),
                                  title: (calendar_event_draggable?(item) ? "Перетащи на другой день" : "Открой событие, чтобы изменить дату"),
                                  data: {
                                    planner_drag_kind: "calendar-event",
                                    planner_drag_event_id: item.id,
                                    planner_drag_event_lock_version: item.lock_version,
                                    planner_drag_duration: item.duration_minutes || 60,
                                    planner_drag_local_time: item.all_day? ? "00:00" : item.start_time.in_time_zone(current_user.timezone).strftime("%H:%M"),
                                    planner_drag_update_url: calendar_event_path(item),
                                    planner_touch_enabled: calendar_event_draggable?(item),
                                    action: ("dragstart->planner-drag#start dragend->planner-drag#finish pointerdown->planner-drag#pointerStart pointermove->planner-drag#pointerMove pointerup->planner-drag#pointerEnd pointercancel->planner-drag#pointerCancel click->planner-drag#guardClick" if calendar_event_draggable?(item))
                                  } do %>
                        <span class="calendar-event-accent" style="background: <%= calendar_event_color(item) %>"></span>
                        <span class="calendar-event-copy">
                          <span class="calendar-event-time"><%= item.all_day? ? "весь день" : item.start_time.in_time_zone(current_user.timezone).strftime("%H:%M") %></span>
                          <span class="calendar-event-title"><%= item.title %></span>
                        </span>
                      <% end %>
                    <% end %>
                  <% end %>
                  <% if items.size > 3 %>
                    <%= link_to "+#{items.size - 3} ещё", calendar_view_path("day", date), class: "calendar-more" %>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>
        <% elsif @calendar_view == "week" %>
          <div class="calendar-week-desktop">
            <div class="calendar-week-head">
              <div class="calendar-week-head-spacer"></div>
              <% @calendar_days.each do |date| %>
                <% all_day_events = @events_by_date.fetch(date, []).select(&:all_day?) %>
                <%= link_to calendar_view_path("day", date), class: "calendar-week-head-day #{'today' if date == Time.current.in_time_zone(current_user.timezone).to_date}" do %>
                  <span class="calendar-week-head-name"><%= CalendarEventsHelper::SHORT_WEEKDAYS[date.cwday - 1] %></span>
                  <span class="calendar-week-head-number"><%= date.day %></span>
                  <% all_day_events.first(1).each do |event| %><span class="calendar-all-day-chip"><%= event.title %></span><% end %>
                <% end %>
              <% end %>
            </div>
            <div class="calendar-week-timeline">
              <div class="calendar-week-times">
                <% (6..23).each do |hour| %><span class="calendar-week-time-label" style="top: <%= (hour - 6) * 56 %>px"><%= format("%02d:00", hour) %></span><% end %>
              </div>
              <% if @calendar_days.include?(Time.current.in_time_zone(current_user.timezone).to_date) %>
                <div class="calendar-current-time-line" data-current-time-line style="top: <%= calendar_current_time_top(current_user.timezone) %>px" aria-label="Текущее время"></div>
              <% end %>
              <% @calendar_days.each do |date| %>
                <% timed_events = @events_by_date.fetch(date, []).reject(&:all_day?) %>
                <% timed_blocks = @time_blocks_by_date.fetch(date, []) %>
                <div class="calendar-week-column <%= 'today' if date == Time.current.in_time_zone(current_user.timezone).to_date %>"
                     data-calendar-day="<%= date.iso8601 %>"
                     data-planner-drag-target="day"
                     data-action="click->calendar-quick-create#openWeek dragover->planner-drag#over dragleave->planner-drag#leave drop->planner-drag#drop">
                  <% timed_events.each do |event| %>
                    <%= link_to edit_calendar_event_path(event),
                                class: "calendar-week-event-timed",
                                style: calendar_week_event_style(event, current_user.timezone),
                                draggable: calendar_event_draggable?(event),
                                title: (calendar_event_draggable?(event) ? "Перетащи, чтобы изменить время" : "Открой событие, чтобы изменить время"),
                                data: {
                                  event_title: event.title,
                                  planner_drag_kind: "calendar-event",
                                  planner_drag_event_id: event.id,
                                  planner_drag_event_lock_version: event.lock_version,
                                  planner_drag_duration: event.duration_minutes || 60,
                                  planner_drag_update_url: calendar_event_path(event),
                                  planner_touch_enabled: calendar_event_draggable?(event),
                                  action: ("dragstart->planner-drag#start dragend->planner-drag#finish pointerdown->planner-drag#pointerStart pointermove->planner-drag#pointerMove pointerup->planner-drag#pointerEnd pointercancel->planner-drag#pointerCancel click->planner-drag#guardClick" if calendar_event_draggable?(event))
                                } do %>
                      <div class="calendar-week-event-time"><%= calendar_event_time(event, current_user.timezone) %></div>
                      <div class="calendar-week-event-title"><%= event.title %></div>
                    <% end %>
                  <% end %>
                  <% timed_blocks.each do |time_block| %><%= render "calendar_events/time_block_week", time_block: time_block %><% end %>
                </div>
              <% end %>
            </div>
          </div>

          <div class="calendar-week">
            <% @calendar_days.each do |date| %>
              <% events = @events_by_date.fetch(date, []) %>
              <% blocks = @time_blocks_by_date.fetch(date, []) %>
              <section class="calendar-week-day <%= 'today' if date == Time.current.in_time_zone(current_user.timezone).to_date %>"
                       data-calendar-mobile-day="<%= date.iso8601 %>"
                       data-planner-drag-target="day"
                       data-calendar-date="<%= date.iso8601 %>">
                <%= link_to calendar_view_path("day", date), class: "calendar-week-day-head" do %>
                  <span class="calendar-week-day-name"><%= CalendarEventsHelper::SHORT_WEEKDAYS[date.cwday - 1] %></span>
                  <span class="calendar-week-day-number"><%= date.day %></span>
                <% end %>
                <div class="calendar-week-events">
                  <% events.each do |event| %>
                    <%= link_to edit_calendar_event_path(event),
                                class: "calendar-week-event",
                                style: "--event-color: #{calendar_event_color(event)}",
                                draggable: calendar_event_draggable?(event),
                                data: {
                                  event_title: event.title,
                                  planner_drag_kind: "calendar-event",
                                  planner_drag_event_id: event.id,
                                  planner_drag_event_lock_version: event.lock_version,
                                  planner_drag_local_time: event.start_time.in_time_zone(current_user.timezone).strftime("%H:%M"),
                                  planner_drag_duration: event.duration_minutes || 60,
                                  planner_drag_update_url: calendar_event_path(event),
                                  planner_touch_enabled: calendar_event_draggable?(event),
                                  action: ("dragstart->planner-drag#start dragend->planner-drag#finish pointerdown->planner-drag#pointerStart pointermove->planner-drag#pointerMove pointerup->planner-drag#pointerEnd pointercancel->planner-drag#pointerCancel click->planner-drag#guardClick" if calendar_event_draggable?(event))
                                } do %>
                      <div class="calendar-week-event-time"><%= calendar_event_time(event, current_user.timezone) %></div>
                      <div class="calendar-week-event-title"><%= event.title %></div>
                    <% end %>
                  <% end %>
                  <% blocks.each do |time_block| %><%= render "calendar_events/time_block_mobile", time_block: time_block %><% end %>
                  <% if events.empty? && blocks.empty? %><div class="calendar-week-empty">Свободно</div><% end %>
                </div>
              </section>
            <% end %>
          </div>
        <% else %>
          <% events = @events_by_date.fetch(@current_date, []) %>
          <% all_day_events = events.select(&:all_day?) %>
          <% timed_events = events.reject(&:all_day?) %>
          <% blocks = @time_blocks_by_date.fetch(@current_date, []) %>
          <% timeline_layout = calendar_day_timeline_layout(timed_events, blocks, @current_date, current_user.timezone) %>
          <% outside_timed_events = timed_events.filter_map { |event| interval = calendar_day_early_interval(event, @current_date, current_user.timezone); interval&.merge(record: event) } %>
          <% outside_blocks = blocks.filter_map { |block| interval = calendar_day_early_interval(block, @current_date, current_user.timezone); interval&.merge(record: block) } %>
          <div class="calendar-day-view">
            <header class="calendar-day-header">
              <div>
                <h2 class="calendar-day-heading"><%= calendar_day_heading(@current_date) %></h2>
                <div class="calendar-day-summary"><%= events.empty? && blocks.empty? ? "День свободен" : "#{events.size} событий · #{blocks.size} задач во времени" %></div>
              </div>
              <%= render "calendar_events/day_progress", events: events %>
              <button type="button" class="calendar-icon-link calendar-mobile-only" aria-label="Создать" data-action="calendar-quick-create#open" data-quick-create-date="<%= @current_date.iso8601 %>" data-quick-create-time="09:00">＋</button>
            </header>

            <% if events.any? %>
              <section class="calendar-day-checklist" aria-label="Отметить выполненные действия">
                <header class="calendar-day-checklist__header">
                  <span class="calendar-day-checklist__title">Действия дня</span>
                  <span class="calendar-day-checklist__hint">Нажми круг, когда готово</span>
                </header>
                <div class="calendar-day-checklist__items">
                  <% events.each do |event| %>
                    <article class="calendar-day-checklist__item <%= 'is-complete' if event.done? %>">
                      <%= render "calendar_events/event_completion",
                                 event: event,
                                 calendar_view: @calendar_view,
                                 calendar_date: @current_date.iso8601 %>
                      <div class="calendar-day-checklist__copy">
                        <div class="calendar-day-checklist__time"><%= calendar_event_time(event, current_user.timezone) %></div>
                        <div class="calendar-day-checklist__event"><%= event.title %></div>
                      </div>
                      <%= link_to "Изменить", edit_calendar_event_path(event), class: "calendar-day-checklist__edit" %>
                    </article>
                  <% end %>
                </div>
              </section>
            <% end %>

            <% if all_day_events.any? %>
              <div class="calendar-day-all-day">
                <div class="calendar-day-all-day-label">Весь день</div>
                <div class="calendar-day-all-day-items">
                  <% all_day_events.each do |event| %>
                    <%= link_to event.title, edit_calendar_event_path(event), class: "calendar-day-all-day-item", style: "--event-color: #{calendar_event_color(event)}" %>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if outside_timed_events.any? || outside_blocks.any? %>
              <div class="calendar-day-all-day calendar-day-outside-grid" data-day-outside-grid>
                <div class="calendar-day-all-day-label">00:00–06:00</div>
                <div class="calendar-day-all-day-items">
                  <% outside_timed_events.each do |item| %>
                    <% event = item[:record] %>
                    <%= link_to "#{calendar_day_item_time(item)} · #{event.title}", edit_calendar_event_path(event), class: "calendar-day-all-day-item", style: "--event-color: #{calendar_event_color(event)}" %>
                  <% end %>
                  <% outside_blocks.each do |item| %>
                    <% block = item[:record] %>
                    <%= link_to "#{calendar_day_item_time(item)} · #{block.task.title}", edit_task_time_block_path(block.task, block), class: "calendar-day-all-day-item calendar-day-outside-task" %>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div class="calendar-day-timeline-shell">
              <div class="calendar-day-times">
                <% (6..23).each do |hour| %><span class="calendar-day-time-label" style="top: <%= (hour - 6) * 56 %>px"><%= format("%02d:00", hour) %></span><% end %>
              </div>
              <% if @current_date == Time.current.in_time_zone(current_user.timezone).to_date %>
                <div class="calendar-current-time-line" data-current-time-line style="top: <%= calendar_current_time_top(current_user.timezone) %>px" aria-label="Текущее время"></div>
              <% end %>
              <div class="calendar-day-column <%= 'today' if @current_date == Time.current.in_time_zone(current_user.timezone).to_date %>"
                   data-day-timeline
                   data-calendar-day="<%= @current_date.iso8601 %>"
                   data-planner-drag-target="day"
                   data-action="click->calendar-quick-create#openWeek dragover->planner-drag#over dragleave->planner-drag#leave drop->planner-drag#drop">
                <% timeline_layout.each do |item| %>
                  <% if item[:kind] == "calendar-event" %>
                    <% event = item[:record] %>
                    <%= link_to edit_calendar_event_path(event),
                                class: "calendar-week-event-timed",
                                style: calendar_day_item_style(item),
                                draggable: calendar_event_draggable?(event),
                                title: (calendar_event_draggable?(event) ? "Перетащи, чтобы изменить время" : "Открой событие, чтобы изменить время"),
                                data: {
                                  day_layout_item: "calendar-event",
                                  event_title: event.title,
                                  planner_drag_kind: "calendar-event",
                                  planner_drag_event_id: event.id,
                                  planner_drag_event_lock_version: event.lock_version,
                                  planner_drag_duration: event.duration_minutes || 60,
                                  planner_drag_update_url: calendar_event_path(event),
                                  planner_touch_enabled: calendar_event_draggable?(event),
                                  action: ("dragstart->planner-drag#start dragend->planner-drag#finish pointerdown->planner-drag#pointerStart pointermove->planner-drag#pointerMove pointerup->planner-drag#pointerEnd pointercancel->planner-drag#pointerCancel click->planner-drag#guardClick" if calendar_event_draggable?(event))
                                } do %>
                      <div class="calendar-week-event-time"><%= calendar_day_item_time(item) %></div>
                      <div class="calendar-week-event-title"><%= event.title %></div>
                    <% end %>
                  <% else %>
                    <%= render "calendar_events/time_block_week",
                               time_block: item[:record],
                               timeline_style: calendar_day_item_style(item),
                               time_label: calendar_day_item_time(item),
                               day_layout_item: "time-block" %>
                  <% end %>
                <% end %>
                <% if timeline_layout.empty? %>
                  <div class="calendar-day-free-state" data-day-free-state>День свободен на шкале 06:00–24:00. Создай событие или перетащи сюда задачу.</div>
                <% end %>
              </div>
            </div>
            <% if blocks.any? %>
              <details class="calendar-day-controls" <%= "open" if flash[:time_block_reschedule_undo].present? %>>
                <summary>Управление задачами во времени (<%= blocks.size %>)</summary>
                <div class="calendar-day-control-list">
                  <% blocks.each do |time_block| %><%= render "calendar_events/time_block_day", time_block: time_block %><% end %>
                </div>
              </details>
            <% end %>
          </div>
        <% end %>
      </main>
    </div>
  </div>
  <%= render "calendar_events/quick_create" %>
</section>
