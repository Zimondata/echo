<%= link_to edit_task_time_block_path(time_block.task, time_block),
            class: "calendar-event-chip calendar-time-block-chip #{'is-locked' if time_block.locked?}",
            style: "--event-color: #{time_block.locked? ? '#f5b544' : '#8b5cf6'}",
            draggable: !time_block.locked?,
            title: (time_block.locked? ? "Время зафиксировано. Открой блок, чтобы изменить." : "Перетащи в другой день"),
            data: {
              time_block_id: time_block.id,
              planner_drag_kind: "time-block",
              planner_drag_task_id: time_block.task_id,
              planner_drag_task_lock_version: time_block.task.lock_version,
              planner_drag_time_block_id: time_block.id,
              planner_drag_block_lock_version: time_block.lock_version,
              planner_drag_duration: time_block.duration_minutes,
              planner_drag_local_time: time_block.starts_at.in_time_zone(current_user.timezone).strftime("%H:%M"),
              planner_drag_locked: time_block.locked?.to_s,
              planner_drag_update_url: task_time_block_path(time_block.task, time_block),
              action: ("dragstart->planner-drag#start dragend->planner-drag#finish click->planner-drag#guardClick" unless time_block.locked?)
            },
            aria: { label: "Изменить задачу #{time_block.task.title}" } do %>
  <span class="calendar-event-accent calendar-time-block-accent"></span>
  <span class="calendar-event-time"><%= time_block_time(time_block, current_user.timezone) %></span>
  <span class="calendar-event-title"><%= time_block.task.title %></span>
<% end %>
