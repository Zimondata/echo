<!-- Quick Actions Widget -->
<div class="widget-card bg-gradient-to-br from-gray-50 to-slate-50 border border-gray-200 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 p-6">
  <div class="widget-header flex items-center justify-between mb-4">
    <h3 class="text-lg font-medium text-gray-900 flex items-center">
      <span class="w-8 h-8 bg-gradient-to-r from-gray-400 to-slate-500 rounded-full mr-3 flex items-center justify-center">
        <span class="text-white text-sm">⚡</span>
      </span>
      Быстрые действия
    </h3>
  </div>
  
  <div class="widget-preview grid grid-cols-2 gap-3">
    <!-- Telegram Bot Link -->
    <button class="bg-blue-500 hover:bg-blue-600 text-white rounded-lg p-3 transition-all duration-200 hover:scale-105 active:scale-95 text-center group">
      <div class="text-lg mb-1">💬</div>
      <div class="text-xs font-medium">Telegram Bot</div>
      <div class="text-xs opacity-80">Записать идею</div>
    </button>
    
    <!-- Add Event -->
    <button onclick="openQuickEvent()" class="bg-purple-500 hover:bg-purple-600 text-white rounded-lg p-3 transition-all duration-200 hover:scale-105 active:scale-95 text-center group">
      <div class="text-lg mb-1">📅</div>
      <div class="text-xs font-medium">Событие</div>
      <div class="text-xs opacity-80">Быстро добавить</div>
    </button>
    
    <!-- Voice Note -->
    <button class="bg-green-500 hover:bg-green-600 text-white rounded-lg p-3 transition-all duration-200 hover:scale-105 active:scale-95 text-center group">
      <div class="text-lg mb-1">🎤</div>
      <div class="text-xs font-medium">Голосовая</div>
      <div class="text-xs opacity-80">Через бота</div>
    </button>
    
    <!-- Search -->
    <button onclick="openSearch()" class="bg-indigo-500 hover:bg-indigo-600 text-white rounded-lg p-3 transition-all duration-200 hover:scale-105 active:scale-95 text-center group">
      <div class="text-lg mb-1">🔍</div>
      <div class="text-xs font-medium">Поиск</div>
      <div class="text-xs opacity-80">Найти записи</div>
    </button>
  </div>
  
  <div class="widget-footer pt-4 border-t border-gray-200 mt-4">
    <div class="text-center">
      <a href="https://t.me/<%= ENV['TELEGRAM_BOT_USERNAME'] || 'your_bot' %>" 
         target="_blank"
         class="text-xs text-indigo-600 hover:text-indigo-700 font-medium transition-colors">
        Открыть Telegram Bot →
      </a>
    </div>
  </div>
</div>

<script>
function openQuickEvent() {
  // Open event creation modal with today's date pre-filled
  const today = new Date().toISOString().split('T')[0];
  
  document.getElementById('eventId').value = '';
  document.getElementById('eventTitle').value = '';
  document.getElementById('eventDescription').value = '';
  document.getElementById('eventDate').value = today;
  document.getElementById('eventTime').value = '09:00';
  document.getElementById('eventAllDay').checked = false;
  document.getElementById('eventType').value = 'task';
  document.getElementById('eventPriority').value = 'medium';
  
  document.getElementById('modalTitle').textContent = 'Быстрое событие';
  
  const deleteButton = document.querySelector('[onclick="deleteEvent()"]');
  if (deleteButton) {
    deleteButton.style.display = 'none';
  }
  
  document.getElementById('eventModal').classList.remove('hidden');
}

function openSearch() {
  // Simple search functionality - could be enhanced
  const searchTerm = prompt('Поиск по записям:');
  if (searchTerm && searchTerm.trim()) {
    // Navigate to entries with search parameter
    window.location.href = `/entries?search=${encodeURIComponent(searchTerm)}`;
  }
}
</script>