<!-- Plans Widget -->
<div class="widget-card bg-gradient-to-br from-green-50 to-emerald-50 border border-green-200 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 p-6">
  <div class="widget-header flex items-center justify-between mb-4">
    <h3 class="text-lg font-medium text-gray-900 flex items-center">
      <span class="w-8 h-8 bg-gradient-to-r from-green-400 to-emerald-500 rounded-full mr-3 flex items-center justify-center">
        <span class="text-white text-sm">📋</span>
      </span>
      Планы
    </h3>
    <div class="flex items-center space-x-2">
      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
        <%= @recent_entries.select { |e| e.entry_type == 'plan' }.count %>
      </span>
      <%= link_to entries_plans_path, class: "text-sm text-green-600 hover:text-green-700 font-medium transition-colors" do %>
        Все →
      <% end %>
    </div>
  </div>
  
  <div class="widget-preview space-y-3">
    <% 
      active_plans = @recent_entries.select { |entry| 
        entry.entry_type == 'plan' && entry.parent_entry_id.nil?
      }.first(3)
    %>
    
    <% if active_plans.any? %>
      <% active_plans.each do |plan| %>
        <%
          # Try to find related calendar event
          related_event = @user.calendar_events.joins(:entry).where(entries: { id: plan.id }).first
          is_completed = related_event&.done?
        %>
        <div class="bg-white bg-opacity-70 rounded-lg p-3 border border-green-200 hover:border-green-300 transition-colors cursor-pointer <%= 'opacity-60' if is_completed %>">
          <div class="flex items-start justify-between mb-2">
            <div class="flex items-center space-x-2">
              <input type="checkbox" 
                     class="w-3 h-3 text-green-600 bg-white border-green-300 rounded focus:ring-green-500"
                     <%= 'checked' if is_completed %>
                     disabled>
              <span class="text-xs text-green-600 font-medium">
                <%= plan.created_at.in_time_zone(@user.timezone).strftime('%d.%m') %>
              </span>
            </div>
            <span class="text-xs text-gray-500">
              <%= plan.priority || 5 %>/10
            </span>
          </div>
          <p class="text-sm text-gray-800 leading-relaxed <%= 'line-through' if is_completed %>">
            <%= plan.content.truncate(80) %>
          </p>
          <div class="mt-2 flex items-center justify-between">
            <% if plan.metadata && plan.metadata['scheduled_date'] %>
              <span class="inline-block px-2 py-1 text-xs bg-green-100 text-green-700 rounded-md">
                📅 <%= Date.parse(plan.metadata['scheduled_date']).strftime('%d.%m') %>
              </span>
            <% else %>
              <span class="inline-block px-2 py-1 text-xs bg-gray-100 text-gray-600 rounded-md">
                Без даты
              </span>
            <% end %>
            <% if is_completed %>
              <span class="text-xs text-green-600 font-medium">✅ Выполнено</span>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <!-- Empty State -->
      <div class="text-center py-6">
        <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <span class="text-green-500 text-xl">📋</span>
        </div>
        <p class="text-sm text-gray-500">Нет планов</p>
        <p class="text-xs text-gray-400 mt-1">Поставьте себе цели</p>
      </div>
    <% end %>
  </div>
  
  <div class="widget-footer pt-4 border-t border-green-200 mt-4">
    <div class="flex items-center justify-between">
      <%
        completed_plans = @recent_entries.select { |entry| 
          entry.entry_type == 'plan' && 
          @user.calendar_events.joins(:entry).where(entries: { id: entry.id }, done: true).exists?
        }.count
        total_plans = @recent_entries.select { |e| e.entry_type == 'plan' }.count
      %>
      <span class="text-xs text-gray-500">
        Выполнено: <%= completed_plans %>/<%= total_plans %>
      </span>
      <button class="text-xs bg-green-100 hover:bg-green-200 text-green-800 px-3 py-1 rounded-full transition-colors">
        + Создать план
      </button>
    </div>
  </div>
</div>