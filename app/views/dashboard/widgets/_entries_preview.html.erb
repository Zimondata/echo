<!-- Entries Widget -->
<div class="widget-card bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-200 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 p-6">
  <div class="widget-header flex items-center justify-between mb-4">
    <h3 class="text-lg font-medium text-gray-900 flex items-center">
      <span class="w-8 h-8 bg-gradient-to-r from-blue-400 to-indigo-500 rounded-full mr-3 flex items-center justify-center">
        <span class="text-white text-sm">📝</span>
      </span>
      Записи дня
    </h3>
    <div class="flex items-center space-x-2">
      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
        <%= @recent_entries.select { |e| 
          ['diary'].include?(e.entry_type) && 
          e.created_at.in_time_zone(@user.timezone).to_date == Date.current 
        }.count %>
      </span>
      <%= link_to entries_diary_path, class: "text-sm text-blue-600 hover:text-blue-700 font-medium transition-colors" do %>
        Все →
      <% end %>
    </div>
  </div>
  
  <div class="widget-preview space-y-3">
    <% 
      today_entries = @recent_entries.select { |entry| 
        entry.entry_type == 'diary' && 
        entry.created_at.in_time_zone(@user.timezone).to_date == Date.current &&
        entry.parent_entry_id.nil?
      }.first(3)
    %>
    
    <% if today_entries.any? %>
      <% today_entries.each do |entry| %>
        <div class="bg-white bg-opacity-70 rounded-lg p-3 border border-blue-200 hover:border-blue-300 transition-colors cursor-pointer">
          <div class="flex items-start justify-between mb-2">
            <span class="text-xs text-blue-600 font-medium">
              <%= entry.created_at.in_time_zone(@user.timezone).strftime('%H:%M') %>
            </span>
            <% if entry.audio_file_id.present? %>
              <span class="text-xs text-blue-500">🎤</span>
            <% end %>
          </div>
          <p class="text-sm text-gray-800 leading-relaxed">
            <%= entry.content.truncate(80) %>
          </p>
          <% if entry.child_entries.any? %>
            <div class="mt-2">
              <span class="inline-block px-2 py-1 text-xs bg-purple-100 text-purple-700 rounded-md">
                +<%= entry.child_entries.count %> размышлений
              </span>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <!-- Empty State -->
      <div class="text-center py-6">
        <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <span class="text-blue-500 text-xl">📝</span>
        </div>
        <p class="text-sm text-gray-500">Нет записей сегодня</p>
        <p class="text-xs text-gray-400 mt-1">Поделитесь своими мыслями</p>
      </div>
    <% end %>
  </div>
  
  <div class="widget-footer pt-4 border-t border-blue-200 mt-4">
    <div class="flex items-center justify-between">
      <span class="text-xs text-gray-500">
        Всего записей: <%= @recent_entries.select { |e| e.entry_type == 'diary' }.count %>
      </span>
      <button class="text-xs bg-blue-100 hover:bg-blue-200 text-blue-800 px-3 py-1 rounded-full transition-colors">
        + Записать мысль
      </button>
    </div>
  </div>
</div>