<!-- Ideas Widget -->
<div class="widget-card bg-gradient-to-br from-yellow-50 to-amber-50 border border-yellow-200 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 p-6">
  <div class="widget-header flex items-center justify-between mb-4">
    <h3 class="text-lg font-medium text-gray-900 flex items-center">
      <span class="w-8 h-8 bg-gradient-to-r from-yellow-400 to-amber-500 rounded-full mr-3 flex items-center justify-center">
        <span class="text-white text-sm">💡</span>
      </span>
      Идеи
    </h3>
    <div class="flex items-center space-x-2">
      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
        <%= @recent_entries.select { |e| e.entry_type == 'idea' }.count %>
      </span>
      <%= link_to entries_ideas_path, class: "text-sm text-amber-600 hover:text-amber-700 font-medium transition-colors" do %>
        Все →
      <% end %>
    </div>
  </div>
  
  <div class="widget-preview space-y-3">
    <% 
      recent_ideas = @recent_entries.select { |entry| 
        entry.entry_type == 'idea' && entry.parent_entry_id.nil?
      }.first(3)
    %>
    
    <% if recent_ideas.any? %>
      <% recent_ideas.each do |idea| %>
        <div class="bg-white bg-opacity-70 rounded-lg p-3 border border-yellow-200 hover:border-yellow-300 transition-colors cursor-pointer">
          <div class="flex items-start justify-between mb-2">
            <span class="text-xs text-yellow-600 font-medium">
              <%= idea.created_at.in_time_zone(@user.timezone).strftime('%d.%m %H:%M') %>
            </span>
            <span class="text-xs text-gray-500">
              <%= idea.priority || 5 %>/10
            </span>
          </div>
          <p class="text-sm text-gray-800 leading-relaxed">
            <%= idea.content.truncate(80) %>
          </p>
          <% if idea.tags.present? %>
            <div class="mt-2 flex flex-wrap gap-1">
              <% idea.tags.first(2).each do |tag| %>
                <span class="inline-block px-2 py-1 text-xs bg-yellow-100 text-yellow-700 rounded-md">
                  #<%= tag %>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <!-- Empty State -->
      <div class="text-center py-6">
        <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <span class="text-yellow-500 text-xl">💡</span>
        </div>
        <p class="text-sm text-gray-500">Пока нет идей</p>
        <p class="text-xs text-gray-400 mt-1">Отправьте боту свои мысли</p>
      </div>
    <% end %>
  </div>
  
  <div class="widget-footer pt-4 border-t border-yellow-200 mt-4">
    <div class="flex items-center justify-between">
      <span class="text-xs text-gray-500">
        Последняя: <%= recent_ideas.any? ? recent_ideas.first.created_at.in_time_zone(@user.timezone).strftime('%d.%m') : 'нет' %>
      </span>
      <button class="text-xs bg-yellow-100 hover:bg-yellow-200 text-yellow-800 px-3 py-1 rounded-full transition-colors">
        + Добавить идею
      </button>
    </div>
  </div>
</div>