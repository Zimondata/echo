<!-- Related Content Widget -->
<div class="widget-card bg-gradient-to-br from-teal-50 to-cyan-50 border border-teal-200 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 p-6">
  <div class="widget-header flex items-center justify-between mb-4">
    <h3 class="text-lg font-medium text-gray-900 flex items-center">
      <span class="w-8 h-8 bg-gradient-to-r from-teal-400 to-cyan-500 rounded-full mr-3 flex items-center justify-center">
        <span class="text-white text-sm">🔗</span>
      </span>
      Связи
    </h3>
    <span class="text-xs text-teal-600 font-medium">Похожие темы</span>
  </div>
  
  <div class="widget-preview space-y-3">
    <%
      # Get recent entries with content for similarity analysis
      recent_with_content = @recent_entries.select { |e| 
        e.content.present? && e.content.length > 20 
      }.first(10)
      
      # Simple keyword-based similarity (could be enhanced with vector search)
      related_pairs = []
      
      if recent_with_content.any?
        # Extract common words and find related entries
        recent_with_content.each_with_index do |entry, i|
          words = entry.content.downcase.split(/\W+/).select { |w| w.length > 3 }
          
          recent_with_content[(i+1)..-1].each do |other_entry|
            other_words = other_entry.content.downcase.split(/\W+/).select { |w| w.length > 3 }
            common_words = words & other_words
            
            if common_words.length >= 2
              related_pairs << {
                entry1: entry,
                entry2: other_entry,
                common_words: common_words.first(3)
              }
            end
          end
        end
      end
      
      # Show most recent related pairs
      related_pairs = related_pairs.first(2)
    %>
    
    <% if related_pairs.any? %>
      <% related_pairs.each do |pair| %>
        <div class="bg-white bg-opacity-70 rounded-lg p-3 border border-teal-200">
          <!-- First Entry -->
          <div class="mb-3 pb-2 border-b border-teal-100">
            <div class="flex items-center justify-between mb-1">
              <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-teal-100 text-teal-800">
                <%= pair[:entry1].entry_type.humanize %>
              </span>
              <span class="text-xs text-gray-500">
                <%= pair[:entry1].created_at.in_time_zone(@user.timezone).strftime('%d.%m') %>
              </span>
            </div>
            <p class="text-sm text-gray-800 leading-relaxed">
              <%= pair[:entry1].content.truncate(50) %>
            </p>
          </div>
          
          <!-- Common Keywords -->
          <div class="flex items-center justify-center mb-2">
            <div class="flex flex-wrap gap-1">
              <% pair[:common_words].each do |word| %>
                <span class="inline-block px-2 py-1 text-xs bg-teal-200 text-teal-800 rounded-full">
                  <%= word %>
                </span>
              <% end %>
            </div>
          </div>
          
          <!-- Second Entry -->
          <div class="pt-2">
            <div class="flex items-center justify-between mb-1">
              <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-cyan-100 text-cyan-800">
                <%= pair[:entry2].entry_type.humanize %>
              </span>
              <span class="text-xs text-gray-500">
                <%= pair[:entry2].created_at.in_time_zone(@user.timezone).strftime('%d.%m') %>
              </span>
            </div>
            <p class="text-sm text-gray-800 leading-relaxed">
              <%= pair[:entry2].content.truncate(50) %>
            </p>
          </div>
        </div>
      <% end %>
    <% else %>
      <!-- Empty State -->
      <div class="text-center py-6">
        <div class="w-12 h-12 bg-teal-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <span class="text-teal-500 text-xl">🔍</span>
        </div>
        <p class="text-sm text-gray-500">Пока нет связей</p>
        <p class="text-xs text-gray-400 mt-1">Добавьте больше записей</p>
      </div>
    <% end %>
  </div>
  
  <div class="widget-footer pt-4 border-t border-teal-200 mt-4">
    <div class="flex items-center justify-between">
      <span class="text-xs text-gray-500">
        Проанализировано: <%= recent_with_content.count %> записей
      </span>
      <% if related_pairs.any? %>
        <span class="text-xs text-teal-600 font-medium">
          <%= related_pairs.count %> связей найдено
        </span>
      <% else %>
        <span class="text-xs text-gray-400">
          Нужно больше данных
        </span>
      <% end %>
    </div>
  </div>
</div>