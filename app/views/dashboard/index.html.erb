                              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                              </svg>
                              <span class="text-xs font-medium"><%= event.time_display(@user.timezone) %></span>
                            </div>
                          <% end %>

                          <button onclick="deleteTask(<%= event.id %>)" class="delete-btn p-1.5 hover:bg-red-50 rounded-lg transition-all duration-200 opacity-0 group-hover:opacity-100">
                            <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                          </button>
                        </div>
                      </div>
                    </div>
                  <% end %>

                  <% if @today_events.nil? || @today_events.empty? %>
                    <div class="text-center py-12">
                      <div class="p-4 rounded-full bg-gray-100 inline-block mb-4">
                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                      </div>
                      <p class="text-gray-600 font-medium">Нет задач на сегодня</p>
                      <p class="text-gray-500 text-sm mt-1">Добавьте новую задачу выше</p>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Tomorrow Section -->
          <div class="glass-card rounded-2xl shadow-lg border border-gray-200/50 gradient-blue">
            <div class="p-6">
              <div class="flex items-center justify-between mb-5">
                <div class="flex items-center gap-3">
                  <div class="p-2.5 rounded-xl bg-blue-500 shadow-sm">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                    </svg>
                  </div>
                  <h2 class="text-xl font-semibold text-gray-900">Завтра</h2>
                </div>
                <div class="flex items-center gap-2">
                  <div class="badge-pulse px-3 py-1.5 bg-blue-500/10 border border-blue-500/20 text-blue-700 text-sm rounded-lg font-medium">
                    <%= @tomorrow_events&.count || 0 %>
                  </div>
                </div>
              </div>

              <div class="relative">
                <!-- ScrollArea with professional styling -->
                <div class="space-y-2.5 pr-2" id="tomorrowTasks" style="max-height: 500px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: rgba(59, 130, 246, 0.3) transparent;">
                  <%
                    # Sort events by category but display without group headers
                    sorted_tomorrow = @tomorrow_events.sort_by { |e|
                      category_order = ['work', 'health', 'personal', 'ideas', 'projects']
                      category_order.index(e.life_category || 'work') || 999
                    }
                  %>

                  <% sorted_tomorrow.each do |event| %>
                    <%
                      category_key = event.life_category.presence || 'work'
                      category_info = CalendarEvent::LIFE_CATEGORIES[category_key] || CalendarEvent::LIFE_CATEGORIES['work']
                    %>
                    <div class="task-item glass-card p-4 rounded-xl border border-gray-200/50 hover:border-blue-300/50 <%= 'completed-task' if event.done? %> group"
                         data-event-id="<%= event.id %>"
                         style="--category-color: <%= category_info[:color] %>">
                      <div class="flex items-center gap-3">
                        <!-- Checkbox -->
                        <label class="flex items-center cursor-pointer flex-shrink-0">
                          <input
                            type="checkbox"
                            class="w-5 h-5 text-violet-600 rounded-full border-2 focus:ring-2 focus:ring-violet-500 focus:ring-offset-0 cursor-pointer transition-all hover:scale-110 active:scale-95"
                            <%= 'checked' if event.done? %>
                            onchange="toggleTask(<%= event.id %>)"
                          >
                        </label>

                        <!-- Emoji Badge -->
                        <% unless event.title.start_with?(category_info[:icon]) %>
                          <div class="flex-shrink-0 w-8 h-8 rounded-lg glass-card border border-gray-200/50 flex items-center justify-center text-base category-badge">
                            <%= category_info[:icon] %>
                          </div>
                        <% end %>

                        <!-- Task Content -->
                        <div class="flex-1 min-w-0">
                          <p class="task-text text-sm font-medium text-gray-900">
                            <%= event.title.gsub(category_info[:icon], '').strip %>
                          </p>
                        </div>

                        <!-- Time & Delete -->
                        <div class="flex items-center gap-2 flex-shrink-0">
                          <% if event.start_time && !event.all_day? %>
                            <div class="flex items-center gap-1.5 text-gray-600">
                              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                              </svg>
                              <span class="text-xs font-medium"><%= event.time_display(@user.timezone) %></span>
                            </div>
                          <% end %>

                          <button onclick="deleteTask(<%= event.id %>)" class="delete-btn p-1.5 hover:bg-red-50 rounded-lg transition-all duration-200 opacity-0 group-hover:opacity-100">
                            <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                          </button>
                        </div>
                      </div>
                    </div>
                  <% end %>

                  <% if @tomorrow_events.nil? || @tomorrow_events.empty? %>
                    <div class="text-center py-12">
                      <div class="p-4 rounded-full bg-gray-100 inline-block mb-4">
                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                      </div>
                      <p class="text-gray-600 font-medium">Нет задач на завтра</p>
                      <p class="text-gray-500 text-sm mt-1">Добавьте новую задачу выше</p>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Recent Entries -->
        <div class="glass-card rounded-2xl p-6 shadow-lg border border-gray-200/50">
          <h3 class="text-lg font-semibold text-gray-900 mb-5 flex items-center gap-2">
            <svg class="w-5 h-5 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Последние записи
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <% (@recent_entries || []).first(4).each do |entry| %>
              <%
                type_colors = {
                  'diary' => { bg: 'bg-blue-500/10', text: 'text-blue-600', border: 'border-blue-500/20' },
                  'idea' => { bg: 'bg-amber-500/10', text: 'text-amber-600', border: 'border-amber-500/20' },
                  'plan' => { bg: 'bg-green-500/10', text: 'text-green-600', border: 'border-green-500/20' }
                }
                colors = type_colors[entry.entry_type] || { bg: 'bg-gray-500/10', text: 'text-gray-600', border: 'border-gray-500/20' }
              %>
              <div class="entry-card glass-card p-4 rounded-xl border <%= colors[:border] %> hover:border-violet-300/50 hover:shadow-md cursor-pointer transition-all duration-200 group">
                <div class="flex items-start gap-3">
                  <div class="p-2.5 rounded-xl <%= colors[:bg] %> <%= colors[:text] %> group-hover:scale-110 transition-transform">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <% if entry.entry_type == 'idea' %>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                      <% elsif entry.entry_type == 'diary' %>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                      <% else %>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                      <% end %>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="font-medium text-sm text-gray-900 line-clamp-2 mb-1">
                      <%= entry.content.truncate(60) %>
                    </p>
                    <p class="text-xs text-gray-600">
                      <%= time_ago_in_words(entry.created_at) %> назад
                    </p>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
let activeSection = 'today';
let expandedSections = {
  today: false,
  tomorrow: false
};

function toggleExpand(section) {
  const container = section === 'today' ? document.getElementById('todayTasks') : document.getElementById('tomorrowTasks');
  const button = section === 'today' ? document.getElementById('expandTodayBtn') : document.getElementById('expandTomorrowBtn');
  
  expandedSections[section] = !expandedSections[section];
  
  if (expandedSections[section]) {
    // Expand
    container.style.maxHeight = '600px';
    button.innerHTML = `
      <svg class="w-5 h-5 text-${section === 'today' ? 'amber' : 'blue'}-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
      </svg>
    `;
    button.title = 'Свернуть';
  } else {
    // Collapse
    container.style.maxHeight = '320px';
    button.innerHTML = `
      <svg class="w-5 h-5 text-${section === 'today' ? 'amber' : 'blue'}-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    `;
    button.title = 'Развернуть';
  }
}

function setActiveSection(section) {
  activeSection = section;
  const todayBtn = document.getElementById('todayBtn');
  const tomorrowBtn = document.getElementById('tomorrowBtn');

  if (section === 'today') {
    todayBtn.className = 'flex-1 px-3 py-2 rounded-lg bg-gradient-to-r from-violet-600 to-purple-600 text-white text-xs font-medium shadow-sm hover:shadow-md transition-all';
    tomorrowBtn.className = 'flex-1 px-3 py-2 rounded-lg glass-card text-gray-700 text-xs font-medium hover:bg-gray-50 transition-all';
  } else {
    tomorrowBtn.className = 'flex-1 px-3 py-2 rounded-lg bg-gradient-to-r from-violet-600 to-purple-600 text-white text-xs font-medium shadow-sm hover:shadow-md transition-all';
    todayBtn.className = 'flex-1 px-3 py-2 rounded-lg glass-card text-gray-700 text-xs font-medium hover:bg-gray-50 transition-all';
  }
}

function toggleCategoryCompact(categoryId) {
  const tasksContainer = document.getElementById(categoryId);
  const arrow = document.getElementById('arrow-' + categoryId);

  if (tasksContainer.classList.contains('collapsed')) {
    tasksContainer.classList.remove('collapsed');
    arrow.classList.remove('collapsed');
  } else {
    tasksContainer.classList.add('collapsed');
    arrow.classList.add('collapsed');
  }
}

function toggleTask(eventId) {
  fetch(`/api/v1/calendar_events/${eventId}/toggle`, {
    method: 'PATCH',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
    }
  })
  .then(response => response.json())
  .then(data => {
    const taskElement = document.querySelector(`[data-event-id="${eventId}"]`);
    if (data.data.completed) {
      taskElement.classList.add('completed-task');
    } else {
      taskElement.classList.remove('completed-task');
    }
    
    // Update completed tasks counter
    updateCompletedTasksCounter();
  });
}

function updateCompletedTasksCounter() {
  // Count completed tasks in today's section
  const todayTasks = document.querySelectorAll('#todayTasks input[type="checkbox"]:checked');
  const completedCount = todayTasks.length;
  
  // Update the counter display
  document.getElementById('completedTodayCount').textContent = completedCount;
}

function updateTasksCounter() {
  // Count total tasks in today's section
  const todayTasks = document.querySelectorAll('#todayTasks input[type="checkbox"]');
  const totalCount = todayTasks.length;
  
  // Update the counter display
  document.getElementById('totalEntriesCount').textContent = totalCount;
}

function deleteTask(eventId) {
  if (!confirm('Удалить задачу?')) return;
  
  fetch(`/api/v1/calendar_events/${eventId}`, {
    method: 'DELETE',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
    }
  })
  .then(response => response.json())
  .then(data => {
    const taskElement = document.querySelector(`[data-event-id="${eventId}"]`);
    taskElement.style.animation = 'fadeOut 0.3s ease';
    setTimeout(() => {
      taskElement.remove();
      // Update counters after task is removed
      updateCompletedTasksCounter();
      updateTasksCounter();
    }, 300);
  });
}

function addTask() {
  const input = document.getElementById('newTaskInput');
  const taskText = input.value.trim();
  
  if (!taskText) return;
  
  // Get user's local date
  const now = new Date();
  let targetDate = new Date();
  
  if (activeSection === 'today') {
    // Today - set to start of today in user's timezone
    targetDate.setHours(9, 0, 0, 0);
  } else {
    // Tomorrow - add one day and set to 9 AM
    targetDate.setDate(targetDate.getDate() + 1);
    targetDate.setHours(9, 0, 0, 0);
  }
  
  fetch('/api/v1/calendar_events', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
    },
    body: JSON.stringify({
      title: taskText,
      start_time: targetDate.toISOString(),
      all_day: true
    })
  })
  .then(response => response.json())
  .then(data => {
    location.reload();
  });
  
  input.value = '';
}

function loadDayEvents(date) {
  // Update selected day visual
  document.querySelectorAll('.calendar-day').forEach(day => {
    day.classList.remove('selected');
  });
  event.currentTarget.classList.add('selected');
  
  // Update stats date label
  const selectedDate = new Date(date);
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  selectedDate.setHours(0, 0, 0, 0);
  
  let dateLabel = '';
  if (selectedDate.getTime() === today.getTime()) {
    dateLabel = 'сегодня';
  } else if (selectedDate.getTime() === today.getTime() + 86400000) {
    dateLabel = 'завтра';
  } else {
    const options = { day: 'numeric', month: 'long' };
    dateLabel = selectedDate.toLocaleDateString('ru-RU', options);
  }
  document.getElementById('statsDateLabel').textContent = dateLabel;
  
  // Load stats for selected day
  updateDayStats(date);
  
  // Load nutrition stats for selected day
  loadNutritionStats(date);
  
  // Load events for selected day
  fetch(`/api/v1/calendar_events?start_date=${date}&end_date=${date}`, {
    headers: {
      'Content-Type': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    updateTasksDisplay(data.data || []);
  });
}

function updateDayStats(date) {
  const selectedDate = new Date(date);
  const startOfDay = new Date(selectedDate);
  startOfDay.setHours(0, 0, 0, 0);
  const endOfDay = new Date(selectedDate);
  endOfDay.setHours(23, 59, 59, 999);
  
  // Get stats for the selected day
  Promise.all([
    fetch(`/api/v1/entries?created_after=${startOfDay.toISOString()}&created_before=${endOfDay.toISOString()}`),
    fetch(`/api/v1/calendar_events?start_date=${date}&end_date=${date}`)
  ])
  .then(responses => Promise.all(responses.map(r => r.json())))
  .then(([entriesData, eventsData]) => {
    // Update stats
    console.log('Entries data:', entriesData);
    console.log('Events data:', eventsData);
    const entries = entriesData.data || [];
    const events = eventsData.data || [];
    
    console.log('Events count:', events.length);
    document.getElementById('totalEntriesCount').textContent = events.length;
    document.getElementById('completedTodayCount').textContent = events.filter(e => e.done).length;
    
    // Load nutrition data for today
    loadNutritionStats(selectedDate || new Date().toISOString().split('T')[0]);
  })
  .catch(error => {
    console.error('Error fetching stats:', error);
    // Set default values if API fails
    document.getElementById('totalEntriesCount').textContent = '0';
    document.getElementById('completedTodayCount').textContent = '0';
  });
}

function updateTasksDisplay(events) {
  const todayContainer = document.getElementById('todayTasks');
  const tomorrowContainer = document.getElementById('tomorrowTasks');
  
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  
  const todayEvents = events.filter(e => {
    const eventDate = new Date(e.start_time);
    eventDate.setHours(0, 0, 0, 0);
    return eventDate.getTime() === today.getTime();
  });
  
  const tomorrowEvents = events.filter(e => {
    const eventDate = new Date(e.start_time);
    eventDate.setHours(0, 0, 0, 0);
    return eventDate.getTime() === today.getTime() + 86400000;
  });
  
  // Update today section
  if (todayContainer) {
    renderEvents(todayContainer, todayEvents);
  }
  
  // Update tomorrow section
  if (tomorrowContainer) {
    renderEvents(tomorrowContainer, tomorrowEvents);
  }
}

function renderEvents(container, events) {
  if (events.length === 0) {
    container.innerHTML = `
      <div class="text-center py-8 text-gray-500">
        <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p>Нет задач</p>
      </div>
    `;
  } else {
    container.innerHTML = events.map(event => `
      <div class="task-item glass-card p-3 rounded-lg ${event.done ? 'completed-task' : ''}" data-event-id="${event.id}">
        <div class="flex items-start gap-3">
          <label class="flex items-center cursor-pointer">
            <input 
              type="checkbox" 
              class="w-4 h-4 text-violet-600 rounded focus:ring-violet-500"
              ${event.done ? 'checked' : ''}
              onchange="toggleTask(${event.id})"
            >
          </label>
          <div class="flex-1">
            <p class="task-text text-gray-800 font-medium">
              ${event.title}
            </p>
            ${event.start_time && !event.all_day ? `
              <p class="text-xs text-gray-500 mt-1 flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                ${new Date(event.start_time).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' })}
              </p>
            ` : ''}
          </div>
          <button onclick="deleteTask(${event.id})" class="delete-btn p-1 hover:bg-red-50 rounded">
            <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        </div>
      </div>
    `).join('');
  }
}

function quickAddReminder() {
  const reminder = prompt('О чём напомнить? (например: "вечером почитать книгу")');
  if (!reminder) return;
  
  // Parse natural language time
  let remindTime = new Date();
  const lowerText = reminder.toLowerCase();
  const now = new Date();
  
  if (lowerText.includes('утром')) {
    remindTime.setHours(9, 0, 0, 0);
    // If morning time already passed today, set for tomorrow
    if (remindTime <= now) {
      remindTime.setDate(remindTime.getDate() + 1);
    }
  } else if (lowerText.includes('вечером')) {
    remindTime.setHours(20, 0, 0, 0);
    // If evening time already passed today, set for tomorrow
    if (remindTime <= now) {
      remindTime.setDate(remindTime.getDate() + 1);
    }
  } else if (lowerText.includes('днем')) {
    remindTime.setHours(14, 0, 0, 0);
    // If afternoon time already passed today, set for tomorrow
    if (remindTime <= now) {
      remindTime.setDate(remindTime.getDate() + 1);
    }
  } else {
    // Default: 1 hour from now
    remindTime.setTime(now.getTime() + 60 * 60 * 1000);
  }
  
  fetch('/api/v1/reminders', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
    },
    body: JSON.stringify({
      message: reminder,
      remind_at: remindTime.toISOString()
    })
  })
  .then(() => {
    alert('Напоминание создано!');
    location.reload();
  });
}

