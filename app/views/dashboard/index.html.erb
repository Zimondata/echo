<div class="space-y-6">
  <!-- Header -->
  <div class="md:flex md:items-center md:justify-between">
    <div class="flex-1 min-w-0">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
        Dashboard
      </h2>
      <p class="mt-1 text-sm text-gray-500">
        Добро пожаловать, <%= @user.full_name %>! 👋
      </p>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
    <!-- Total Entries -->
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Всего записей</dt>
              <dd class="text-3xl font-semibold text-gray-900"><%= @total_entries %></dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <!-- Diary -->
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Дневник</dt>
              <dd class="text-3xl font-semibold text-blue-600"><%= @diary_count %></dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <!-- Ideas -->
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Идеи</dt>
              <dd class="text-3xl font-semibold text-yellow-600"><%= @ideas_count %></dd>
            </dl>
          </div>
        </div>
      </div>
    </div>

    <!-- Plans -->
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-5">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg class="h-6 w-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
            </svg>
          </div>
          <div class="ml-5 w-0 flex-1">
            <dl>
              <dt class="text-sm font-medium text-gray-500 truncate">Планы</dt>
              <dd class="text-3xl font-semibold text-green-600"><%= @plans_count %></dd>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Entries & Upcoming Events -->
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <!-- Recent Entries -->
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">
          Последние записи
        </h3>
        <div class="flow-root">
          <ul role="list" class="-my-5 divide-y divide-gray-200">
            <% @recent_entries.each do |entry| %>
              <li class="py-4">
                <div class="flex items-center space-x-4">
                  <div class="flex-shrink-0">
                    <span class="inline-flex items-center justify-center h-10 w-10 rounded-full <%= entry.entry_type == 'diary' ? 'bg-blue-100 text-blue-600' : entry.entry_type == 'idea' ? 'bg-yellow-100 text-yellow-600' : 'bg-green-100 text-green-600' %>">
                      <%= entry.entry_type == 'diary' ? '📔' : entry.entry_type == 'idea' ? '💡' : '📋' %>
                    </span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-900 truncate">
                      <%= entry.content.truncate(60) %>
                    </p>
                    <p class="text-sm text-gray-500">
                      <%= entry.created_at.strftime("%d %b, %H:%M") %>
                    </p>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
        <%= link_to "Смотреть все →", entries_path, class: "mt-4 text-sm font-medium text-indigo-600 hover:text-indigo-500 inline-block" %>
      </div>
    </div>

    <!-- Upcoming Events -->
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">
          Ближайшие события
        </h3>
        <% if @upcoming_events.any? %>
          <div class="flow-root">
            <ul role="list" class="-my-5 divide-y divide-gray-200">
              <% @upcoming_events.each do |event| %>
                <li class="py-4">
                  <div class="flex items-center space-x-4">
                    <div class="flex-shrink-0">
                      <span class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-indigo-100 text-indigo-600">
                        📅
                      </span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-medium text-gray-900 truncate">
                        <%= event.title %>
                      </p>
                      <p class="text-sm text-gray-500">
                        <%= event.start_time.strftime("%d %b, %H:%M") %>
                      </p>
                    </div>
                  </div>
                </li>
              <% end %>
            </ul>
          </div>
        <% else %>
          <p class="text-sm text-gray-500">Нет запланированных событий</p>
        <% end %>
        <%= link_to "Смотреть календарь →", calendar_events_path, class: "mt-4 text-sm font-medium text-indigo-600 hover:text-indigo-500 inline-block" %>
      </div>
    </div>
  </div>

  <!-- Active Reminders -->
  <% if @pending_reminders.any? %>
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">
          Активные напоминания
        </h3>
        <div class="flow-root">
          <ul role="list" class="-my-5 divide-y divide-gray-200">
            <% @pending_reminders.each do |reminder| %>
              <li class="py-4">
                <div class="flex items-center space-x-4">
                  <div class="flex-shrink-0">
                    <span class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-red-100 text-red-600">
                      🔔
                    </span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-900">
                      <%= reminder.message %>
                    </p>
                    <p class="text-sm text-gray-500">
                      <%= reminder.remind_at.strftime("%d %b, %H:%M") %>
                    </p>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
        <%= link_to "Смотреть все →", reminders_path, class: "mt-4 text-sm font-medium text-indigo-600 hover:text-indigo-500 inline-block" %>
      </div>
    </div>
  <% end %>
</div>
