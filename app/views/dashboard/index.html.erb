function loadNutritionStats(date) {
  fetch(`/dashboard/nutrition_stats?date=${date}`, {
    headers: {
      'Content-Type': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    const calories = Math.round(data.calories || 0);
    const protein = Math.round(data.protein || 0);
    const fat = Math.round(data.fat || 0); 
    const carbs = Math.round(data.carbs || 0);
    
    document.getElementById('todayCaloriesCount').textContent = calories;
    document.getElementById('todayProtein').textContent = protein;
    document.getElementById('todayFat').textContent = fat;
    document.getElementById('todayCarbs').textContent = carbs;
  })
  .catch(error => {
    console.log('Nutrition stats not available:', error);
    document.getElementById('todayCaloriesCount').textContent = '0';
    document.getElementById('todayProtein').textContent = '0';
    document.getElementById('todayFat').textContent = '0';
    document.getElementById('todayCarbs').textContent = '0';
  });
}

