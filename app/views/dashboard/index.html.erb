<style>
  /* Glassmorphism and animations */
  .glass-card {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 8px 32px 0 rgba(139, 92, 246, 0.1);
  }
  
  .dark .glass-card {
    background: rgba(17, 24, 39, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  .gradient-bg {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }
  
  .gradient-amber {
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.1) 0%, rgba(245, 158, 11, 0.1) 100%);
  }
  
  .gradient-blue {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(99, 102, 241, 0.1) 100%);
  }
  
  .task-item {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .task-item:hover {
    transform: translateX(4px);
    background: rgba(139, 92, 246, 0.05);
  }
  
  .completed-task {
    opacity: 0.6;
  }
  
  .completed-task .task-text {
    text-decoration: line-through;
    color: #9ca3af;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in {
    animation: fadeIn 0.5s ease;
  }
  
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .stagger-animation > * {
    animation: slideUp 0.5s ease both;
  }
  
  .stagger-animation > *:nth-child(1) { animation-delay: 0.1s; }
  .stagger-animation > *:nth-child(2) { animation-delay: 0.2s; }
  .stagger-animation > *:nth-child(3) { animation-delay: 0.3s; }
  .stagger-animation > *:nth-child(4) { animation-delay: 0.4s; }
  
  .badge-pulse {
    animation: pulse 2s infinite;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
  
  .hover-scale {
    transition: transform 0.2s ease;
  }
  
  .hover-scale:hover {
    transform: scale(1.05);
  }
  
  .calendar-day {
    transition: all 0.2s ease;
    cursor: pointer;
  }
  
  .calendar-day:hover {
    background: rgba(139, 92, 246, 0.1);
    transform: scale(1.1);
  }
  
  .calendar-day.selected {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }
  
  .quick-action-btn {
    transition: all 0.3s ease;
  }
  
  .quick-action-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(139, 92, 246, 0.2);
  }
  
  .entry-card {
    transition: all 0.3s ease;
  }
  
  .entry-card:hover {
    transform: translateY(-4px);
    border-color: rgba(139, 92, 246, 0.3);
  }
  
  .delete-btn {
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  
  .task-item:hover .delete-btn {
    opacity: 1;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-violet-50 via-purple-50 to-pink-50">
  <div class="max-w-7xl mx-auto p-4 md:p-8">
    
    <!-- Header with Stats -->
    <div class="mb-8 animate-fade-in">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
          <h1 class="text-4xl font-bold bg-gradient-to-r from-violet-600 to-purple-600 bg-clip-text text-transparent">
            Личный Ассистент
          </h1>
          <p class="text-gray-600 mt-2">Управляйте своим днем эффективно</p>
        </div>
        <div class="mt-4 md:mt-0 flex items-center gap-3">
          <div class="glass-card px-4 py-2 rounded-full">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span class="text-lg font-medium text-gray-800">
                <%= Time.current.in_time_zone(@user&.timezone || 'UTC').strftime("%d %B, %A") %>
              </span>
            </div>
          </div>
          <% if logged_in? %>
            <%= link_to logout_path, method: :delete, data: { turbo_method: :delete }, class: "glass-card px-4 py-2 rounded-full hover:bg-red-50 transition" do %>
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
                <span class="text-sm font-medium text-gray-700">Выход</span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
      
      <!-- Quick Stats -->
      <div class="mb-4">
        <h3 class="text-sm font-medium text-gray-500 mb-2">
          Статистика за <span id="statsDateLabel" class="text-gray-700 font-semibold">сегодня</span>
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="glass-card p-4 rounded-xl text-center hover-scale">
            <div id="totalEntriesCount" class="text-2xl font-bold text-violet-600">0</div>
            <div class="text-sm text-gray-600 mt-1">Записей за день</div>
          </div>
          <div class="glass-card p-4 rounded-xl text-center hover-scale">
            <div id="todayTasksCount" class="text-2xl font-bold text-amber-600">0</div>
            <div class="text-sm text-gray-600 mt-1">Задач на день</div>
          </div>
          <div class="glass-card p-4 rounded-xl text-center hover-scale">
            <div id="completedTodayCount" class="text-2xl font-bold text-green-600">0</div>
            <div class="text-sm text-gray-600 mt-1">Выполнено</div>
          </div>
          <div class="glass-card p-4 rounded-xl text-center hover-scale">
            <div id="todayIdeasCount" class="text-2xl font-bold text-blue-600">0</div>
            <div class="text-sm text-gray-600 mt-1">Новых идей</div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 stagger-animation">
      
      <!-- Calendar Widget -->
      <div class="lg:col-span-1">
        <div class="glass-card rounded-2xl p-6 shadow-xl">
          <div class="flex items-center gap-2 mb-4">
            <div class="p-2 rounded-lg gradient-bg">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-gray-800">Календарь</h2>
          </div>
          
          <!-- Mini Calendar -->
          <div class="space-y-3">
            <div class="grid grid-cols-7 gap-2 text-center text-xs text-gray-500 font-medium">
              <div>Пн</div>
              <div>Вт</div>
              <div>Ср</div>
              <div>Чт</div>
              <div>Пт</div>
              <div>Сб</div>
              <div>Вс</div>
            </div>
            <div class="grid grid-cols-7 gap-2" id="calendarDays">
              <% 
                today = Date.current
                start_date = today.beginning_of_week
                (0..6).each do |i| 
                  date = start_date + i.days
                  is_today = date == today
                  events_count = @user&.calendar_events&.where('DATE(start_time) = ?', date)&.count || 0
              %>
                <div 
                  class="calendar-day relative p-3 rounded-lg text-center <%= 'selected' if is_today %>"
                  onclick="loadDayEvents('<%= date.iso8601 %>')"
                  data-date="<%= date.iso8601 %>"
                >
                  <div class="text-sm font-medium <%= is_today ? 'text-white' : 'text-gray-700' %>">
                    <%= date.day %>
                  </div>
                  <% if events_count > 0 %>
                    <div class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs rounded-full flex items-center justify-center">
                      <%= events_count %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        
        <!-- Quick Actions -->
        <div class="glass-card rounded-2xl p-6 shadow-xl mt-6">
          <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            Быстрые действия
          </h3>
          <div class="space-y-3">
            <button onclick="quickAddReminder()" class="quick-action-btn w-full glass-card px-4 py-3 rounded-xl flex items-center gap-3 hover:bg-violet-50 transition">
              <div class="p-2 rounded-lg bg-amber-100">
                <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                </svg>
              </div>
              <span class="text-gray-700">Создать напоминание</span>
            </button>
            
            <button onclick="startVoiceNote()" class="quick-action-btn w-full glass-card px-4 py-3 rounded-xl flex items-center gap-3 hover:bg-blue-50 transition">
              <div class="p-2 rounded-lg bg-blue-100">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path>
                </svg>
              </div>
              <span class="text-gray-700">Голосовая заметка</span>
            </button>
            
            <button onclick="quickAddIdea()" class="quick-action-btn w-full glass-card px-4 py-3 rounded-xl flex items-center gap-3 hover:bg-green-50 transition">
              <div class="p-2 rounded-lg bg-green-100">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
              </div>
              <span class="text-gray-700">Новая заметка</span>
            </button>
          </div>
        </div>
      </div>
      
      <!-- Today and Tomorrow Tasks -->
      <div class="lg:col-span-2 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Today Section -->
          <div class="glass-card rounded-2xl shadow-xl gradient-amber">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                  <div class="p-2 rounded-lg bg-amber-500">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707"></path>
                    </svg>
                  </div>
                  <h2 class="text-xl font-semibold text-gray-800">Сегодня</h2>
                </div>
                <div class="flex items-center gap-2">
                  <div class="badge-pulse px-3 py-1 bg-amber-100 text-amber-700 text-sm rounded-full">
                    <%= @today_events&.count || 0 %> задач
                  </div>
                  <button 
                    onclick="toggleExpand('today')" 
                    id="expandTodayBtn"
                    class="p-1 hover:bg-amber-100 rounded-lg transition"
                    title="Развернуть"
                  >
                    <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </button>
                </div>
              </div>
              
              <div class="relative">
                <div class="space-y-3 transition-all duration-300 pr-2" id="todayTasks" style="max-height: 320px; overflow-y: auto;">
                  <% (@today_events || []).each do |event| %>
                  <div class="task-item glass-card p-3 rounded-lg <%= 'completed-task' if event.done? %>" data-event-id="<%= event.id %>">
                    <div class="flex items-start gap-3">
                      <label class="flex items-center cursor-pointer">
                        <input 
                          type="checkbox" 
                          class="w-4 h-4 text-violet-600 rounded focus:ring-violet-500"
                          <%= 'checked' if event.done? %>
                          onchange="toggleTask(<%= event.id %>)"
                        >
                      </label>
                      <div class="flex-1">
                        <p class="task-text text-gray-800 font-medium">
                          <%= event.title %>
                        </p>
                        <% if event.start_time %>
                          <p class="text-xs text-gray-500 mt-1 flex items-center gap-1">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <%= event.time_display(@user.timezone) %>
                          </p>
                        <% end %>
                      </div>
                      <button onclick="deleteTask(<%= event.id %>)" class="delete-btn p-1 hover:bg-red-50 rounded">
                        <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                      </button>
                    </div>
                  </div>
                <% end %>
                
                  <% if @today_events.nil? || @today_events.empty? %>
                    <div class="text-center py-8 text-gray-500">
                      <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      <p>Нет задач на сегодня</p>
                    </div>
                  <% end %>
                </div>
                <% if @today_events && @today_events.count > 3 %>
                  <div class="text-center mt-3 text-sm text-gray-500">
                    Показано <%= [3, @today_events.count].min %> из <%= @today_events.count %> задач
                  </div>
                <% end %>
              </div>
            </div>
          </div>
          
          <!-- Tomorrow Section -->
          <div class="glass-card rounded-2xl shadow-xl gradient-blue">
            <div class="p-6">
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                  <div class="p-2 rounded-lg bg-blue-500">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                    </svg>
                  </div>
                  <h2 class="text-xl font-semibold text-gray-800">Завтра</h2>
                </div>
                <div class="flex items-center gap-2">
                  <div class="badge-pulse px-3 py-1 bg-blue-100 text-blue-700 text-sm rounded-full">
                    <%= @tomorrow_events&.count || 0 %> задач
                  </div>
                  <button 
                    onclick="toggleExpand('tomorrow')" 
                    id="expandTomorrowBtn"
                    class="p-1 hover:bg-blue-100 rounded-lg transition"
                    title="Развернуть"
                  >
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </button>
                </div>
              </div>
              
              <div class="relative">
                <div class="space-y-3 transition-all duration-300 pr-2" id="tomorrowTasks" style="max-height: 320px; overflow-y: auto;">
                  <% (@tomorrow_events || []).each do |event| %>
                  <div class="task-item glass-card p-3 rounded-lg <%= 'completed-task' if event.done? %>" data-event-id="<%= event.id %>">
                    <div class="flex items-start gap-3">
                      <label class="flex items-center cursor-pointer">
                        <input 
                          type="checkbox" 
                          class="w-4 h-4 text-violet-600 rounded focus:ring-violet-500"
                          <%= 'checked' if event.done? %>
                          onchange="toggleTask(<%= event.id %>)"
                        >
                      </label>
                      <div class="flex-1">
                        <p class="task-text text-gray-800 font-medium">
                          <%= event.title %>
                        </p>
                        <% if event.start_time %>
                          <p class="text-xs text-gray-500 mt-1 flex items-center gap-1">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <%= event.time_display(@user.timezone) %>
                          </p>
                        <% end %>
                      </div>
                      <button onclick="deleteTask(<%= event.id %>)" class="delete-btn p-1 hover:bg-red-50 rounded">
                        <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                      </button>
                    </div>
                  </div>
                <% end %>
                
                  <% if @tomorrow_events.nil? || @tomorrow_events.empty? %>
                    <div class="text-center py-8 text-gray-500">
                      <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                      </svg>
                      <p>Нет задач на завтра</p>
                    </div>
                  <% end %>
                </div>
                <% if @tomorrow_events && @tomorrow_events.count > 3 %>
                  <div class="text-center mt-3 text-sm text-gray-500">
                    Показано <%= [3, @tomorrow_events.count].min %> из <%= @tomorrow_events.count %> задач
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Add Task Section -->
        <div class="glass-card rounded-2xl p-6 shadow-xl">
          <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
            Добавить задачу
          </h3>
          <div class="flex gap-3">
            <div class="flex gap-2">
              <button 
                id="todayBtn"
                onclick="setActiveSection('today')" 
                class="px-4 py-2 rounded-lg bg-violet-600 text-white font-medium transition"
              >
                Сегодня
              </button>
              <button 
                id="tomorrowBtn"
                onclick="setActiveSection('tomorrow')" 
                class="px-4 py-2 rounded-lg bg-white text-gray-700 font-medium hover:bg-gray-50 transition"
              >
                Завтра
              </button>
            </div>
            <input 
              type="text" 
              id="newTaskInput"
              placeholder="Новая задача..." 
              class="flex-1 px-4 py-2 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-violet-500"
              onkeypress="if(event.key === 'Enter') addTask()"
            >
            <button 
              onclick="addTask()"
              class="px-6 py-2 rounded-lg bg-gradient-to-r from-violet-600 to-purple-600 text-white font-medium hover:shadow-lg transition"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
              </svg>
            </button>
          </div>
        </div>
        
        <!-- Recent Entries -->
        <div class="glass-card rounded-2xl p-6 shadow-xl">
          <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Последние записи
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <% (@recent_entries || []).first(4).each do |entry| %>
              <%
                type_colors = {
                  'diary' => 'blue',
                  'idea' => 'amber', 
                  'plan' => 'green'
                }
                color = type_colors[entry.entry_type] || 'gray'
              %>
              <div class="entry-card glass-card p-4 rounded-xl border border-gray-200 hover:border-violet-300 cursor-pointer">
                <div class="flex items-start gap-3">
                  <div class="p-2 rounded-lg bg-<%= color %>-100">
                    <svg class="w-4 h-4 text-<%= color %>-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <% if entry.entry_type == 'idea' %>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                      <% elsif entry.entry_type == 'diary' %>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                      <% else %>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                      <% end %>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="font-medium text-sm text-gray-800 truncate">
                      <%= entry.content.truncate(50) %>
                    </p>
                    <p class="text-xs text-gray-500 mt-1">
                      <%= time_ago_in_words(entry.created_at) %> назад
                    </p>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
let activeSection = 'today';
let expandedSections = {
  today: false,
  tomorrow: false
};

function toggleExpand(section) {
  const container = section === 'today' ? document.getElementById('todayTasks') : document.getElementById('tomorrowTasks');
  const button = section === 'today' ? document.getElementById('expandTodayBtn') : document.getElementById('expandTomorrowBtn');
  
  expandedSections[section] = !expandedSections[section];
  
  if (expandedSections[section]) {
    // Expand
    container.style.maxHeight = '600px';
    button.innerHTML = `
      <svg class="w-5 h-5 text-${section === 'today' ? 'amber' : 'blue'}-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path>
      </svg>
    `;
    button.title = 'Свернуть';
  } else {
    // Collapse
    container.style.maxHeight = '320px';
    button.innerHTML = `
      <svg class="w-5 h-5 text-${section === 'today' ? 'amber' : 'blue'}-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    `;
    button.title = 'Развернуть';
  }
}

function setActiveSection(section) {
  activeSection = section;
  const todayBtn = document.getElementById('todayBtn');
  const tomorrowBtn = document.getElementById('tomorrowBtn');
  
  if (section === 'today') {
    todayBtn.className = 'px-4 py-2 rounded-lg bg-violet-600 text-white font-medium transition';
    tomorrowBtn.className = 'px-4 py-2 rounded-lg bg-white text-gray-700 font-medium hover:bg-gray-50 transition';
  } else {
    tomorrowBtn.className = 'px-4 py-2 rounded-lg bg-violet-600 text-white font-medium transition';
    todayBtn.className = 'px-4 py-2 rounded-lg bg-white text-gray-700 font-medium hover:bg-gray-50 transition';
  }
}

function toggleTask(eventId) {
  fetch(`/api/v1/calendar_events/${eventId}/toggle`, {
    method: 'PATCH',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
    }
  })
  .then(response => response.json())
  .then(data => {
    const taskElement = document.querySelector(`[data-event-id="${eventId}"]`);
    if (data.data.completed) {
      taskElement.classList.add('completed-task');
    } else {
      taskElement.classList.remove('completed-task');
    }
  });
}

function deleteTask(eventId) {
  if (!confirm('Удалить задачу?')) return;
  
  fetch(`/api/v1/calendar_events/${eventId}`, {
    method: 'DELETE',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
    }
  })
  .then(response => response.json())
  .then(data => {
    const taskElement = document.querySelector(`[data-event-id="${eventId}"]`);
    taskElement.style.animation = 'fadeOut 0.3s ease';
    setTimeout(() => taskElement.remove(), 300);
  });
}

function addTask() {
  const input = document.getElementById('newTaskInput');
  const taskText = input.value.trim();
  
  if (!taskText) return;
  
  // Get user's local date
  const now = new Date();
  let targetDate = new Date();
  
  if (activeSection === 'today') {
    // Today - set to start of today in user's timezone
    targetDate.setHours(9, 0, 0, 0);
  } else {
    // Tomorrow - add one day and set to 9 AM
    targetDate.setDate(targetDate.getDate() + 1);
    targetDate.setHours(9, 0, 0, 0);
  }
  
  fetch('/api/v1/calendar_events', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
    },
    body: JSON.stringify({
      title: taskText,
      start_time: targetDate.toISOString(),
      all_day: true
    })
  })
  .then(response => response.json())
  .then(data => {
    location.reload();
  });
  
  input.value = '';
}

function loadDayEvents(date) {
  // Update selected day visual
  document.querySelectorAll('.calendar-day').forEach(day => {
    day.classList.remove('selected');
  });
  event.currentTarget.classList.add('selected');
  
  // Update stats date label
  const selectedDate = new Date(date);
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  selectedDate.setHours(0, 0, 0, 0);
  
  let dateLabel = '';
  if (selectedDate.getTime() === today.getTime()) {
    dateLabel = 'сегодня';
  } else if (selectedDate.getTime() === today.getTime() + 86400000) {
    dateLabel = 'завтра';
  } else {
    const options = { day: 'numeric', month: 'long' };
    dateLabel = selectedDate.toLocaleDateString('ru-RU', options);
  }
  document.getElementById('statsDateLabel').textContent = dateLabel;
  
  // Load stats for selected day
  updateDayStats(date);
  
  // Load events for selected day
  fetch(`/api/v1/calendar_events?start_date=${date}&end_date=${date}`, {
    headers: {
      'Content-Type': 'application/json'
    }
  })
  .then(response => response.json())
  .then(data => {
    updateTasksDisplay(data.data || []);
  });
}

function updateDayStats(date) {
  const selectedDate = new Date(date);
  const startOfDay = new Date(selectedDate);
  startOfDay.setHours(0, 0, 0, 0);
  const endOfDay = new Date(selectedDate);
  endOfDay.setHours(23, 59, 59, 999);
  
  // Get stats for the selected day
  Promise.all([
    fetch(`/api/v1/entries?created_after=${startOfDay.toISOString()}&created_before=${endOfDay.toISOString()}`),
    fetch(`/api/v1/calendar_events?start_date=${date}&end_date=${date}`)
  ])
  .then(responses => Promise.all(responses.map(r => r.json())))
  .then(([entriesData, eventsData]) => {
    // Update stats
    const entries = entriesData.data || [];
    const events = eventsData.data || [];
    
    document.getElementById('totalEntriesCount').textContent = entries.length;
    document.getElementById('todayTasksCount').textContent = events.length;
    document.getElementById('completedTodayCount').textContent = events.filter(e => e.done).length;
    document.getElementById('todayIdeasCount').textContent = entries.filter(e => e.entry_type === 'idea').length;
  });
}

function updateTasksDisplay(events) {
  const todayContainer = document.getElementById('todayTasks');
  const tomorrowContainer = document.getElementById('tomorrowTasks');
  
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  
  const todayEvents = events.filter(e => {
    const eventDate = new Date(e.start_time);
    eventDate.setHours(0, 0, 0, 0);
    return eventDate.getTime() === today.getTime();
  });
  
  const tomorrowEvents = events.filter(e => {
    const eventDate = new Date(e.start_time);
    eventDate.setHours(0, 0, 0, 0);
    return eventDate.getTime() === today.getTime() + 86400000;
  });
  
  // Update today section
  if (todayContainer) {
    renderEvents(todayContainer, todayEvents);
  }
  
  // Update tomorrow section
  if (tomorrowContainer) {
    renderEvents(tomorrowContainer, tomorrowEvents);
  }
}

function renderEvents(container, events) {
  if (events.length === 0) {
    container.innerHTML = `
      <div class="text-center py-8 text-gray-500">
        <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p>Нет задач</p>
      </div>
    `;
  } else {
    container.innerHTML = events.map(event => `
      <div class="task-item glass-card p-3 rounded-lg ${event.done ? 'completed-task' : ''}" data-event-id="${event.id}">
        <div class="flex items-start gap-3">
          <label class="flex items-center cursor-pointer">
            <input 
              type="checkbox" 
              class="w-4 h-4 text-violet-600 rounded focus:ring-violet-500"
              ${event.done ? 'checked' : ''}
              onchange="toggleTask(${event.id})"
            >
          </label>
          <div class="flex-1">
            <p class="task-text text-gray-800 font-medium">
              ${event.title}
            </p>
            ${event.start_time && !event.all_day ? `
              <p class="text-xs text-gray-500 mt-1 flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                ${new Date(event.start_time).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' })}
              </p>
            ` : ''}
          </div>
          <button onclick="deleteTask(${event.id})" class="delete-btn p-1 hover:bg-red-50 rounded">
            <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        </div>
      </div>
    `).join('');
  }
}

function quickAddReminder() {
  const reminder = prompt('О чём напомнить? (например: "вечером почитать книгу")');
  if (!reminder) return;
  
  // Parse natural language time
  let remindTime = new Date();
  const lowerText = reminder.toLowerCase();
  const now = new Date();
  
  if (lowerText.includes('утром')) {
    remindTime.setHours(9, 0, 0, 0);
    // If morning time already passed today, set for tomorrow
    if (remindTime <= now) {
      remindTime.setDate(remindTime.getDate() + 1);
    }
  } else if (lowerText.includes('вечером')) {
    remindTime.setHours(20, 0, 0, 0);
    // If evening time already passed today, set for tomorrow
    if (remindTime <= now) {
      remindTime.setDate(remindTime.getDate() + 1);
    }
  } else if (lowerText.includes('днем')) {
    remindTime.setHours(14, 0, 0, 0);
    // If afternoon time already passed today, set for tomorrow
    if (remindTime <= now) {
      remindTime.setDate(remindTime.getDate() + 1);
    }
  } else {
    // Default: 1 hour from now
    remindTime.setTime(now.getTime() + 60 * 60 * 1000);
  }
  
  fetch('/api/v1/reminders', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
    },
    body: JSON.stringify({
      message: reminder,
      remind_at: remindTime.toISOString()
    })
  })
  .then(() => {
    alert('Напоминание создано!');
    location.reload();
  });
}

function startVoiceNote() {
  alert('Функция голосовых заметок будет доступна в следующей версии');
}

function quickAddIdea() {
  const idea = prompt('Опишите вашу идею:');
  if (!idea) return;
  
  fetch('/api/v1/entries', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
    },
    body: JSON.stringify({
      content: idea,
      entry_type: 'idea'
    })
  })
  .then(() => {
    alert('Идея сохранена!');
    location.reload();
  });
}

// Add fade out animation
const style = document.createElement('style');
style.textContent = `
  @keyframes fadeOut {
    from { opacity: 1; transform: translateX(0); }
    to { opacity: 0; transform: translateX(-20px); }
  }
`;
document.head.appendChild(style);

// Initialize stats on page load
document.addEventListener('DOMContentLoaded', () => {
  const today = new Date().toISOString().split('T')[0];
  updateDayStats(today);
});
</script>