<div class="space-y-6">
  <!-- Header -->
  <div class="md:flex md:items-center md:justify-between">
    <div class="flex-1 min-w-0">
      <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
        Dashboard
      </h2>
      <p class="mt-1 text-sm text-gray-500">
        Добро пожаловать, <%= @user.full_name %>! 👋
      </p>
    </div>
  </div>

  <!-- Timeline with Alerts -->
  <div class="bg-white shadow rounded-lg mb-6">
    <div class="px-6 py-5">
      <!-- Time markers across full width -->
      <div class="grid grid-cols-7 gap-2 mb-2">
        <% 7.times do %>
          <div class="flex justify-between items-center text-xs text-gray-400 font-mono px-2">
            <% [6, 10, 14, 18, 22].each do |hour| %>
              <span><%= sprintf('%02d', hour) %></span>
            <% end %>
          </div>
        <% end %>
      </div>
      
      <!-- Timeline with Reminders for each day -->
      <div class="grid grid-cols-7 gap-2">
        <% 
          start_of_week = Date.current.beginning_of_week(:monday)
          (0..6).each do |day_offset|
            current_day = start_of_week + day_offset.days
            is_today = current_day == Date.current
        %>
          <div class="relative h-6 bg-gray-100 rounded-full">
            <%
              # Get reminders for this specific day
              day_start = current_day.beginning_of_day.in_time_zone(@user.timezone)
              day_end = current_day.end_of_day.in_time_zone(@user.timezone)
              current_time = Time.current.in_time_zone(@user.timezone)
              
              # Only future reminders
              day_reminders = @user.reminders.where(remind_at: day_start..day_end)
                                             .where('remind_at > ?', current_time)
              
              day_reminders.each do |reminder|
                reminder_time = reminder.remind_at.in_time_zone(@user.timezone)
                # Position from 6:00 to 22:00 (16 hours span)
                if reminder_time.hour >= 6 && reminder_time.hour <= 22
                  hour_offset = reminder_time.hour - 6  # 0-16 range
                  minute_offset = reminder_time.min / 60.0
                  position = ((hour_offset + minute_offset) / 16.0 * 100).round(2)
                  
                  # Only blue for future reminders
                  bell_color = 'text-blue-500'
            %>
              <div class="absolute top-0 transform -translate-x-1/2 -translate-y-1 cursor-pointer hover:scale-125 transition-transform"
                   style="left: <%= position %>%;"
                   onclick="showReminderModal('<%= reminder.id %>', '<%= reminder.message.gsub("'", "\\'") %>', '<%= reminder_time.strftime('%H:%M') %>', event); event.stopPropagation();"
                   title="🔔 <%= reminder.message %> (<%= reminder_time.strftime('%H:%M') %>)">
                <span class="<%= bell_color %> text-lg hover:drop-shadow-md">🔔</span>
              </div>
            <% 
                end
              end
            %>
            
            <!-- Current time indicator (only for today) -->
            <% if current_day == Date.current %>
              <%
                current_hour = Time.current.in_time_zone(@user.timezone)
                if current_hour.hour >= 6 && current_hour.hour <= 22
                  current_offset = current_hour.hour - 6
                  current_minute_offset = current_hour.min / 60.0
                  current_position = ((current_offset + current_minute_offset) / 16.0 * 100).round(2)
              %>
                <div class="absolute top-0 bottom-0 w-1 bg-red-400 rounded-full transform -translate-x-1/2"
                     style="left: <%= current_position %>%;"
                     title="Сейчас: <%= current_hour.strftime('%H:%M') %>">
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Week Calendar -->
  <div class="bg-white shadow rounded-lg">
    <div class="px-6 py-5">
      <!-- Week Calendar Grid -->
      <div class="grid grid-cols-7 gap-1 mb-4" style="min-height: 580px;">
        <!-- Week Headers -->
        <% 
          weekdays = [
            { short: 'ПН', full: 'Понедельник' },
            { short: 'ВТ', full: 'Вторник' }, 
            { short: 'СР', full: 'Среда' },
            { short: 'ЧТ', full: 'Четверг' },
            { short: 'ПТ', full: 'Пятница' },
            { short: 'СБ', full: 'Суббота' },
            { short: 'ВС', full: 'Воскресенье' }
          ]
          
          start_of_week = Date.current.beginning_of_week(:monday)
          weekdays.each_with_index do |day, index|
            current_day = start_of_week + index.days
            is_today = current_day == Date.current
        %>
          <div class="text-center pb-1">
            <div class="flex items-center justify-center space-x-1">
              <span class="text-xs font-medium text-gray-500 uppercase tracking-wide"><%= day[:short] %></span>
              <span class="text-lg font-bold <%= is_today ? 'text-indigo-600' : 'text-gray-900' %>"><%= current_day.day %></span>
            </div>
            <% if is_today %>
              <div class="text-xs text-indigo-600 font-medium">
                Сегодня
              </div>
            <% end %>
          </div>
        <% end %>
        
        <!-- Week Days with Events -->
        <% 
          (0..6).each do |day_offset|
            current_day = start_of_week + day_offset.days
            day_events = @week_events.select { |event| 
              event.start_time.in_time_zone(@user.timezone).to_date == current_day 
            }
        %>
          <div class="min-h-[520px] p-3 <%= day_offset.even? ? 'bg-gradient-to-br from-white via-gray-50 to-gray-100' : 'bg-gradient-to-br from-slate-50 via-white to-slate-100' %> rounded-2xl border border-gray-200 drop-zone shadow-sm hover:shadow-md transition-all duration-300"
               data-date="<%= current_day.iso8601 %>"
               ondrop="handleEventDrop(event)"
               ondragover="handleDragOver(event)"
               ondragenter="handleDragEnter(event)"
               ondragleave="handleDragLeave(event)"
               onclick="openDayModal('<%= current_day.iso8601 %>', '<%= current_day.strftime('%d %B') %>', event)">
            
            
            <!-- Events for this day -->
            <div class="space-y-1">
              <% 
                # Показываем ВСЕ события дня - и прошлые, и будущие
                upcoming_events = day_events
              %>
              
              <%
                # Разделяем события на временные и плавающие
                timed_events = upcoming_events.select { |e| !e.all_day? }.sort_by(&:start_time)
                floating_events = upcoming_events.select { |e| e.all_day? }
              %>
              
              <!-- Floating Plans (без времени) -->
              <% if floating_events.any? %>
                <div class="mb-2">
                  <div class="text-xs text-gray-600 font-bold mb-3 flex items-center bg-white bg-opacity-60 backdrop-blur-sm px-3 py-2 rounded-xl shadow-sm border border-white border-opacity-50">
                    <span class="w-2 h-2 bg-gradient-to-r from-blue-400 to-purple-500 rounded-full mr-2 animate-pulse"></span>
                    📋 Планы
                  </div>
                  <% floating_events.each do |event| %>
                    <%
                      # Определяем цвета по типу события для планов
                      if event.event_type == 'reminder'
                        float_bg_color = "rgba(239, 68, 68, 0.15) 0%, rgba(239, 68, 68, 0.05) 100%"
                        float_border_color = "rgba(239, 68, 68, 0.25)"
                        float_shadow_color = "rgba(239, 68, 68, 0.15)"
                        float_icon = "🔔"
                      else
                        float_bg_color = "rgba(168, 85, 247, 0.15) 0%, rgba(168, 85, 247, 0.05) 100%"
                        float_border_color = "rgba(168, 85, 247, 0.25)"
                        float_shadow_color = "rgba(168, 85, 247, 0.15)"
                        float_icon = "📋"
                      end
                    %>
                    <div class="event-card text-xs p-3 rounded-xl border mb-2 transition-all duration-300 hover:shadow-xl hover:scale-[1.03] cursor-move draggable-event transform hover:-translate-y-1 relative backdrop-blur-sm" 
                         style="background: linear-gradient(135deg, <%= float_bg_color %>); border: 1px solid <%= float_border_color %>; box-shadow: 0 8px 32px <%= float_shadow_color %>; backdrop-filter: blur(10px);"
                         draggable="true"
                         ondragstart="handleEventDragStart(event)"
                         ondragend="handleEventDragEnd(event)"
                         onclick="editEvent('<%= event.id %>', event); event.stopPropagation();"
                         data-event-id="<%= event.id %>"
                         data-event-title="<%= event.title.gsub('"', '&quot;') %>"
                         data-event-description="<%= event.description.to_s.gsub('"', '&quot;') %>"
                         data-event-start="<%= event.start_time.iso8601 %>"
                         data-event-end="<%= event.end_time&.iso8601 %>"
                         data-event-type="<%= event.event_type %>"
                         data-event-priority="<%= event.priority %>"
                         data-event-all-day="<%= event.all_day? %>"
                         data-event-color="<%= event.display_color %>">
                      
                      <!-- Type icon in corner -->
                      <div class="absolute top-1 right-1 text-xs opacity-80 bg-white bg-opacity-60 backdrop-blur-sm p-1 rounded-full shadow-sm"><%= float_icon %></div>
                      
                      <div class="flex items-start space-x-2">
                        <input type="checkbox" 
                               class="w-4 h-4 text-emerald-600 bg-white bg-opacity-90 border-2 border-gray-300 border-opacity-60 rounded-lg focus:ring-emerald-500 focus:ring-2 cursor-pointer transition-all duration-200 hover:border-emerald-400 hover:bg-opacity-100 flex-shrink-0 mt-0.5 backdrop-blur-sm shadow-sm"
                               <%= 'checked' if event.done? %>
                               onchange="toggleEventDone('<%= event.id %>', this.checked)"
                               onclick="event.stopPropagation();">
                        <div class="font-semibold text-gray-800 text-xs <%= 'line-through text-gray-500' if event.done? %> flex-1 leading-relaxed pr-10">
                          <%= event.title %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>

              <!-- Timed Events (с временем) -->
              <% if timed_events.any? %>
                
                <% timed_events.first(8).each do |event| %>
                  <%
                    # Определяем цвета по типу события
                    if event.event_type == 'reminder'
                      bg_color = "rgba(239, 68, 68, 0.15) 0%, rgba(239, 68, 68, 0.05) 100%"
                      border_color = "rgba(239, 68, 68, 0.25)"
                      shadow_color = "rgba(239, 68, 68, 0.15)"
                      icon = "🔔"
                    else
                      bg_color = "rgba(59, 130, 246, 0.15) 0%, rgba(59, 130, 246, 0.05) 100%"
                      border_color = "rgba(59, 130, 246, 0.25)"
                      shadow_color = "rgba(59, 130, 246, 0.15)"
                      icon = "⏰"
                    end
                  %>
                  <div class="event-card text-xs p-3 rounded-xl border mb-2 transition-all duration-300 hover:shadow-xl hover:scale-[1.03] cursor-move draggable-event relative transform hover:-translate-y-1 backdrop-blur-sm" 
                       style="background: linear-gradient(135deg, <%= bg_color %>); border: 1px solid <%= border_color %>; box-shadow: 0 8px 32px <%= shadow_color %>; backdrop-filter: blur(10px);"
                       draggable="true"
                       ondragstart="handleEventDragStart(event)"
                       ondragend="handleEventDragEnd(event)"
                       onclick="editEvent('<%= event.id %>', event); event.stopPropagation();"
                       data-event-id="<%= event.id %>"
                       data-event-title="<%= event.title.gsub('"', '&quot;') %>"
                       data-event-description="<%= event.description.to_s.gsub('"', '&quot;') %>"
                       data-event-start="<%= event.start_time.iso8601 %>"
                       data-event-end="<%= event.end_time&.iso8601 %>"
                       data-event-type="<%= event.event_type %>"
                       data-event-priority="<%= event.priority %>"
                       data-event-all-day="<%= event.all_day? %>"
                       data-event-color="<%= event.display_color %>">
                    
                    <!-- Type icon in left corner -->
                    <div class="absolute top-1 left-1 text-xs opacity-80 bg-white bg-opacity-60 backdrop-blur-sm p-1 rounded-full shadow-sm">
                      <%= icon %>
                    </div>
                    
                    <!-- Compact time only -->
                    <div class="absolute top-1 right-1 text-[10px] font-mono text-gray-600 bg-white bg-opacity-80 backdrop-blur-sm px-2 py-1 rounded-full font-bold leading-none shadow-sm border border-white border-opacity-50">
                      <%= event.start_time.in_time_zone(@user.timezone).strftime('%H:%M') %>
                    </div>
                    
                    <div class="pt-3">
                      <div class="flex items-start space-x-2">
                        <input type="checkbox" 
                               class="w-4 h-4 text-emerald-600 bg-white bg-opacity-90 border-2 border-gray-300 border-opacity-60 rounded-lg focus:ring-emerald-500 focus:ring-2 cursor-pointer transition-all duration-200 hover:border-emerald-400 hover:bg-opacity-100 flex-shrink-0 mt-0.5 backdrop-blur-sm shadow-sm"
                               <%= 'checked' if event.done? %>
                               onchange="toggleEventDone('<%= event.id %>', this.checked)"
                               onclick="event.stopPropagation();">
                        <div class="font-semibold text-xs text-gray-800 <%= 'line-through text-gray-500' if event.done? %> flex-1 leading-relaxed pr-14">
                          <%= event.title %>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
              
              <!-- Empty state -->
              <% if upcoming_events.empty? %>
                <div class="text-xs text-gray-400 text-center py-2 italic">
                  Нет событий
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Notes Section -->
  <div class="bg-white shadow rounded-lg mb-6">
    <div class="px-6 py-5">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg leading-6 font-medium text-gray-900 flex items-center">
          <span class="w-6 h-6 bg-gradient-to-r from-purple-400 to-pink-400 rounded-full mr-3 flex items-center justify-center">
            <span class="text-white text-sm">📝</span>
          </span>
          Заметки дня
        </h3>
        <div class="flex items-center space-x-4">
          <span class="text-sm text-gray-500">Идеи и размышления</span>
          <%= link_to ideas_entries_path, class: "text-sm text-indigo-600 hover:text-indigo-500 font-medium" do %>
            Все идеи →
          <% end %>
        </div>
      </div>
      
      <!-- Notes Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% 
          today_notes = @recent_entries.select { |entry| 
            ['idea', 'diary'].include?(entry.entry_type) && 
            entry.created_at.in_time_zone(@user.timezone).to_date == Date.current &&
            entry.parent_entry_id.nil?  # Only show parent entries or standalone
          }
        %>
        
        <% if today_notes.any? %>
          <% today_notes.each do |note| %>
            <div class="note-card p-4 rounded-lg border transition-all duration-300 hover:shadow-md cursor-pointer <%= note.entry_type == 'idea' ? 'bg-gradient-to-br from-yellow-50 to-amber-50 border-yellow-200 hover:border-yellow-300' : 'bg-gradient-to-br from-blue-50 to-indigo-50 border-blue-200 hover:border-blue-300' %>">
              <!-- Note Type & Time -->
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center space-x-2">
                  <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium <%= note.entry_type == 'idea' ? 'bg-yellow-100 text-yellow-800' : 'bg-blue-100 text-blue-800' %>">
                    <%= note.entry_type == 'idea' ? '💡 Идея' : '📔 Дневник' %>
                  </span>
                  <% if note.child_entries.any? %>
                    <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-purple-100 text-purple-800">
                      +<%= note.child_entries.count %> размышлений
                    </span>
                  <% end %>
                </div>
                <span class="text-xs text-gray-500">
                  <%= note.created_at.in_time_zone(@user.timezone).strftime('%H:%M') %>
                </span>
              </div>
              
              <!-- Note Content -->
              <p class="text-sm text-gray-800 leading-relaxed">
                <%= note.content.truncate(120) %>
              </p>
              
              <!-- Note Footer -->
              <div class="mt-3 pt-2 border-t border-gray-200">
                <div class="flex items-center justify-between">
                  <span class="text-xs text-gray-400">
                    Приоритет: <%= note.priority || 5 %>/10
                  </span>
                  <div class="flex items-center space-x-1">
                    <% if note.tags.present? %>
                      <% note.tags.first(2).each do |tag| %>
                        <span class="inline-block px-2 py-1 text-xs bg-gray-100 text-gray-600 rounded-md">
                          #<%= tag %>
                        </span>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <!-- Empty State -->
          <div class="col-span-full flex flex-col items-center justify-center py-12 text-center">
            <div class="w-16 h-16 bg-gradient-to-r from-purple-100 to-pink-100 rounded-full flex items-center justify-center mb-4">
              <span class="text-2xl">🌟</span>
            </div>
            <h4 class="text-lg font-medium text-gray-900 mb-2">Пока нет заметок</h4>
            <p class="text-sm text-gray-500 max-w-sm">
              Отправьте боту свои идеи или размышления, чтобы они появились здесь
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Recent Entries & Upcoming Events -->
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <!-- Recent Entries -->
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">
          Последние планы
        </h3>
        <div class="flow-root">
          <ul role="list" class="-my-5 divide-y divide-gray-200">
            <% @recent_entries.select { |e| e.entry_type == 'plan' }.first(5).each do |entry| %>
              <li class="py-4">
                <div class="flex items-center space-x-4">
                  <div class="flex-shrink-0">
                    <span class="inline-flex items-center justify-center h-10 w-10 rounded-full <%= entry.entry_type == 'diary' ? 'bg-blue-100 text-blue-600' : entry.entry_type == 'idea' ? 'bg-yellow-100 text-yellow-600' : 'bg-green-100 text-green-600' %>">
                      <%= entry.entry_type == 'diary' ? '📔' : entry.entry_type == 'idea' ? '💡' : '📋' %>
                    </span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-900 truncate">
                      <%= entry.content.truncate(60) %>
                    </p>
                    <p class="text-sm text-gray-500">
                      <%= entry.created_at.in_time_zone(@user.timezone).strftime('%d.%m.%Y %H:%M') %>
                    </p>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>

    <!-- Upcoming Events -->
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">
          Ближайшие события
        </h3>
        <% if @upcoming_events.any? %>
          <div class="flow-root">
            <ul role="list" class="-my-5 divide-y divide-gray-200">
              <% @upcoming_events.each do |event| %>
                <li class="py-4">
                  <div class="flex items-center space-x-4">
                    <div class="flex-shrink-0">
                      <span class="inline-flex items-center justify-center h-10 w-10 rounded-full bg-indigo-100 text-indigo-600">
                        📅
                      </span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-medium text-gray-900 truncate">
                        <%= event.title %>
                      </p>
                      <p class="text-sm text-gray-500">
                        <%= event.all_day? ? event.start_time.in_time_zone(@user.timezone).strftime('%d.%m.%Y') : event.start_time.in_time_zone(@user.timezone).strftime('%d.%m.%Y %H:%M') %>
                      </p>
                    </div>
                  </div>
                </li>
              <% end %>
            </ul>
          </div>
        <% else %>
          <p class="text-sm text-gray-500">Нет запланированных событий</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Event Edit Modal -->
<div id="eventModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <div class="flex justify-between items-center pb-3">
      <h3 id="modalTitle" class="text-lg font-semibold text-gray-900">Редактировать событие</h3>
      <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    
    <form id="eventForm" class="space-y-4">
      <input type="hidden" id="eventId" />
      
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Название</label>
        <input type="text" id="eventTitle" 
               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
               required>
      </div>
      
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Описание</label>
        <textarea id="eventDescription" rows="3"
                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"></textarea>
      </div>
      
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Дата</label>
          <input type="date" id="eventDate" 
                 class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
                 required>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Время</label>
          <input type="time" id="eventTime" 
                 class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
      </div>
      
      <div class="flex items-center">
        <input type="checkbox" id="eventAllDay" class="rounded border-gray-300 text-indigo-600">
        <label for="eventAllDay" class="ml-2 text-sm text-gray-700">Весь день</label>
      </div>
      
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Категория</label>
        <select id="eventType" 
                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="meeting">Встреча</option>
          <option value="task">Задача</option>
          <option value="plan">План</option>
          <option value="idea">Идея</option>
          <option value="diary">Дневник</option>
          <option value="reminder">Напоминание</option>
        </select>
      </div>
      
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Приоритет</label>
        <select id="eventPriority" 
                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="low">Низкий</option>
          <option value="medium">Средний</option>
          <option value="high">Высокий</option>
          <option value="urgent">Срочный</option>
        </select>
      </div>
    </form>
    
    <div class="flex justify-between items-center pt-4 border-t border-gray-200 mt-4">
      <button onclick="deleteEvent()" 
              class="bg-red-600 hover:bg-red-700 text-white text-sm font-medium py-2 px-4 rounded-md transition-colors">
        🗑️ Удалить
      </button>
      
      <div class="flex space-x-3">
        <button onclick="closeModal()" 
                class="bg-gray-300 hover:bg-gray-400 text-gray-700 text-sm font-medium py-2 px-4 rounded-md transition-colors">
          Отмена
        </button>
        <button onclick="saveEvent()" 
                class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium py-2 px-4 rounded-md transition-colors">
          💾 Сохранить
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Reminder Modal -->
<div id="reminderModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
  <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
    <div class="mt-3">
      <h3 class="text-lg font-medium text-gray-900 mb-4">Редактировать напоминание</h3>
      
      <input type="hidden" id="reminderId">
      
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-2">Сообщение</label>
        <input type="text" id="reminderMessage" 
               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
      
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-2">Дата</label>
        <input type="date" id="reminderDate" 
               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
      
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">Время</label>
        <input type="time" id="reminderTime" 
               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
      
      <div class="flex justify-between">
        <button onclick="deleteReminder()" 
                class="bg-red-600 hover:bg-red-700 text-white text-sm font-medium py-2 px-4 rounded-md transition-colors">
          🗑️ Удалить
        </button>
        
        <div class="space-x-2">
          <button onclick="closeReminderModal()" 
                  class="bg-gray-300 hover:bg-gray-400 text-gray-700 text-sm font-medium py-2 px-4 rounded-md transition-colors">
            Отмена
          </button>
          <button onclick="saveReminder()" 
                  class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium py-2 px-4 rounded-md transition-colors">
            💾 Сохранить
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .border-l-3 {
    border-left-width: 3px;
  }
  
  .drop-zone.drag-active {
    background-color: #f0f9ff !important;
    border-color: #3b82f6 !important;
    border-style: dashed !important;
  }
  
  .drop-zone.drag-over {
    background-color: #dbeafe !important;
    border-color: #1d4ed8 !important;
    border-width: 2px !important;
    transform: scale(1.02);
  }
  
  .draggable-event:hover::after {
    content: "✨";
    position: absolute;
    top: -8px;
    right: -8px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    animation: pulse 2s infinite;
  }
  
  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }
  
  .event-card:hover {
    transform: translateY(-2px) scale(1.02);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .drop-zone:hover {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.05) 0%, rgba(147, 51, 234, 0.05) 100%) !important;
    border-color: rgba(59, 130, 246, 0.3) !important;
  }
</style>

<script>
// Drag and Drop Variables
let draggedEvent = null;
let draggedEventId = null;

// Drag and Drop Functions
function handleEventDragStart(e) {
  e.stopPropagation();
  
  draggedEvent = e.target.closest('.event-card');
  draggedEventId = draggedEvent.dataset.eventId;
  
  e.dataTransfer.setData('text/plain', draggedEventId);
  e.dataTransfer.effectAllowed = 'move';
  
  draggedEvent.style.opacity = '0.5';
  
  document.querySelectorAll('.drop-zone').forEach(zone => {
    zone.classList.add('drag-active');
  });
}

function handleEventDragEnd(e) {
  if (draggedEvent) {
    draggedEvent.style.opacity = '';
  }
  
  document.querySelectorAll('.drop-zone').forEach(zone => {
    zone.classList.remove('drag-active', 'drag-over');
  });
  
  draggedEvent = null;
  draggedEventId = null;
}

function handleDragOver(e) {
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
}

function handleDragEnter(e) {
  e.preventDefault();
  if (draggedEvent) {
    const dropZone = e.target.closest('.drop-zone');
    if (dropZone) {
      dropZone.classList.add('drag-over');
    }
  }
}

function handleDragLeave(e) {
  const dropZone = e.target.closest('.drop-zone');
  if (!dropZone) return;
  
  if (!e.relatedTarget || !dropZone.contains(e.relatedTarget)) {
    dropZone.classList.remove('drag-over');
  }
}

function handleEventDrop(e) {
  e.preventDefault();
  e.stopPropagation();
  
  const dropZone = e.target.closest('.drop-zone');
  if (!dropZone) return;
  
  const newDate = dropZone.dataset.date;
  
  if (!draggedEventId || !newDate) return;
  
  dropZone.classList.remove('drag-over');
  
  updateEventDate(draggedEventId, newDate)
    .then(() => {
      location.reload();
    })
    .catch(error => {
      alert('Ошибка при перемещении события: ' + error.message);
    });
}

async function updateEventDate(eventId, newDate) {
  const response = await fetch(`/api/calendar/events/${eventId}/move`, {
    method: 'PATCH',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      new_date: newDate
    })
  });
  
  if (!response.ok) {
    const error = await response.json();
    throw new Error(error.message || 'Неизвестная ошибка');
  }
  
  return response.json();
}

// Modal Functions
function openDayModal(date, dateFormatted, clickEvent) {
  if (clickEvent.target.closest('.event-card')) {
    return;
  }
  
  document.getElementById('eventId').value = '';
  document.getElementById('eventTitle').value = '';
  document.getElementById('eventDescription').value = '';
  document.getElementById('eventDate').value = date;
  document.getElementById('eventTime').value = '09:00';
  document.getElementById('eventAllDay').checked = false;
  document.getElementById('eventType').value = 'meeting';
  document.getElementById('eventPriority').value = 'medium';
  
  document.getElementById('modalTitle').textContent = `Новое событие на ${dateFormatted}`;
  
  const deleteButton = document.querySelector('[onclick="deleteEvent()"]');
  if (deleteButton) {
    deleteButton.style.display = 'none';
  }
  
  document.getElementById('eventModal').classList.remove('hidden');
}

function editEvent(eventId, clickEvent) {
  const eventCard = clickEvent.target.closest('[data-event-id]');
  
  const eventData = {
    id: eventCard.dataset.eventId,
    title: eventCard.dataset.eventTitle,
    description: eventCard.dataset.eventDescription,
    start: eventCard.dataset.eventStart,
    end: eventCard.dataset.eventEnd,
    type: eventCard.dataset.eventType,
    priority: eventCard.dataset.eventPriority,
    allDay: eventCard.dataset.eventAllDay === 'true'
  };
  
  document.getElementById('eventId').value = eventData.id;
  document.getElementById('eventTitle').value = eventData.title;
  document.getElementById('eventDescription').value = eventData.description;
  
  const startDate = new Date(eventData.start);
  document.getElementById('eventDate').value = startDate.toISOString().split('T')[0];
  document.getElementById('eventTime').value = startDate.toTimeString().split(' ')[0].substring(0, 5);
  
  document.getElementById('eventAllDay').checked = eventData.allDay;
  document.getElementById('eventType').value = eventData.type;
  document.getElementById('eventPriority').value = eventData.priority;
  
  const deleteButton = document.querySelector('[onclick="deleteEvent()"]');
  if (deleteButton) {
    deleteButton.style.display = 'block';
  }
  
  document.getElementById('eventModal').classList.remove('hidden');
}

function closeModal() {
  document.getElementById('eventModal').classList.add('hidden');
}

function saveEvent() {
  const eventId = document.getElementById('eventId').value;
  const title = document.getElementById('eventTitle').value;
  const description = document.getElementById('eventDescription').value;
  const date = document.getElementById('eventDate').value;
  const time = document.getElementById('eventTime').value;
  const allDay = document.getElementById('eventAllDay').checked;
  const eventType = document.getElementById('eventType').value;
  const priority = document.getElementById('eventPriority').value;
  
  if (!title.trim()) {
    alert('Укажите название события');
    return;
  }
  
  let startTime;
  if (allDay) {
    startTime = new Date(date + 'T00:00:00.000Z').toISOString();
  } else {
    startTime = new Date(date + 'T' + time + ':00.000Z').toISOString();
  }
  
  const eventData = {
    calendar_event: {
      title: title,
      description: description,
      start_time: startTime,
      end_time: null,
      event_type: eventType,
      priority: priority,
      all_day: allDay
    }
  };
  
  const isNewEvent = !eventId || eventId === '';
  const url = isNewEvent ? '/api/calendar/events' : `/api/calendar/events/${eventId}`;
  const method = isNewEvent ? 'POST' : 'PUT';
  
  fetch(url, {
    method: method,
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(eventData)
  })
  .then(response => response.json())
  .then(data => {
    if (data.event) {
      const message = isNewEvent ? 'Событие создано!' : 'Событие обновлено!';
      alert(message);
      closeModal();
      location.reload();
    } else {
      alert('Ошибка: ' + (data.errors || 'Неизвестная ошибка'));
    }
  })
  .catch(error => {
    console.error('Error:', error);
    const errorMessage = isNewEvent ? 'Ошибка при создании события' : 'Ошибка при обновлении события';
    alert(errorMessage);
  });
}

function deleteEvent() {
  const eventId = document.getElementById('eventId').value;
  const title = document.getElementById('eventTitle').value;
  
  if (!confirm(`Удалить событие "${title}"?`)) {
    return;
  }
  
  fetch(`/api/calendar/events/${eventId}`, {
    method: 'DELETE'
  })
  .then(response => response.json())
  .then(data => {
    alert('Событие удалено');
    closeModal();
    location.reload();
  })
  .catch(error => {
    console.error('Error:', error);
    alert('Ошибка при удалении события');
  });
}

// Initialize
document.addEventListener('DOMContentLoaded', function() {
  const allDayCheckbox = document.getElementById('eventAllDay');
  const timeInput = document.getElementById('eventTime');
  
  allDayCheckbox.addEventListener('change', function() {
    timeInput.disabled = this.checked;
    if (this.checked) {
      timeInput.value = '';
    }
  });
  
  document.getElementById('eventModal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeModal();
    }
  });
});

// Event Toggle Done Function
function toggleEventDone(eventId, isChecked) {
  console.log('Toggling event:', eventId, 'to:', isChecked);
  
  fetch(`/api/calendar/events/${eventId}/toggle_done`, {
    method: 'PATCH',
    headers: {
      'Content-Type': 'application/json',
      'X-Requested-With': 'XMLHttpRequest'
    },
    body: JSON.stringify({
      done: isChecked
    })
  })
  .then(response => {
    console.log('Response status:', response.status);
    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }
    return response.json();
  })
  .then(data => {
    console.log('API Response:', data);
    if (data.event) {
      console.log('Event status updated:', data.event.done);
      // Reload page to reflect changes
      location.reload();
    } else {
      console.error('No event in response:', data);
      alert('Ошибка при обновлении статуса: ' + (data.error || 'Неизвестная ошибка'));
      // Find the checkbox and revert its state
      const checkbox = document.querySelector(`input[onchange*="${eventId}"]`);
      if (checkbox) checkbox.checked = !isChecked;
    }
  })
  .catch(error => {
    console.error('Error:', error);
    alert('Ошибка при обновлении статуса: ' + error.message);
    // Find the checkbox and revert its state
    const checkbox = document.querySelector(`input[onchange*="${eventId}"]`);
    if (checkbox) checkbox.checked = !isChecked;
  });
}

// Reminder Modal Functions
function showReminderModal(reminderId, message, time, event) {
  event.stopPropagation();
  
  // Fetch full reminder data
  fetch(`/api/v1/reminders/${reminderId}`)
    .then(response => response.json())
    .then(data => {
      console.log('Reminder API Response:', data);
      if (data.reminder) {
        const reminder = data.reminder;
        // Parse Berlin time correctly
        const remindAt = new Date(reminder.remind_at);
        
        document.getElementById('reminderId').value = reminder.id;
        document.getElementById('reminderMessage').value = reminder.message;
        
        // Format date for input (YYYY-MM-DD)
        const year = remindAt.getFullYear();
        const month = String(remindAt.getMonth() + 1).padStart(2, '0');
        const day = String(remindAt.getDate()).padStart(2, '0');
        document.getElementById('reminderDate').value = `${year}-${month}-${day}`;
        
        // Format time for input (HH:MM)
        const hours = String(remindAt.getHours()).padStart(2, '0');
        const minutes = String(remindAt.getMinutes()).padStart(2, '0');
        document.getElementById('reminderTime').value = `${hours}:${minutes}`;
        
        document.getElementById('reminderModal').classList.remove('hidden');
      } else {
        alert('Ошибка при загрузке напоминания: ' + (data.error || 'Неизвестная ошибка'));
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Ошибка при загрузке напоминания: ' + error.message);
    });
}

function closeReminderModal() {
  document.getElementById('reminderModal').classList.add('hidden');
}

function saveReminder() {
  const reminderId = document.getElementById('reminderId').value;
  const message = document.getElementById('reminderMessage').value;
  const date = document.getElementById('reminderDate').value;
  const time = document.getElementById('reminderTime').value;
  
  if (!message.trim()) {
    alert('Укажите сообщение напоминания');
    return;
  }
  
  // Create date in user's timezone
  const userTimezoneTime = new Date(date + 'T' + time + ':00').toISOString();
  
  console.log('Saving reminder:', { reminderId, message, date, time, userTimezoneTime });
  
  fetch(`/api/v1/reminders/${reminderId}`, {
    method: 'PATCH',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      reminder: {
        message: message,
        remind_at: userTimezoneTime
      }
    })
  })
  .then(response => {
    console.log('Response status:', response.status);
    return response.json();
  })
  .then(data => {
    console.log('API Response:', data);
    if (data.reminder) {
      alert('Напоминание обновлено!');
      closeReminderModal();
      location.reload();
    } else {
      alert('Ошибка: ' + (data.error || data.errors || JSON.stringify(data)));
    }
  })
  .catch(error => {
    console.error('Error:', error);
    alert('Ошибка при обновлении напоминания: ' + error.message);
  });
}

function deleteReminder() {
  const reminderId = document.getElementById('reminderId').value;
  
  if (!confirm('Удалить напоминание?')) {
    return;
  }
  
  fetch(`/api/v1/reminders/${reminderId}`, {
    method: 'DELETE'
  })
  .then(response => response.json())
  .then(data => {
    alert('Напоминание удалено');
    closeReminderModal();
    location.reload();
  })
  .catch(error => {
    console.error('Error:', error);
    alert('Ошибка при удалении напоминания');
  });
}
</script>