<% content_for :title, "Сегодня — Echo" %>
<%= render "shared/unified_header" %>
<% russian_days = %w[воскресенье понедельник вторник среда четверг пятница суббота] %>
<% russian_months = %w[января февраля марта апреля мая июня июля августа сентября октября ноября декабря] %>
<% date_label = "#{russian_days[@selected_date.wday]}, #{@selected_date.strftime('%d')} #{russian_months[@selected_date.month - 1]}" %>

<div class="echo-command" data-command-dashboard>
  <% if flash[:notice] || flash[:task_notice] %>
    <div class="echo-notice"><%= flash[:notice] || flash[:task_notice] %></div>
  <% end %>

  <header class="command-masthead">
    <div>
      <p class="command-overline">Сейчас</p>
      <h1><%= date_label.capitalize %></h1>
    </div>
    <div class="command-masthead__meta">
      <span><%= @user.timezone %></span>
      <span class="command-meta-dot" aria-hidden="true"></span>
      <%= link_to "Неделя", calendar_events_path(view: "week", date: @selected_date), class: "command-text-link" %>
    </div>
  </header>

  <section class="command-stage">
    <article class="command-focus" data-command-focus data-now-item>
      <div class="command-focus__glow" aria-hidden="true"></div>
      <div class="command-focus__topline">
        <span class="command-signal"><i></i> Следующий ход</span>
        <span class="command-counter"><%= @today_events.size + @today_blocks.size %> в линии дня</span>
      </div>

      <div class="command-focus__content">
        <% if @now_item %>
          <h2><%= @now_item.title %></h2>
          <p><%= @now_item.next_action.presence || "Выбери первый физический шаг" %></p>
        <% else %>
          <h2>Выбери одно действие</h2>
          <p>Не заполняй день. Определи один ход, который сдвинет его вперёд.</p>
        <% end %>
      </div>

      <div class="command-focus__actions">
        <%= link_to calendar_events_path(view: "week", anchor: "task-lane"), class: "command-primary-action", data: { primary_action: true } do %>
          <span>Открыть План</span>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5"/></svg>
        <% end %>
        <span class="command-hint">Один следующий шаг. Не весь проект.</span>
      </div>
    </article>

    <aside class="command-rail">
      <section class="command-rail__section command-rail__section--fixed" data-next-timed-event>
        <div class="command-rail__heading"><span>Ближайшее по времени</span><i aria-hidden="true"></i></div>
        <% if @next_timed_event %>
          <time><%= @next_timed_event.start_time.in_time_zone(@zone).strftime("%H:%M") %></time>
          <h3><%= @next_timed_event.title %></h3>
          <p>Фиксированное событие</p>
        <% else %>
          <strong>Свободное окно</strong>
          <p>До следующего жёсткого события пространство свободно.</p>
        <% end %>
      </section>

      <section class="command-rail__section">
        <div class="command-rail__heading"><span>Требует решения</span><b><%= @needs_me.size %></b></div>
        <div class="command-decisions">
          <% @needs_me.each do |task| %>
            <%= link_to calendar_events_path(view: "week", anchor: "task-lane"), class: "command-decision", data: { needs_me_item: true } do %>
              <i aria-hidden="true"></i>
              <span><strong><%= task.title %></strong><small><%= task.status == "waiting" ? "ожидает решения" : "нужен следующий шаг" %></small></span>
            <% end %>
          <% end %>
          <% if @needs_me.empty? %><p class="command-quiet">Ничего не висит на твоём решении.</p><% end %>
        </div>
      </section>
    </aside>
  </section>

  <section class="command-dayline" data-command-dayline>
    <header>
      <div><span class="command-section-index">01</span><h2>Линия дня</h2></div>
      <%= link_to "Править день", calendar_events_path(view: "day", date: @selected_date), class: "command-text-link" %>
    </header>

    <% if @timeline_items.any? %>
      <div class="command-timeline">
        <% @timeline_items.each do |item| %>
          <% starts = item.is_a?(TimeBlock) ? item.starts_at : item.start_time %>
          <article class="command-timeline__item" data-timeline-kind="<%= item.is_a?(TimeBlock) ? 'time-block' : 'calendar-event' %>">
            <time><%= starts.in_time_zone(@zone).strftime("%H:%M") %></time>
            <span class="command-timeline__node <%= 'command-timeline__node--fixed' unless item.is_a?(TimeBlock) %>" aria-hidden="true"></span>
            <h3><%= item.is_a?(TimeBlock) ? item.task.title : item.title %></h3>
            <p><%= item.is_a?(TimeBlock) ? "гибкий блок" : "фиксировано" %></p>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="command-empty-line">
        <div class="command-empty-line__track" aria-hidden="true"><span></span></div>
        <p><strong>День пока открыт.</strong> Добавь только то, чему действительно нужно место.</p>
      </div>
    <% end %>
  </section>

  <section class="command-glance">
    <header><span class="command-section-index">02</span><h2>Фон, не центр</h2><p>Состояние без лишнего шума</p></header>

    <div class="command-glance__grid">
      <article class="command-glance__item" data-health-pulse>
        <div class="command-glance__icon command-glance__icon--health" aria-hidden="true">+</div>
        <div>
          <span>Здоровье</span>
          <% if @nutrition_calories.nil? && @latest_activity.nil? %>
            <strong>Нет данных</strong>
            <small>Можно оставить как есть</small>
          <% else %>
            <strong><%= @nutrition_calories ? "#{@nutrition_calories.to_i} ккал" : "Есть активность" %></strong>
            <small><%= @latest_activity ? "#{@latest_activity.activity_name}, #{@latest_activity.duration_minutes} мин" : "Питание записано" %></small>
          <% end %>
        </div>
        <%= link_to "Открыть", health_path, class: "command-text-link" %>
      </article>

      <article class="command-glance__item" data-rhythm-home>
        <div class="command-glance__icon" aria-hidden="true">↺</div>
        <div>
          <span>Ритмы</span>
          <% if @rhythms.any? %>
            <% rhythm = @rhythms.first %><% checkin = @rhythm_today[rhythm.id] %>
            <strong><%= rhythm.name %></strong>
            <small><%= checkin ? "Сегодня: #{rhythm_state_label(checkin.state)}" : "Ещё не отмечен" %></small>
          <% else %>
            <strong>Чистый лист</strong>
            <small>Ритмов пока нет</small>
          <% end %>
        </div>
        <%= link_to "Открыть", rhythms_path, class: "command-text-link" %>
      </article>
    </div>
  </section>
</div>
