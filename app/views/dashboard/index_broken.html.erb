  // Drag and Drop Variables
  let draggedEvent = null;
  let draggedEventId = null;
  
  // Drag and Drop Functions
  function handleEventDragStart(e) {
    // Prevent click handler during drag
    e.stopPropagation();
    
    draggedEvent = e.target.closest('.event-card');
    draggedEventId = draggedEvent.dataset.eventId;
    
    // Store event data
    e.dataTransfer.setData('text/plain', draggedEventId);
    e.dataTransfer.effectAllowed = 'move';
    
    // Add dragging visual feedback
    draggedEvent.style.opacity = '0.5';
    draggedEvent.style.transform = 'rotate(2deg)';
    
    // Add visual feedback to all drop zones
    document.querySelectorAll('.drop-zone').forEach(zone => {
      zone.classList.add('drag-active');
    });
  }
  
  function handleEventDragEnd(e) {
    // Reset visual feedback
    if (draggedEvent) {
      draggedEvent.style.opacity = '';
      draggedEvent.style.transform = '';
    }
    
    // Remove drop zone highlighting
    document.querySelectorAll('.drop-zone').forEach(zone => {
      zone.classList.remove('drag-active', 'drag-over');
    });
    
    draggedEvent = null;
    draggedEventId = null;
  }
  
  function handleDragOver(e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
  }
  
  function handleDragEnter(e) {
    e.preventDefault();
    if (draggedEvent) {
      const dropZone = e.target.closest('.drop-zone');
      if (dropZone) {
        dropZone.classList.add('drag-over');
      }
    }
  }
  
  function handleDragLeave(e) {
    const dropZone = e.target.closest('.drop-zone');
    if (!dropZone) return;
    
    // Check if we're actually leaving the drop zone
    if (!e.relatedTarget || !dropZone.contains(e.relatedTarget)) {
      dropZone.classList.remove('drag-over');
    }
  }
  
  function handleEventDrop(e) {
    e.preventDefault();
    e.stopPropagation();
    
    const dropZone = e.target.closest('.drop-zone');
    if (!dropZone) return;
    
    const newDate = dropZone.dataset.date;
    
    if (!draggedEventId || !newDate) return;
    
    // Visual feedback
    dropZone.classList.remove('drag-over');
    
    // Show loading state
    const loadingDiv = document.createElement('div');
    loadingDiv.className = 'text-xs text-gray-600 p-2 bg-gray-100 rounded border-l-4 border-blue-500';
    loadingDiv.innerHTML = '⏳ Перемещаю событие...';
    
    const spaceDiv = dropZone.querySelector('.space-y-2');
    if (spaceDiv) {
      spaceDiv.appendChild(loadingDiv);
    }
    
    // Update event via API
    updateEventDate(draggedEventId, newDate)
      .then(() => {
        // Success - reload page to show updated calendar
        location.reload();
      })
      .catch(error => {
        // Error - remove loading and show error
        if (loadingDiv && loadingDiv.parentNode) {
          loadingDiv.remove();
        }
        alert('Ошибка при перемещении события: ' + error.message);
        console.error('Drag & drop error:', error);
      });
  }
  
  // API call to update event date
  async function updateEventDate(eventId, newDate) {
    const response = await fetch(`/api/calendar/events/${eventId}/move`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        new_date: newDate
      })
    });
    
    if (!response.ok) {
      const error = await response.json();
      throw new Error(error.message || 'Неизвестная ошибка');
    }
    
    return response.json();
  }

  // Initialize current time line (removed - using CSS only now)
  
  // Event title toggle functionality
  function toggleEventTitle(element, clickEvent) {
    // Prevent event propagation to avoid opening edit modal
    if (clickEvent) {
      clickEvent.stopPropagation();
    }
    
    const expandableTitle = element.closest('.expandable-title');
    const collapsedTitle = expandableTitle.querySelector('.collapsed-title');
    const expandedTitle = expandableTitle.querySelector('.expanded-title');
    const isExpanded = expandableTitle.dataset.expanded === 'true';
    
    if (isExpanded) {
      // Collapse
      collapsedTitle.classList.remove('hidden');
      expandedTitle.classList.add('hidden');
      expandableTitle.dataset.expanded = 'false';
    } else {
      // Expand
      collapsedTitle.classList.add('hidden');
      expandedTitle.classList.remove('hidden');
      expandableTitle.dataset.expanded = 'true';
    }
  }
  
  // Convert UTC times to local time
  function formatLocalTime(utcString) {
    const date = new Date(utcString);
    const now = new Date();
    const diffMs = date - now;
    const diffHours = Math.round(diffMs / (1000 * 60 * 60));
    
    // If it's today and within next 24 hours, show relative time
    if (diffMs > 0 && diffHours <= 24 && date.toDateString() === now.toDateString()) {
      if (diffHours < 1) {
        const diffMinutes = Math.round(diffMs / (1000 * 60));
        return diffMinutes > 0 ? `через ${diffMinutes} мин` : 'сейчас';
      } else {
        return `через ${diffHours} ч`;
      }
    }
    
    const options = {
      day: 'numeric',
      month: 'short', 
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: 'Europe/Berlin' // User's timezone
    };
    
    const formatter = new Intl.DateTimeFormat('ru-RU', options);
    return formatter.format(date);
  }
  
  function initLocalTimes() {
    document.querySelectorAll('.local-time').forEach(element => {
      const utcTime = element.dataset.utc;
      if (utcTime) {
        element.textContent = formatLocalTime(utcTime);
      }
    });
  }
  
  // Initialize default view on page load
  document.addEventListener('DOMContentLoaded', function() {
    setCalendarView('week'); // Set week as default
    initLocalTimes(); // Convert times to local
  });
</script>
