<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Echo - AI Personal Assistant" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Inter', sans-serif; }
    </style>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <!-- Navigation - Full Width & Fixed -->
    <nav class="bg-white shadow-sm border-b border-gray-200 fixed top-0 left-0 right-0 z-50">
      <div class="w-full px-6">
        <div class="flex justify-between h-16">
          <div class="flex">
            <div class="flex-shrink-0 flex items-center">
              <span class="text-2xl font-bold text-indigo-600">Echo</span>
            </div>
            <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
              <%= link_to "Dashboard", dashboard_path, class: "border-transparent text-gray-900 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium hover:border-indigo-500 #{current_page?(dashboard_path) ? 'border-indigo-500' : ''}" %>
              <%= link_to "Дневник", diary_entries_path, class: "border-transparent text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium hover:border-indigo-500" %>
              <%= link_to "Идеи", ideas_entries_path, class: "border-transparent text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium hover:border-indigo-500" %>
              <%= link_to "Планы", plans_entries_path, class: "border-transparent text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium hover:border-indigo-500" %>
              <%= link_to "Питание", nutrition_entries_path, class: "border-transparent text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium hover:border-indigo-500 #{current_page?(nutrition_entries_path) ? 'border-indigo-500' : ''}" %>
              <%= link_to "Календарь", calendar_events_path, class: "border-transparent text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium hover:border-indigo-500" %>
              <%= link_to "Напоминания", reminders_path, class: "border-transparent text-gray-500 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium hover:border-indigo-500" %>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content - Full Width -->
    <main class="pt-16 bg-gray-50 min-h-screen">
      <%= yield %>
    </main>
  </body>
</html>
