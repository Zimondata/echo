<% content_for :title, @quest.title %>

<div class="container mx-auto px-4 py-8">
  <!-- Заголовок -->
  <div class="flex justify-between items-center mb-8">
    <div class="flex items-center space-x-4">
      <%= link_to "← Все квесты", quests_path, class: "text-blue-600 hover:text-blue-800" %>
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= @quest.title %></h1>
        <div class="flex items-center space-x-4 mt-2">
          <span class="px-3 py-1 bg-<%= @quest.status == 'active' ? 'green' : @quest.status == 'completed' ? 'purple' : @quest.status == 'paused' ? 'yellow' : 'red' %>-100 text-<%= @quest.status == 'active' ? 'green' : @quest.status == 'completed' ? 'purple' : @quest.status == 'paused' ? 'yellow' : 'red' %>-800 rounded-full text-sm">
            <%= @quest.status_display %>
          </span>
          <span class="text-gray-500 text-sm">
            Создан: <%= @quest.created_at.strftime("%d.%m.%Y в %H:%M") %>
          </span>
        </div>
      </div>
    </div>
    
    <div class="text-right">
      <div class="text-3xl font-bold text-gray-900 mb-2">
        <span id="progress-percentage"><%= @progress %></span>%
      </div>
      <div class="w-32 bg-gray-200 rounded-full h-3">
        <div id="progress-bar" class="bg-blue-600 h-3 rounded-full transition-all duration-300" 
             style="width: <%= @progress %>%"></div>
      </div>
      <div class="text-sm text-gray-500 mt-1">
        <span id="completed-count"><%= @quest.completed_steps_count %></span>/<span id="total-count"><%= @quest.total_steps_count %></span> задач
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Основная информация -->
    <div class="lg:col-span-2">
      <!-- Описание -->
      <div class="bg-white rounded-xl shadow-sm border mb-6">
        <div class="p-6 border-b">
          <h2 class="text-lg font-semibold text-gray-900">📋 Описание квеста</h2>
        </div>
        <div class="p-6">
          <p class="text-gray-700 leading-relaxed"><%= @quest.description %></p>
        </div>
      </div>

      <!-- Чек-лист задач -->
      <div class="bg-white rounded-xl shadow-sm border">
        <div class="p-6 border-b">
          <h2 class="text-lg font-semibold text-gray-900">✅ Задачи</h2>
        </div>
        <div class="p-6">
          <% if @checklist.any? %>
            <div class="space-y-4">
              <% @checklist.each_with_index do |task, index| %>
                <div class="border rounded-lg p-4 <%= task['completed'] ? 'bg-green-50 border-green-200' : 'bg-white border-gray-200' %> hover:shadow-sm transition">
                  <div class="flex items-start space-x-4">
                    <button 
                      onclick="toggleTask(<%= task['id'] %>)"
                      class="mt-1 w-5 h-5 rounded border-2 flex items-center justify-center transition <%= task['completed'] ? 'bg-green-600 border-green-600' : 'border-gray-300 hover:border-green-400' %>"
                      data-task-id="<%= task['id'] %>"
                    >
                      <% if task['completed'] %>
                        <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                        </svg>
                      <% end %>
                    </button>
                    
                    <div class="flex-1">
                      <h3 class="font-medium text-gray-900 mb-2 <%= task['completed'] ? 'line-through text-gray-500' : '' %>">
                        <%= task['task'] %>
                      </h3>
                      <% if task['description'].present? %>
                        <p class="text-gray-600 text-sm mb-3 <%= task['completed'] ? 'line-through' : '' %>">
                          <%= task['description'] %>
                        </p>
                      <% end %>
                      
                      <div class="flex items-center space-x-4 text-sm">
                        <% if task['priority'].present? %>
                          <span class="px-2 py-1 rounded text-xs bg-<%= task['priority'] == 'high' ? 'red' : task['priority'] == 'medium' ? 'yellow' : 'green' %>-100 text-<%= task['priority'] == 'high' ? 'red' : task['priority'] == 'medium' ? 'yellow' : 'green' %>-800">
                            <%= task['priority']&.humanize %>
                          </span>
                        <% end %>
                        
                        <% if task['estimated_time'].present? %>
                          <span class="text-gray-500">
                            ⏱️ <%= task['estimated_time'] %>
                          </span>
                        <% end %>
                        
                        <% if task['completed_at'].present? %>
                          <span class="text-green-600">
                            ✅ Выполнено <%= Time.parse(task['completed_at']).strftime("%d.%m в %H:%M") %>
                          </span>
                        <% end %>
                      </div>
                      
                      <% if task['success_criteria'].present? %>
                        <div class="mt-3 p-3 bg-blue-50 rounded-lg">
                          <h4 class="text-sm font-medium text-blue-900 mb-1">Критерии успеха:</h4>
                          <p class="text-blue-800 text-sm"><%= task['success_criteria'] %></p>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-gray-500 text-center py-8">Задачи не найдены</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Боковая панель -->
    <div class="space-y-6">
      <!-- Быстрые действия -->
      <div class="bg-white rounded-xl shadow-sm border">
        <div class="p-6 border-b">
          <h2 class="text-lg font-semibold text-gray-900">⚡ Действия</h2>
        </div>
        <div class="p-6 space-y-3">
          <% if @quest.status == 'active' %>
            <%= link_to quest_path(@quest, new_status: 'paused'), method: :patch, action: :update_status,
                class: "w-full bg-yellow-600 hover:bg-yellow-700 text-white px-4 py-2 rounded-lg transition text-center block",
                data: { confirm: "Приостановить квест?" } do %>
              ⏸️ Приостановить
            <% end %>
            
            <% unless @quest.completion_percentage == 100 %>
              <%= link_to quest_path(@quest, new_status: 'completed'), method: :patch, action: :update_status,
                  class: "w-full bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition text-center block",
                  data: { confirm: "Отметить квест как завершенный?" } do %>
                ✅ Завершить
              <% end %>
            <% end %>
          <% elsif @quest.status == 'paused' %>
            <%= link_to quest_path(@quest, new_status: 'active'), method: :patch, action: :update_status,
                class: "w-full bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg transition text-center block",
                data: { confirm: "Возобновить квест?" } do %>
              ▶️ Возобновить
            <% end %>
          <% elsif @quest.status == 'completed' %>
            <%= link_to quest_path(@quest, new_status: 'active'), method: :patch, action: :update_status,
                class: "w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition text-center block",
                data: { confirm: "Переоткрыть квест?" } do %>
              🔄 Переоткрыть
            <% end %>
          <% end %>
          
          <%= link_to edit_quest_path(@quest), 
              class: "w-full bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg transition text-center block" do %>
            ✏️ Редактировать
          <% end %>
        </div>
      </div>

      <!-- Цели -->
      <% if @quest.goals_list.any? %>
        <div class="bg-white rounded-xl shadow-sm border">
          <div class="p-6 border-b">
            <h2 class="text-lg font-semibold text-gray-900">🎯 Цели</h2>
          </div>
          <div class="p-6">
            <ul class="space-y-2">
              <% @quest.goals_list.each do |goal| %>
                <li class="flex items-start space-x-2">
                  <span class="text-blue-600 mt-1">•</span>
                  <span class="text-gray-700"><%= goal %></span>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <!-- Ожидаемые результаты -->
      <% if @quest.expected_outcomes.any? %>
        <div class="bg-white rounded-xl shadow-sm border">
          <div class="p-6 border-b">
            <h2 class="text-lg font-semibold text-gray-900">🏆 Ожидаемые результаты</h2>
          </div>
          <div class="p-6">
            <ul class="space-y-2">
              <% @quest.expected_outcomes.each do |outcome| %>
                <li class="flex items-start space-x-2">
                  <span class="text-green-600 mt-1">•</span>
                  <span class="text-gray-700"><%= outcome %></span>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <!-- Информация -->
      <div class="bg-white rounded-xl shadow-sm border">
        <div class="p-6 border-b">
          <h2 class="text-lg font-semibold text-gray-900">📊 Информация</h2>
        </div>
        <div class="p-6 space-y-3">
          <div class="flex justify-between">
            <span class="text-gray-600">Приоритет:</span>
            <span class="font-medium"><%= @quest.priority %>/10</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Создан:</span>
            <span class="font-medium"><%= @quest.created_at.strftime("%d.%m.%Y") %></span>
          </div>
          <% if @quest.estimated_duration != 'Не указано' %>
            <div class="flex justify-between">
              <span class="text-gray-600">Срок:</span>
              <span class="font-medium"><%= @quest.estimated_duration %></span>
            </div>
          <% end %>
          <% if @entry.present? %>
            <div class="pt-3 border-t">
              <span class="text-gray-600 block mb-2">Исходная идея:</span>
              <%= link_to ideas_entries_path, class: "text-blue-600 hover:text-blue-800 text-sm" do %>
                <%= truncate(@entry.content, length: 100) %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function toggleTask(taskId) {
  const csrfToken = document.querySelector('[name="csrf-token"]');
  if (!csrfToken) {
    alert('CSRF токен не найден');
    return;
  }

  const button = document.querySelector(`[data-task-id="${taskId}"]`);
  const originalContent = button.innerHTML;
  
  // Show loading state
  button.innerHTML = '<div class="w-3 h-3 border border-gray-400 border-t-transparent rounded-full animate-spin"></div>';
  button.disabled = true;

  fetch(`/quests/<%= @quest.id %>/toggle_step?step_id=${taskId}`, {
    method: 'PATCH',
    headers: {
      'Accept': 'application/json',
      'Content-Type': 'application/json',
      'X-CSRF-Token': csrfToken.content
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data.success) {
      // Update progress
      document.getElementById('progress-percentage').textContent = data.progress;
      document.getElementById('progress-bar').style.width = data.progress + '%';
      
      // Update completed count
      const completedCount = document.querySelectorAll('[data-task-id]').length - 
                           document.querySelectorAll('[data-task-id]:not(.bg-green-600)').length;
      
      // Reload page to show updated state
      location.reload();
    } else {
      alert(data.message || 'Ошибка при обновлении задачи');
      button.innerHTML = originalContent;
      button.disabled = false;
    }
  })
  .catch(error => {
    console.error('Toggle task error:', error);
    alert('Ошибка при обновлении задачи');
    button.innerHTML = originalContent;
    button.disabled = false;
  });
}
</script>