<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Вход - Auri</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }

    .animated-bg {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      z-index: -1;
      overflow: hidden;
      background: #0a0a0f;
    }

    .animated-bg::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background:
        radial-gradient(circle at 20% 80%, rgba(139, 92, 246, 0.2) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 40% 40%, rgba(59, 130, 246, 0.1) 0%, transparent 40%);
      animation: gradientMove 20s ease-in-out infinite;
    }

    @keyframes gradientMove {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(2%, 2%) rotate(1deg); }
      50% { transform: translate(-1%, 3%) rotate(-1deg); }
      75% { transform: translate(3%, -2%) rotate(2deg); }
    }

    .gradient-text {
      background: linear-gradient(135deg, #8b5cf6 0%, #ec4899 50%, #f59e0b 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .glass-card {
      background: rgba(26, 26, 36, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 24px;
      backdrop-filter: blur(20px);
    }

    .telegram-btn {
      background: linear-gradient(135deg, #229ed9 0%, #1a8bc2 100%);
      transition: all 0.3s ease;
    }

    .telegram-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(34, 158, 217, 0.3);
    }

    .dev-btn {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      transition: all 0.2s ease;
    }

    .dev-btn:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(139, 92, 246, 0.3);
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-in {
      animation: fadeIn 0.6s ease forwards;
    }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
  <div class="animated-bg"></div>

  <div class="w-full max-w-md animate-fade-in">
    <div class="glass-card p-8 shadow-2xl">

      <!-- Logo & Header -->
      <div class="text-center mb-8">
        <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-violet-500/20 to-pink-500/20 flex items-center justify-center border border-violet-500/30">
          <span class="text-4xl gradient-text font-bold">A</span>
        </div>
        <h1 class="text-3xl font-bold text-white mb-2">Добро пожаловать</h1>
        <p class="text-zinc-500">Войдите в <span class="gradient-text font-semibold">Auri</span></p>
      </div>

      <% if Rails.env.development? %>
        <!-- Development Mode -->
        <div class="space-y-4">
          <button onclick="simulateTelegramAuth()" class="telegram-btn w-full py-4 px-6 text-white font-semibold rounded-xl flex items-center justify-center gap-3">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.56c-.21 2.27-1.13 7.75-1.6 10.29-.2 1.08-.59 1.44-.97 1.47-.82.07-1.45-.54-2.24-.97-1.24-.68-1.94-1.1-3.14-1.77-1.39-.77-.49-1.19.3-1.88.21-.18 3.85-3.52 3.92-3.82.01-.04.02-.18-.07-.26s-.22-.05-.32-.03c-.14.03-2.31 1.47-6.52 4.31-.62.43-1.17.63-1.67.62-.55-.01-1.6-.31-2.39-.56-.96-.31-1.72-.47-1.66-1 .04-.27.42-.55 1.16-.83 4.54-1.97 7.57-3.28 9.08-3.91 4.33-1.82 5.23-2.14 5.82-2.15.13 0 .41.03.59.18.15.12.19.29.21.43.02.14.05.3.04.46z"/>
            </svg>
            Войти через Telegram
          </button>

          <p class="text-center text-zinc-600 text-xs">Эмуляция для разработки</p>
        </div>

        <!-- Hidden Form -->
        <%= form_with url: "/auth/telegram/callback", method: :get, local: true, id: "telegram-auth-form", class: "hidden" do |f| %>
          <%= f.hidden_field :id, value: "" %>
          <%= f.hidden_field :first_name, value: "" %>
          <%= f.hidden_field :last_name, value: "" %>
          <%= f.hidden_field :username, value: "" %>
          <%= f.hidden_field :auth_date, value: "" %>
          <%= f.hidden_field :hash, value: "dev_mode_hash" %>
        <% end %>

        <script>
          function simulateTelegramAuth() {
            const users = [
              { id: '263349181', first_name: 'Bitcoin', last_name: 'User', username: 'btchitcoin' },
              { id: '123456789', first_name: 'Александр', last_name: 'Иванов', username: 'alex_ivanov' },
              { id: '987654321', first_name: 'Мария', last_name: 'Петрова', username: 'maria_p' }
            ];

            const user = users[0];
            const form = document.getElementById('telegram-auth-form');
            form.querySelector('[name="id"]').value = user.id;
            form.querySelector('[name="first_name"]').value = user.first_name;
            form.querySelector('[name="last_name"]').value = user.last_name;
            form.querySelector('[name="username"]').value = user.username;
            form.querySelector('[name="auth_date"]').value = Math.floor(Date.now() / 1000);
            form.submit();
          }
        </script>

        <div class="mt-6 pt-6 border-t border-white/5">
          <p class="text-center text-zinc-500 text-sm mb-4">Быстрый вход для тестирования</p>
          <%= form_with url: login_path, method: :post, local: true do |f| %>
            <button type="submit" class="dev-btn w-full py-3 px-4 text-zinc-300 font-medium rounded-xl text-sm">
              Войти как тестовый пользователь
            </button>
          <% end %>
        </div>

      <% else %>
        <!-- Production Mode -->
        <div class="text-center">
          <p class="text-zinc-400 mb-6">Используйте Telegram для входа</p>
          <a href="https://t.me/auriAI_bot?start=login"
             class="telegram-btn inline-flex items-center gap-3 px-8 py-4 text-white font-semibold rounded-xl">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.56c-.21 2.27-1.13 7.75-1.6 10.29-.2 1.08-.59 1.44-.97 1.47-.82.07-1.45-.54-2.24-.97-1.24-.68-1.94-1.1-3.14-1.77-1.39-.77-.49-1.19.3-1.88.21-.18 3.85-3.52 3.92-3.82.01-.04.02-.18-.07-.26s-.22-.05-.32-.03c-.14.03-2.31 1.47-6.52 4.31-.62.43-1.17.63-1.67.62-.55-.01-1.6-.31-2.39-.56-.96-.31-1.72-.47-1.66-1 .04-.27.42-.55 1.16-.83 4.54-1.97 7.57-3.28 9.08-3.91 4.33-1.82 5.23-2.14 5.82-2.15.13 0 .41.03.59.18.15.12.19.29.21.43.02.14.05.3.04.46z"/>
            </svg>
            Войти через Telegram
          </a>
        </div>
      <% end %>

      <!-- Back Link -->
      <div class="mt-8 text-center">
        <a href="/" class="text-zinc-500 hover:text-violet-400 text-sm transition-colors flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Вернуться на главную
        </a>
      </div>
    </div>

    <!-- Footer -->
    <p class="text-center text-zinc-600 text-xs mt-6">
      AI-ассистент для продуктивности и личного развития
    </p>
  </div>
</body>
</html>
