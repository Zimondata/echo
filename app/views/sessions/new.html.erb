<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Вход - Echo</title>
  <%= csrf_meta_tags %>
  <%= action_cable_meta_tag %>
  <%= javascript_importmap_tags %>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }

    .animated-bg {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      z-index: -1;
      overflow: hidden;
      background: #0a0a0f;
    }

    .animated-bg::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background:
        radial-gradient(circle at 20% 80%, rgba(139, 92, 246, 0.2) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.15) 0%, transparent 50%),
        radial-gradient(circle at 40% 40%, rgba(59, 130, 246, 0.1) 0%, transparent 40%);
      animation: gradientMove 20s ease-in-out infinite;
    }

    @keyframes gradientMove {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(2%, 2%) rotate(1deg); }
      50% { transform: translate(-1%, 3%) rotate(-1deg); }
      75% { transform: translate(3%, -2%) rotate(2deg); }
    }

    .gradient-text {
      background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 50%, #6366f1 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .glass-card {
      background: rgba(26, 26, 36, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 24px;
      backdrop-filter: blur(20px);
    }

    .telegram-btn {
      background: linear-gradient(135deg, #229ed9 0%, #1a8bc2 100%);
      transition: all 0.3s ease;
    }

    .telegram-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(34, 158, 217, 0.3);
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .spinner {
      animation: spin 1s linear infinite;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-in {
      animation: fadeIn 0.6s ease forwards;
    }

    #qr-code-container canvas {
      margin: 0 auto;
      border-radius: 12px;
    }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
  <div class="animated-bg"></div>

  <div class="w-full max-w-2xl animate-fade-in">
    <div class="glass-card p-8 shadow-2xl">

      <!-- Logo & Header -->
      <div class="text-center mb-8">
        <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-violet-500/20 to-purple-500/20 flex items-center justify-center border border-violet-500/30">
          <span class="text-4xl gradient-text font-bold">E</span>
        </div>
        <h1 class="text-3xl font-bold text-white mb-2">Вход в Echo</h1>
        <p class="text-zinc-500">Подтвердите вход через <span class="gradient-text font-semibold">Telegram</span></p>
      </div>

      <!-- Auth Methods -->
      <div class="grid md:grid-cols-2 gap-6 mb-6">

        <!-- QR Code Section -->
        <div class="text-center p-6 rounded-xl bg-white/5 border border-white/10">
          <h2 class="text-lg font-semibold text-white mb-4">Сканируйте QR-код</h2>
          <div id="qr-code-container" class="mb-4 flex justify-center"></div>
          <p class="text-xs text-zinc-500">Откройте камеру на телефоне</p>
        </div>

        <!-- Deep Link Section -->
        <div class="text-center p-6 rounded-xl bg-white/5 border border-white/10 flex flex-col justify-center">
          <h2 class="text-lg font-semibold text-white mb-4">Или нажмите кнопку</h2>
          <a href="<%= @auth_data[:deep_link] %>" target="_blank" class="telegram-btn py-4 px-6 text-white font-semibold rounded-xl flex items-center justify-center gap-3 mb-4">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.56c-.21 2.27-1.13 7.75-1.6 10.29-.2 1.08-.59 1.44-.97 1.47-.82.07-1.45-.54-2.24-.97-1.24-.68-1.94-1.1-3.14-1.77-1.39-.77-.49-1.19.3-1.88.21-.18 3.85-3.52 3.92-3.82.01-.04.02-.18-.07-.26s-.22-.05-.32-.03c-.14.03-2.31 1.47-6.52 4.31-.62.43-1.17.63-1.67.62-.55-.01-1.6-.31-2.39-.56-.96-.31-1.72-.47-1.66-1 .04-.27.42-.55 1.16-.83 4.54-1.97 7.57-3.28 9.08-3.91 4.33-1.82 5.23-2.14 5.82-2.15.13 0 .41.03.59.18.15.12.19.29.21.43.02.14.05.3.04.46z"/>
            </svg>
            Войти через Telegram
          </a>
          <p class="text-xs text-zinc-500">Откроется Telegram бот</p>
        </div>

      </div>

      <!-- Status Indicator -->
      <div id="auth-status" class="text-center p-4 rounded-xl bg-white/5 border border-white/10 mb-4">
        <div class="flex items-center justify-center gap-3">
          <svg class="w-5 h-5 text-violet-400 spinner" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          <p class="text-zinc-300">Ожидание подтверждения...</p>
        </div>
      </div>

      <!-- Expiry Timer -->
      <div class="text-center">
        <p class="text-sm text-zinc-500">
          Ссылка истекает через <span id="timer" class="text-violet-400 font-semibold">15:00</span>
        </p>
      </div>

      <!-- Back Link -->
      <div class="mt-8 text-center">
        <a href="/" class="text-zinc-500 hover:text-violet-400 text-sm transition-colors flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Вернуться на главную
        </a>
      </div>
    </div>

    <!-- Footer -->
    <p class="text-center text-zinc-600 text-xs mt-6">
      AI-ассистент для управления дневником и идеями
    </p>
  </div>

  <script type="module">
    // Initialize WebSocket connection
    const sessionToken = '<%= @auth_data[:session_token] %>';
    const expiresAt = new Date('<%= @auth_data[:expires_at].iso8601 %>');
    const qrData = '<%= @auth_data[:qr_data] %>';

    // Wait for DOM and modules to load
    document.addEventListener('DOMContentLoaded', () => {
      // Generate QR code
      new QRCode(document.getElementById('qr-code-container'), {
        text: qrData,
        width: 200,
        height: 200,
        colorDark: '#ffffff',
        colorLight: '#1a1a24',
        correctLevel: QRCode.CorrectLevel.H
      });

      // Wait for TelegramAuthChannel to be available
      const checkAndSubscribe = () => {
        if (window.TelegramAuthChannel) {
          console.log('✅ TelegramAuthChannel loaded, subscribing...');
          window.TelegramAuthChannel.subscribe(sessionToken);
        } else {
          console.log('⏳ Waiting for TelegramAuthChannel...');
          setTimeout(checkAndSubscribe, 100);
        }
      };

      checkAndSubscribe();

      // Добавляем периодическую проверку статуса как fallback
      const checkAuthStatus = async () => {
        try {
          const response = await fetch(`/telegram_auth/${sessionToken}/status`);
          const data = await response.json();
          
          console.log('📊 Auth status check:', data);
          
          if (data.status === 'confirmed') {
            console.log('✅ Auth confirmed via polling! Redirecting...');
            
            // Останавливаем проверку
            clearInterval(statusInterval);
            
            // Показываем успешное сообщение
            document.querySelector('#auth-status').innerHTML = 
              '<div class="success-message" style="text-align: center; color: #10B981; font-weight: bold;">✅ Авторизация успешна! Перенаправление...</div>';
            
            // Перенаправляем через 1 секунду
            setTimeout(() => {
              window.location.href = `/sessions/complete_telegram_auth?session_token=${sessionToken}`;
            }, 1000);
          }
        } catch (error) {
          console.error('❌ Error checking auth status:', error);
        }
      };

      // Проверяем статус каждые 2 секунды
      const statusInterval = setInterval(checkAuthStatus, 2000);
      
      // Останавливаем проверку через 5 минут
      setTimeout(() => clearInterval(statusInterval), 5 * 60 * 1000);
    });

    // Countdown timer
    function updateTimer() {
      const now = new Date();
      const remaining = Math.max(0, Math.floor((expiresAt - now) / 1000));
      const minutes = Math.floor(remaining / 60);
      const seconds = remaining % 60;
      document.getElementById('timer').textContent =
        `${minutes}:${seconds.toString().padStart(2, '0')}`;

      if (remaining === 0) {
        document.getElementById('auth-status').innerHTML = `
          <p class="text-orange-400">⏱️ Время истекло. <a href="/login" class="text-violet-400 underline">Обновить</a></p>
        `;
        authChannel.unsubscribe();
      } else {
        setTimeout(updateTimer, 1000);
      }
    }
    updateTimer();

    // Polling fallback
    let pollingInterval;
    function startPolling() {
      if (pollingInterval) return; // Already polling

      pollingInterval = setInterval(() => {
        fetch(`/telegram_auth/${sessionToken}/status`)
          .then(response => response.json())
          .then(data => {
            if (data.status === 'confirmed') {
              clearInterval(pollingInterval);

              // Complete auth
              fetch('/sessions/complete_telegram_auth', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                  'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
                },
                body: JSON.stringify({ session_token: sessionToken })
              })
              .then(response => response.json())
              .then(data => {
                if (data.success) {
                  window.location.href = data.redirect_url;
                }
              });
            } else if (data.status === 'expired') {
              clearInterval(pollingInterval);
              document.getElementById('auth-status').innerHTML = `
                <p class="text-orange-400">⏱️ Время истекло. <a href="/login" class="text-violet-400 underline">Обновить</a></p>
              `;
            }
          })
          .catch(error => {
            console.error('Polling error:', error);
          });
      }, 2000);
    }
  </script>
</body>
</html>
