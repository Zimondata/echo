<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Вход - Echo</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 min-h-screen flex items-center justify-center">
    <div class="max-w-md w-full mx-4">
        <div class="bg-slate-800/50 backdrop-blur-md rounded-2xl p-8 shadow-2xl border border-slate-700">
            <!-- Header -->
            <div class="text-center mb-8">
                <div class="flex justify-center mb-4">
                    <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center">
                        <span class="text-slate-900 font-bold text-3xl">E</span>
                    </div>
                </div>
                <h1 class="text-3xl font-bold text-white mb-2">Вход в Echo</h1>
                <p class="text-gray-400">Режим разработки</p>
            </div>
            
            <% if Rails.env.development? %>
                <!-- Development Telegram Auth Emulation -->
                <div class="space-y-4">
                    <!-- Telegram Login Button -->
                    <button onclick="simulateTelegramAuth()" class="w-full py-3 px-4 bg-[#54a9eb] hover:bg-[#4a98d4] text-white font-semibold rounded-lg transition-all flex items-center justify-center">
                        <svg class="w-6 h-6 mr-3" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.56c-.21 2.27-1.13 7.75-1.6 10.29-.2 1.08-.59 1.44-.97 1.47-.82.07-1.45-.54-2.24-.97-1.24-.68-1.94-1.1-3.14-1.77-1.39-.77-.49-1.19.3-1.88.21-.18 3.85-3.52 3.92-3.82.01-.04.02-.18-.07-.26s-.22-.05-.32-.03c-.14.03-2.31 1.47-6.52 4.31-.62.43-1.17.63-1.67.62-.55-.01-1.6-.31-2.39-.56-.96-.31-1.72-.47-1.66-1 .04-.27.42-.55 1.16-.83 4.54-1.97 7.57-3.28 9.08-3.91 4.33-1.82 5.23-2.14 5.82-2.15.13 0 .41.03.59.18.15.12.19.29.21.43.02.14.05.3.04.46z"/>
                        </svg>
                        Войти через Telegram
                    </button>
                    
                    <div class="text-center">
                        <p class="text-gray-500 text-xs">Эмуляция авторизации для разработки</p>
                    </div>
                </div>
                
                <!-- Hidden form for auth simulation -->
                <%= form_with url: "/auth/telegram/callback", method: :get, local: true, id: "telegram-auth-form", class: "hidden" do |f| %>
                    <%= f.hidden_field :id, value: "" %>
                    <%= f.hidden_field :first_name, value: "" %>
                    <%= f.hidden_field :last_name, value: "" %>
                    <%= f.hidden_field :username, value: "" %>
                    <%= f.hidden_field :auth_date, value: "" %>
                    <%= f.hidden_field :hash, value: "dev_mode_hash" %>
                <% end %>
                
                <script>
                    function simulateTelegramAuth() {
                        // Симулируем данные Telegram пользователя
                        const users = [
                            { id: '263349181', first_name: 'Bitcoin', last_name: 'User', username: 'btchitcoin' },
                            { id: '123456789', first_name: 'Александр', last_name: 'Иванов', username: 'alex_ivanov' },
                            { id: '987654321', first_name: 'Мария', last_name: 'Петрова', username: 'maria_p' }
                        ];
                        
                        // Выбираем первого (вашего реального) пользователя
                        const user = users[0];
                        
                        // Заполняем форму
                        const form = document.getElementById('telegram-auth-form');
                        form.querySelector('[name="id"]').value = user.id;
                        form.querySelector('[name="first_name"]').value = user.first_name;
                        form.querySelector('[name="last_name"]').value = user.last_name;
                        form.querySelector('[name="username"]').value = user.username;
                        form.querySelector('[name="auth_date"]').value = Math.floor(Date.now() / 1000);
                        
                        // Отправляем форму
                        form.submit();
                    }
                </script>
                
                <div class="mt-6 pt-6 border-t border-slate-700">
                    <p class="text-center text-gray-400 text-sm mb-4">Быстрый вход для тестирования:</p>
                    
                    <%= form_with url: login_path, method: :post, local: true do |f| %>
                        <button type="submit" class="w-full py-2 px-4 bg-slate-700/50 hover:bg-slate-700 text-gray-300 font-medium rounded-lg border border-slate-600 transition-all text-sm">
                            Войти как тестовый пользователь
                        </button>
                    <% end %>
                </div>
            <% else %>
                <!-- Production: Telegram Only -->
                <div class="text-center">
                    <p class="text-gray-400 mb-6">Используйте Telegram для входа</p>
                    <a href="https://t.me/auriAI_bot?start=login" 
                       class="inline-flex items-center px-6 py-3 bg-[#54a9eb] hover:bg-[#4a98d4] text-white font-medium rounded-lg transition-all">
                        <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.56c-.21 2.27-1.13 7.75-1.6 10.29-.2 1.08-.59 1.44-.97 1.47-.82.07-1.45-.54-2.24-.97-1.24-.68-1.94-1.1-3.14-1.77-1.39-.77-.49-1.19.3-1.88.21-.18 3.85-3.52 3.92-3.82.01-.04.02-.18-.07-.26s-.22-.05-.32-.03c-.14.03-2.31 1.47-6.52 4.31-.62.43-1.17.63-1.67.62-.55-.01-1.6-.31-2.39-.56-.96-.31-1.72-.47-1.66-1 .04-.27.42-.55 1.16-.83 4.54-1.97 7.57-3.28 9.08-3.91 4.33-1.82 5.23-2.14 5.82-2.15.13 0 .41.03.59.18.15.12.19.29.21.43.02.14.05.3.04.46z"/>
                        </svg>
                        Войти через Telegram
                    </a>
                </div>
            <% end %>
            
            <!-- Back to Home -->
            <div class="mt-8 text-center">
                <a href="/" class="text-gray-400 hover:text-emerald-400 text-sm transition-colors">
                    ← Вернуться на главную
                </a>
            </div>
        </div>
    </div>
</body>
</html>