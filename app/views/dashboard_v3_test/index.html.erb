<%= render 'shared/header', active: 'dashboard' %>

<style>
  /* Glassmorphism */
  .glass-card {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 4px 16px 0 rgba(139, 92, 246, 0.08);
  }

  /* Timeline */
  .timeline-hour {
    min-height: 60px;
    border-bottom: 1px solid #e5e7eb;
  }

  .timeline-hour:hover {
    background: #f9fafb;
  }

  .timeline-event {
    background: linear-gradient(135deg, #dbeafe 0%, #eff6ff 100%);
    border-left: 4px solid #3b82f6;
  }

  /* Habit streak animation */
  @keyframes fire-flicker {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  .streak-fire {
    animation: fire-flicker 1s ease-in-out infinite;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-purple-50">
  <div class="w-full px-4 sm:px-6 lg:px-8 py-8">
    <!-- Page Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">
        🧪 Вариант 3: Улучшенный календарь
      </h1>
      <p class="text-gray-600">Боковая панель с привычками + Timeline расписание по часам</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
      <!-- Left Sidebar: Habits & All-day Tasks -->
      <div class="space-y-6">
        <!-- Daily Habits -->
        <div class="glass-card rounded-2xl shadow-md overflow-hidden border border-purple-100">
          <div class="bg-gradient-to-r from-purple-500 to-indigo-600 px-4 py-4 text-white">
            <h3 class="font-bold text-lg flex items-center justify-between">
              <span class="flex items-center">
                <span class="text-2xl mr-2">💪</span>
                Привычки
              </span>
              <span class="text-sm bg-white/20 px-2 py-1 rounded-full">
                <%= @habits.count { |h| h[:done] } %>/<%= @habits.count %>
              </span>
            </h3>
          </div>
          <div class="p-4 space-y-2 max-h-96 overflow-y-auto">
            <% @habits.each do |habit| %>
              <label class="flex items-center p-3 rounded-xl bg-gray-50 hover:bg-purple-50 cursor-pointer transition-all border-2 <%= habit[:done] ? 'border-green-300 bg-green-50' : 'border-gray-200 hover:border-purple-300' %> group">
                <input
                  type="checkbox"
                  <%= 'checked' if habit[:done] %>
                  class="w-5 h-5 text-purple-600 rounded-lg focus:ring-2 focus:ring-purple-500"
                >
                <div class="ml-3 flex-1">
                  <div class="text-sm font-medium text-gray-900 <%= 'line-through text-gray-500' if habit[:done] %>">
                    <%= habit[:title] %>
                  </div>
                  <% if habit[:streak] && habit[:streak] > 0 %>
                    <div class="flex items-center mt-1">
                      <span class="text-xs text-orange-600 font-bold streak-fire">
                        🔥 <%= habit[:streak] %> <%= habit[:streak] == 1 ? 'день' : habit[:streak] < 5 ? 'дня' : 'дней' %>
                      </span>
                    </div>
                  <% end %>
                </div>
              </label>
            <% end %>
          </div>
          <div class="px-4 pb-4">
            <button class="block w-full text-center bg-purple-100 hover:bg-purple-200 text-purple-700 font-semibold py-2 px-4 rounded-xl transition-all">
              ➕ Новая привычка
            </button>
          </div>
        </div>

        <!-- All-day Tasks -->
        <div class="glass-card rounded-2xl shadow-md overflow-hidden border border-blue-100">
          <div class="bg-gradient-to-r from-blue-500 to-cyan-600 px-4 py-4 text-white">
            <h3 class="font-bold text-lg flex items-center justify-between">
              <span class="flex items-center">
                <span class="text-2xl mr-2">📋</span>
                На весь день
              </span>
              <span class="text-sm bg-white/20 px-2 py-1 rounded-full">
                <%= @all_day_tasks.count { |t| t[:done] } %>/<%= @all_day_tasks.count %>
              </span>
            </h3>
          </div>
          <div class="p-4 space-y-2">
            <% @all_day_tasks.each do |task| %>
              <label class="flex items-center p-3 rounded-xl bg-gray-50 hover:bg-blue-50 cursor-pointer transition-all border-2 <%= task[:done] ? 'border-green-300 bg-green-50' : 'border-gray-200 hover:border-blue-300' %>">
                <input
                  type="checkbox"
                  <%= 'checked' if task[:done] %>
                  class="w-5 h-5 text-blue-600 rounded-lg focus:ring-2 focus:ring-blue-500"
                >
                <span class="ml-3 text-sm font-medium text-gray-900 <%= 'line-through text-gray-500' if task[:done] %>">
                  <%= task[:title] %>
                </span>
              </label>
            <% end %>
          </div>
        </div>

        <!-- Quick Stats -->
        <div class="glass-card rounded-2xl shadow-md p-6 border border-gray-200">
          <h4 class="font-semibold text-gray-900 mb-4 flex items-center">
            <span class="text-xl mr-2">📊</span>
            Статистика
          </h4>
          <div class="space-y-3">
            <div class="bg-gradient-to-r from-purple-50 to-indigo-50 rounded-xl p-3 border border-purple-200">
              <div class="text-2xl font-bold text-purple-600"><%= @timed_tasks.count + @all_day_tasks.count %></div>
              <div class="text-xs text-gray-600 mt-1">Задач на день</div>
            </div>
            <div class="bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl p-3 border border-green-200">
              <div class="text-2xl font-bold text-green-600"><%= (@timed_tasks + @all_day_tasks).count { |t| t[:done] } %></div>
              <div class="text-xs text-gray-600 mt-1">Выполнено</div>
            </div>
            <div class="bg-gradient-to-r from-orange-50 to-red-50 rounded-xl p-3 border border-orange-200">
              <div class="text-2xl font-bold text-orange-600">0</div>
              <div class="text-xs text-gray-600 mt-1">Калорий съедено</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Content: Timeline -->
      <div class="lg:col-span-3">
        <div class="glass-card rounded-2xl shadow-md overflow-hidden border border-gray-200">
          <div class="bg-gradient-to-r from-gray-50 to-gray-100 px-6 py-4 border-b border-gray-200">
            <div class="flex items-center justify-between">
              <h3 class="text-xl font-bold text-gray-900 flex items-center">
                <span class="text-2xl mr-3">📅</span>
                Расписание на сегодня
              </h3>
              <div class="flex items-center space-x-2">
                <span class="text-sm text-gray-600">
                  <%= @timed_tasks.count %> <%= @timed_tasks.count == 1 ? 'задача' : @timed_tasks.count < 5 ? 'задачи' : 'задач' %>
                </span>
                <button class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-xl font-semibold text-sm transition-all">
                  ➕ Добавить
                </button>
              </div>
            </div>
          </div>

          <div class="p-6 max-h-[800px] overflow-y-auto">
            <div class="space-y-1">
              <% (6..23).each do |hour| %>
                <% tasks_at_hour = @timed_tasks.select { |t| t[:time].start_with?(hour.to_s.rjust(2, '0')) } %>
                <div class="timeline-hour flex items-start py-2">
                  <div class="w-20 flex-shrink-0 text-sm font-semibold text-gray-600 pt-1">
                    <%= "#{hour.to_s.rjust(2, '0')}:00" %>
                  </div>
                  <div class="flex-1 pl-4">
                    <% if tasks_at_hour.any? %>
                      <% tasks_at_hour.each do |task| %>
                        <div class="timeline-event rounded-xl p-4 mb-2 border-2 <%= task[:done] ? 'border-green-300 bg-green-50' : 'border-blue-300' %> shadow-sm hover:shadow-md transition-all group cursor-pointer">
                          <div class="flex items-start justify-between">
                            <div class="flex items-start flex-1">
                              <input
                                type="checkbox"
                                <%= 'checked' if task[:done] %>
                                class="w-6 h-6 text-blue-600 rounded-lg border-2 focus:ring-2 focus:ring-blue-500 mt-0.5 flex-shrink-0"
                              >
                              <div class="ml-4 flex-1">
                                <div class="font-semibold text-gray-900 text-lg <%= 'line-through text-gray-500' if task[:done] %>">
                                  <%= task[:title] %>
                                </div>
                                <div class="flex items-center mt-2 space-x-3">
                                  <span class="text-sm text-gray-600">
                                    ⏰ <%= task[:time] %>
                                  </span>
                                  <span class="px-3 py-1 rounded-full text-xs font-bold <%= task[:category] == 'work' ? 'bg-blue-200 text-blue-700' : task[:category] == 'health' ? 'bg-red-200 text-red-700' : task[:category] == 'personal' ? 'bg-green-200 text-green-700' : 'bg-purple-200 text-purple-700' %>">
                                    <%= task[:category].upcase %>
                                  </span>
                                </div>
                              </div>
                            </div>
                            <button class="ml-3 text-gray-400 hover:text-blue-600 opacity-0 group-hover:opacity-100 transition-opacity">
                              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                              </svg>
                            </button>
                          </div>
                        </div>
                      <% end %>
                    <% else %>
                      <div class="text-gray-300 text-sm">—</div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
