<% content_for :title, "Дашборд идей" %>

<div class="container mx-auto px-4 py-8">
  <!-- Заголовок -->
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900">🧠 Smart Ideas Dashboard</h1>
    <div class="flex space-x-3">
      <%= link_to smart_priority_analyze_all_path, 
          class: "bg-gradient-to-r from-purple-600 to-pink-600 text-white px-4 py-2 rounded-lg hover:shadow-lg transition-all hover:scale-105 flex items-center space-x-2",
          data: { 
            "turbo-method": "post",
            "turbo-confirm": "Запустить AI анализ всех идей? Это может занять несколько минут." 
          } do %>
        <span>🧠</span>
        <span>AI Анализ</span>
      <% end %>
      <%= link_to "Все идеи", ideas_entries_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition" %>
    </div>
  </div>

  <!-- Статистика -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-xl shadow-sm border p-6">
      <div class="flex items-center">
        <div class="p-2 bg-blue-100 rounded-lg">
          <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600">Всего идей</p>
          <p class="text-2xl font-bold text-gray-900"><%= @stats[:total_ideas] %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border p-6">
      <div class="flex items-center">
        <div class="p-2 bg-green-100 rounded-lg">
          <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600">С исследованием</p>
          <p class="text-2xl font-bold text-gray-900"><%= @stats[:with_research] %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border p-6">
      <div class="flex items-center">
        <div class="p-2 bg-purple-100 rounded-lg">
          <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600">С квестами</p>
          <p class="text-2xl font-bold text-gray-900"><%= @stats[:with_quests] %></p>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border p-6">
      <div class="flex items-center">
        <div class="p-2 bg-red-100 rounded-lg">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L4.268 15.5c-.77.833.192 2.5 1.732 2.5z"></path>
          </svg>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-600">Высокий приоритет</p>
          <p class="text-2xl font-bold text-gray-900"><%= @stats[:high_priority] %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Приоритетные идеи -->
    <div class="bg-white rounded-xl shadow-sm border">
      <div class="p-6 border-b">
        <h2 class="text-lg font-semibold text-gray-900">🔥 Приоритетные идеи</h2>
      </div>
      <div class="p-6">
        <% if @priority_ideas.any? %>
          <div class="space-y-4">
            <% @priority_ideas.each do |idea| %>
              <% ai_analysis = idea.metadata&.dig('ai_analysis') %>
              <% priority_score = ai_analysis&.dig('priority_score') %>
              <% priority_level = ai_analysis&.dig('priority_level') %>
              
              <div class="border rounded-lg p-4 hover:shadow-md transition cursor-pointer <%= priority_level == 'critical' ? 'border-red-300 bg-red-50' : priority_level == 'high' ? 'border-amber-300 bg-amber-50' : '' %>" onclick="toggleIdeaContent('<%= idea.id %>')">
                <div class="flex justify-between items-start">
                  <div class="flex-1">
                    <!-- Заголовок с AI индикатором -->
                    <div class="flex items-center space-x-2 mb-2">
                      <h3 class="font-medium text-gray-900 flex-1">
                        <span class="idea-preview-<%= idea.id %>"><%= truncate(idea.content, length: 80) %></span>
                        <span class="idea-full-<%= idea.id %> hidden"><%= idea.content %></span>
                        <% if idea.content.length > 80 %>
                          <span class="text-blue-600 text-sm ml-2 idea-toggle-<%= idea.id %>">читать далее...</span>
                        <% end %>
                      </h3>
                      <% if priority_score %>
                        <div class="flex items-center space-x-1">
                          <span class="text-xs font-bold px-2 py-1 rounded-full <%= priority_level == 'critical' ? 'bg-red-600 text-white' : priority_level == 'high' ? 'bg-amber-600 text-white' : 'bg-blue-600 text-white' %>">
                            🧠 <%= priority_score.round(1) %>
                          </span>
                        </div>
                      <% end %>
                    </div>
                    
                    <!-- Метаданные и индикаторы -->
                    <div class="flex items-center space-x-3 text-sm text-gray-500 mb-2">
                      <span class="px-2 py-1 bg-blue-100 text-blue-800 rounded">
                        <%= idea.idea_priority_display || 'Не указан' %>
                      </span>
                      <span><%= idea.created_at.strftime("%d.%m.%Y") %></span>
                      
                      <% if priority_level == 'critical' %>
                        <span class="px-2 py-1 bg-red-100 text-red-800 rounded text-xs animate-pulse">
                          🔥 КРИТИЧНО
                        </span>
                      <% elsif priority_level == 'high' %>
                        <span class="px-2 py-1 bg-amber-100 text-amber-800 rounded text-xs">
                          ⭐ ВАЖНО
                        </span>
                      <% end %>
                    </div>
                    
                    <!-- AI рекомендации -->
                    <% if ai_analysis&.dig('recommendations')&.any? %>
                      <% top_recommendation = ai_analysis['recommendations'].first %>
                      <div class="text-xs text-blue-700 bg-blue-50 px-2 py-1 rounded">
                        🤖 <%= top_recommendation['message'] %>
                      </div>
                    <% end %>
                  </div>
                  
                  <div class="flex flex-col space-y-1 ml-4">
                    <!-- AI анализ приоритета -->
                    <% unless priority_score %>
                      <%= link_to smart_priority_analyze_idea_path(idea), 
                          class: "text-purple-600 hover:text-purple-800 p-1", 
                          title: "AI анализ приоритета",
                          data: { 
                            "turbo-method": "post",
                            "turbo-confirm": "Проанализировать приоритет идеи с помощью AI?" 
                          } do %>
                        🧠
                      <% end %>
                    <% else %>
                      <%= link_to smart_priority_show_analysis_path(idea), 
                          class: "text-purple-600 hover:text-purple-800 p-1", 
                          title: "Подробный AI анализ" do %>
                        📊
                      <% end %>
                    <% end %>
                    
                    <!-- Research -->
                    <% unless idea.research_data.present? %>
                      <%= link_to research_idea_path(idea), 
                          class: "text-blue-600 hover:text-blue-800 p-1", 
                          title: "Сделать research",
                          data: { 
                            "turbo-method": "post",
                            "turbo-confirm": "Провести AI-исследование идеи?" 
                          } do %>
                        🔬
                      <% end %>
                    <% else %>
                      <%= link_to show_research_path(idea), 
                          class: "text-green-600 hover:text-green-800 p-1", 
                          title: "Посмотреть анализ" do %>
                        📋
                      <% end %>
                    <% end %>
                    
                    <!-- Quest -->
                    <% unless idea.quest_generated? %>
                      <%= link_to generate_quest_path(idea), 
                          class: "text-amber-600 hover:text-amber-800 p-1", 
                          title: "Создать квест",
                          data: { 
                            "turbo-method": "post",
                            "turbo-confirm": "Создать квест из идеи?" 
                          } do %>
                        ⚡
                      <% end %>
                    <% else %>
                      <span class="text-green-600 p-1" title="Квест создан">✅</span>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-gray-500 text-center py-8">Нет приоритетных идей</p>
        <% end %>
      </div>
    </div>

    <!-- Готовые к исследованию -->
    <div class="bg-white rounded-xl shadow-sm border">
      <div class="p-6 border-b">
        <h2 class="text-lg font-semibold text-gray-900">🔬 Готовые к исследованию</h2>
      </div>
      <div class="p-6">
        <% if @research_ready.any? %>
          <div class="space-y-4">
            <% @research_ready.each do |idea| %>
              <div class="border rounded-lg p-4 hover:shadow-md transition cursor-pointer" onclick="toggleIdeaContent('<%= idea.id %>')">
                <h3 class="font-medium text-gray-900 mb-2">
                  <span class="idea-preview-<%= idea.id %>"><%= truncate(idea.content, length: 80) %></span>
                  <span class="idea-full-<%= idea.id %> hidden"><%= idea.content %></span>
                  <% if idea.content.length > 80 %>
                    <span class="text-blue-600 text-sm ml-2 idea-toggle-<%= idea.id %>">читать далее...</span>
                  <% end %>
                </h3>
                <div class="flex justify-between items-center">
                  <span class="text-sm text-gray-500"><%= idea.created_at.strftime("%d.%m.%Y") %></span>
                  <%= link_to research_idea_path(idea), 
                      class: "bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded text-sm transition",
                      data: { 
                        "turbo-method": "post",
                        "turbo-confirm": "Провести AI-исследование идеи?" 
                      } do %>
                    🔬 Исследовать
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-gray-500 text-center py-8">Все идеи исследованы</p>
        <% end %>
      </div>
    </div>

    <!-- Кандидаты в квесты -->
    <div class="bg-white rounded-xl shadow-sm border">
      <div class="p-6 border-b">
        <h2 class="text-lg font-semibold text-gray-900">⚡ Кандидаты в квесты</h2>
      </div>
      <div class="p-6">
        <% if @quest_candidates.any? %>
          <div class="space-y-4">
            <% @quest_candidates.each do |idea| %>
              <div class="border rounded-lg p-4 hover:shadow-md transition cursor-pointer" onclick="toggleIdeaContent('<%= idea.id %>')">
                <h3 class="font-medium text-gray-900 mb-2">
                  <span class="idea-preview-<%= idea.id %>"><%= truncate(idea.content, length: 80) %></span>
                  <span class="idea-full-<%= idea.id %> hidden"><%= idea.content %></span>
                  <% if idea.content.length > 80 %>
                    <span class="text-blue-600 text-sm ml-2 idea-toggle-<%= idea.id %>">читать далее...</span>
                  <% end %>
                </h3>
                <div class="flex justify-between items-center">
                  <div class="text-sm text-gray-500">
                    <span><%= idea.created_at.strftime("%d.%m.%Y") %></span>
                    <% if idea.research_data.present? %>
                      <span class="text-green-600 ml-2">📊 Исследована</span>
                    <% end %>
                  </div>
                  <%= link_to generate_quest_path(idea), 
                      class: "bg-purple-600 hover:bg-purple-700 text-white px-3 py-1 rounded text-sm transition",
                      data: { 
                        "turbo-method": "post",
                        "turbo-confirm": "Создать квест из идеи?" 
                      } do %>
                    ⚡ Создать квест
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-gray-500 text-center py-8">Все квесты созданы</p>
        <% end %>
      </div>
    </div>

    <!-- Последние квесты -->
    <div class="bg-white rounded-xl shadow-sm border">
      <div class="p-6 border-b">
        <h2 class="text-lg font-semibold text-gray-900">🎯 Последние квесты</h2>
      </div>
      <div class="p-6">
        <% if @recent_quests.any? %>
          <div class="space-y-4">
            <% @recent_quests.each do |quest| %>
              <div class="border rounded-lg p-4 hover:shadow-md transition">
                <h3 class="font-medium text-gray-900 mb-2"><%= quest.title %></h3>
                <div class="flex justify-between items-center">
                  <div class="text-sm text-gray-500">
                    <span>Прогресс: <%= quest.steps.dig('progress', 'completion_percentage') || 0 %>%</span>
                  </div>
                  <%= link_to quest_path(quest), 
                      class: "bg-gray-600 hover:bg-gray-700 text-white px-3 py-1 rounded text-sm transition" do %>
                    Открыть
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-gray-500 text-center py-8">Нет квестов</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
function toggleIdeaContent(ideaId) {
  const preview = document.querySelector(`.idea-preview-${ideaId}`);
  const full = document.querySelector(`.idea-full-${ideaId}`);
  const toggle = document.querySelector(`.idea-toggle-${ideaId}`);
  
  if (preview && full) {
    if (preview.classList.contains('hidden')) {
      // Показать краткое содержание
      preview.classList.remove('hidden');
      full.classList.add('hidden');
      if (toggle) toggle.textContent = 'читать далее...';
    } else {
      // Показать полное содержание
      preview.classList.add('hidden');
      full.classList.remove('hidden');
      if (toggle) toggle.textContent = 'свернуть';
    }
  }
}

// Предотвратить срабатывание клика на карточке при клике на кнопки действий
document.addEventListener('click', function(event) {
  if (event.target.closest('a') || event.target.closest('button')) {
    event.stopPropagation();
  }
});
</script>