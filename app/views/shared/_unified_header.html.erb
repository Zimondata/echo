<header class="echo-header">
  <div class="echo-header__inner">
    <%= link_to dashboard_path, class: "echo-brand" do %>
      <span class="echo-brand__mark" aria-hidden="true">E</span>
      <span>Echo</span>
    <% end %>

    <nav class="echo-nav" aria-label="Основная навигация">
      <% permanent_destinations.each do |destination| %>
        <% active = request.path == URI.parse(destination[:path]).path %>
        <%= link_to destination[:label], destination[:path], class: "echo-nav__link", data: { permanent_destination: true }, aria: (active ? { current: "page" } : {}) %>
      <% end %>
    </nav>

    <div class="echo-header__actions">
      <button type="button" class="echo-theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Включить Lavender" title="Violet / Lavender">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 15.2A8.5 8.5 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z"/></svg>
      </button>
      <%= link_to settings_path, class: "echo-icon-button", aria: { label: "Настройки" }, title: "Настройки" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21H9.6v-.1A1.7 1.7 0 0 0 8.6 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3V9.6h.1A1.7 1.7 0 0 0 4.6 8.6a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3h4v.1A1.7 1.7 0 0 0 15.4 4a1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.4 9c.16.38.36.72.6 1 .3.3.68.45 1.1.45h.1v4h-.1c-.42 0-.8.15-1.1.45-.24.28-.44.62-.6 1.1Z"/></svg>
      <% end %>
    </div>
  </div>
</header>

<nav class="echo-mobile-dock" aria-label="Мобильная навигация">
  <% permanent_destinations.each do |destination| %>
    <% active = request.path == URI.parse(destination[:path]).path %>
    <%= link_to destination[:path], class: "echo-mobile-dock__link", data: { permanent_destination: true }, aria: (active ? { current: "page" } : {}) do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><%= raw destination[:icon] %></svg>
      <span><%= destination[:label] %></span>
    <% end %>
  <% end %>
</nav>
