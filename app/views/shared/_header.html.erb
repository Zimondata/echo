<!-- Навигационный хедер -->
<nav class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
  <div class="px-6 py-4">
    <div class="flex items-center justify-between">
      <!-- Левая часть - лого и навигация -->
      <div class="flex items-center space-x-8">
        <div class="flex items-center space-x-2">
          <div class="w-8 h-8 bg-gradient-to-br from-violet-500 to-purple-600 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-lg">E</span>
          </div>
          <span class="text-xl font-semibold text-gray-900">Echo</span>
        </div>

        <div class="flex items-center space-x-1">
          <%= link_to dashboard_path, class: "px-4 py-2 text-sm font-medium #{local_assigns[:active] == 'dashboard' ? 'text-white bg-[#1a73e8]' : 'text-gray-700 hover:text-gray-900 hover:bg-gray-100'} rounded-lg transition-colors" do %>
            <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
            Главная
          <% end %>

          <%= link_to calendar_events_path, class: "px-4 py-2 text-sm font-medium #{local_assigns[:active] == 'calendar' ? 'text-white bg-[#1a73e8]' : 'text-gray-700 hover:text-gray-900 hover:bg-gray-100'} rounded-lg transition-colors" do %>
            <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            Календарь
          <% end %>

          <%= link_to diary_path, class: "px-4 py-2 text-sm font-medium #{local_assigns[:active] == 'diary' ? 'text-white bg-[#1a73e8]' : 'text-gray-700 hover:text-gray-900 hover:bg-gray-100'} rounded-lg transition-colors" do %>
            <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
            Дневник
          <% end %>

          <%= link_to ideas_path, class: "px-4 py-2 text-sm font-medium #{local_assigns[:active] == 'ideas' ? 'text-white bg-[#1a73e8]' : 'text-gray-700 hover:text-gray-900 hover:bg-gray-100'} rounded-lg transition-colors" do %>
            <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
            </svg>
            Идеи
          <% end %>

          <%= link_to nutrition_entries_path, class: "px-4 py-2 text-sm font-medium #{local_assigns[:active] == 'nutrition' ? 'text-white bg-[#1a73e8]' : 'text-gray-700 hover:text-gray-900 hover:bg-gray-100'} rounded-lg transition-colors" do %>
            <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
            Питание
          <% end %>
        </div>
      </div>

      <!-- Правая часть - профиль -->
      <div class="flex items-center space-x-4">
        <button class="p-2 text-gray-600 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
          </svg>
        </button>

        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 bg-gradient-to-br from-violet-500 to-purple-600 rounded-full flex items-center justify-center">
            <span class="text-white text-sm font-medium">
              <%= current_user.first_name&.first&.upcase || 'U' %>
            </span>
          </div>
          <span class="text-sm font-medium text-gray-900"><%= current_user.first_name || 'Пользователь' %></span>
        </div>
      </div>
    </div>
  </div>
</nav>
