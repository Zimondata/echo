// Initialize on page load
document.addEventListener('DOMContentLoaded', () => {
  // Add staggered animation to cards
  document.querySelectorAll('.idea-card').forEach((card, index) => {
    card.style.animation = `fadeIn 0.5s ease ${index * 0.1}s both`;
  });
  
  // Close all menus when clicking outside
  document.addEventListener('click', (event) => {
    if (!event.target.closest('[id^="ideaActionMenu"]') && !event.target.closest('button[onclick*="toggleIdeaActionMenu"]')) {
      document.querySelectorAll('[id^="ideaActionMenu"]').forEach(menu => {
        menu.classList.add('hidden');
      });
    }
  });
});
