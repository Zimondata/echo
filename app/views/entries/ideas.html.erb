// Research idea function
function researchIdea(ideaId) {
  if (!ideaId) {
    alert('Ошибка: ID идеи не найден');
    return;
  }
  
  if (!confirm('Провести AI-исследование этой идеи? Это может занять несколько минут.')) {
    return;
  }
  
  const csrfToken = document.querySelector('[name="csrf-token"]');
  if (!csrfToken) {
    alert('CSRF токен не найден');
    return;
  }
  
  // Show loading message
  alert('Исследование началось. Пожалуйста, подождите...');
  
  fetch(`/ideas_dashboard/${ideaId}/research`, {
    method: 'POST',
    headers: {
      'Accept': 'application/json',
      'Content-Type': 'application/json',
      'X-CSRF-Token': csrfToken.content
    }
  })
  .then(response => {
    if (response.ok) {
      alert('Исследование завершено! Страница будет перезагружена.');
      window.location.reload();
    } else {
      alert('Ошибка при проведении исследования');
    }
  })
  .catch(error => {
    console.error('Research error:', error);
    alert(`Ошибка при исследовании: ${error.message}`);
  });
}

// Generate quest function
function generateQuest(ideaId) {
