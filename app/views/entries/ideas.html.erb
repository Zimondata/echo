// Research worthiness checker (mirrors server-side logic)
function isResearchWorthy(card) {
  const content = card.dataset.title.toLowerCase();
  
  // Критерии исключения (НЕ стоит исследовать)
  const excludePatterns = [
    /запись.*(дневник|мысли|чувства|настроение)/,
    /сегодня.*(был|была|думал|чувствовал)/,
    /(плохо|хорошо|устал|болит)/,
    /нужно.*(купить|сделать|не забыть|позвонить)/,
    /(завтра|сегодня|вчера).*(встреча|дела|планы)/,
    /список.*(дел|покупок|задач)/,
    /^(интересно|хочется|надо бы|можно было бы).{0,30}$/,
    /^(вообще|кстати|наверное).{0,50}$/,
    /(баг|ошибка|не работает|исправить)/,
    /тестирование|дебаг|логи/
  ];
  
  // Если попадает под исключение - не исследуем
  if (excludePatterns.some(pattern => content.match(pattern))) {
    return false;
  }
  
  // Критерии включения (СТОИТ исследовать)
  const includePatterns = [
    /(проект|стартап|бизнес|приложение|сервис|платформа)/,
    /(монетизация|доход|продажи|клиенты|пользователи)/,
    /(mvp|прототип|тестирование гипотез)/,
    /(ai|ии|искусственный интеллект|машинное обучение)/,
    /(автоматизация|оптимизация|улучшение процесса)/,
    /(новая функция|фича|возможность)/,
    /(исследование|анализ|изучение|разработка)/,
    /(как.*(работает|устроен|влияет|можно улучшить))/,
    /(почему.*(происходит|нужно|важно))/,
    /(пользователи|интерфейс|ux|ui|дизайн)/,
    /(функциональность|возможности|решение)/,
    /(проблема|потребность|боль пользователей)/,
    /(стратегия|развитие|направление|тренд)/,
    /(рынок|конкуренты|аналоги|позиционирование)/,
    /(масштабирование|рост|экспансия)/
  ];
  
  // Проверяем длину
  if (content.length < 20) {
    return false;
  }
  
  // Проверяем наличие ключевых слов
  const hasResearchKeywords = includePatterns.some(pattern => content.match(pattern));
  
  // Дополнительная проверка на сложность идеи
  const complexityIndicators = [
    content.includes('как') && content.includes('?'),
    content.includes('почему') && content.includes('?'),
    content.split(/[.!?]/).length > 2,
    /\b(система|алгоритм|методика|подход|концепция)\b/.test(content),
    /\b(интеграция|внедрение|реализация|разработка)\b/.test(content)
  ];
  
  const complexityScore = complexityIndicators.filter(Boolean).length;
  
  return hasResearchKeywords || complexityScore >= 3;
}

// Smart Sorting and Filtering Functions
function applySorting() {
  const sortValue = document.getElementById('sortSelect').value;
  const grid = document.getElementById('ideasGrid');
  const cards = Array.from(grid.querySelectorAll('.idea-card'));
  
  cards.sort((a, b) => {
    switch(sortValue) {
      case 'date_desc':
        return new Date(b.dataset.createdAt) - new Date(a.dataset.createdAt);
      case 'date_asc':
        return new Date(a.dataset.createdAt) - new Date(b.dataset.createdAt);
      case 'priority_desc':
        return parseFloat(b.dataset.priorityScore) - parseFloat(a.dataset.priorityScore);
      case 'status':
        const statusOrder = { 'critical': 4, 'high': 3, 'medium': 2, 'low': 1, 'none': 0 };
        return statusOrder[b.dataset.priorityLevel] - statusOrder[a.dataset.priorityLevel];
      case 'alphabetical':
        return a.dataset.title.localeCompare(b.dataset.title, 'ru');
      default:
        return 0;
    }
  });
  
  // Reorder cards in DOM
  cards.forEach(card => grid.appendChild(card));
  
  // Add animation
  cards.forEach((card, index) => {
    card.style.animation = `fadeIn 0.3s ease ${index * 0.05}s both`;
  });
}

function applyFilters() {
  const statusFilter = document.getElementById('statusFilter').value;
  const cards = document.querySelectorAll('.idea-card');
  
  cards.forEach(card => {
    let shouldShow = true;
    
    switch(statusFilter) {
      case 'not_analyzed':
        shouldShow = card.dataset.isAnalyzed === 'no';
        break;
      case 'analyzed':
        shouldShow = card.dataset.isAnalyzed === 'yes';
        break;
      case 'high_priority':
        shouldShow = ['critical', 'high'].includes(card.dataset.priorityLevel);
        break;
      case 'ready_for_research':
        shouldShow = card.dataset.hasResearch === 'no' && isResearchWorthy(card);
        break;
      case 'researched':
        shouldShow = card.dataset.hasResearch === 'yes';
        break;
      case 'with_quests':
        shouldShow = card.dataset.hasQuest === 'yes';
        break;
      case 'all':
      default:
        shouldShow = true;
    }
    
    if (shouldShow) {
      card.style.display = 'block';
      card.style.animation = 'fadeIn 0.3s ease';
    } else {
      card.style.display = 'none';
    }
  });
  
  // Also apply current tag filter
  filterIdeas();
}

function applyGrouping() {
  const groupValue = document.getElementById('groupSelect').value;
  const grid = document.getElementById('ideasGrid');
  const cards = Array.from(grid.querySelectorAll('.idea-card'));
  
  // Remove existing group headers
  grid.querySelectorAll('.group-header').forEach(header => header.remove());
  
  if (groupValue === 'none') {
    // No grouping - just sort normally
    applySorting();
    return;
  }
  
  // Group cards
  const groups = {};
  
  cards.forEach(card => {
    let groupKey;
    
    switch(groupValue) {
      case 'priority':
        groupKey = card.dataset.priorityLevel;
        break;
      case 'status':
        if (card.dataset.hasQuest === 'yes') groupKey = 'С квестами';
        else if (card.dataset.hasResearch === 'yes') groupKey = 'Исследованы';
        else if (card.dataset.isAnalyzed === 'yes') groupKey = 'Проанализированы';
        else groupKey = 'Новые';
        break;
      case 'date':
        const date = new Date(card.dataset.createdAt);
        const today = new Date();
        const diffDays = Math.floor((today - date) / (1000 * 60 * 60 * 24));
        
        if (diffDays === 0) groupKey = 'Сегодня';
        else if (diffDays === 1) groupKey = 'Вчера';
        else if (diffDays < 7) groupKey = 'На этой неделе';
        else if (diffDays < 30) groupKey = 'В этом месяце';
        else groupKey = 'Раньше';
        break;
      case 'tags':
        const tags = card.dataset.tags;
        groupKey = tags ? tags.split(',')[0] : 'Без тегов';
        break;
      default:
        groupKey = 'Без группы';
    }
    
    if (!groups[groupKey]) groups[groupKey] = [];
    groups[groupKey].push(card);
  });
  
  // Clear grid and add grouped content
  grid.innerHTML = '';
  
  // Define group order
  const groupOrder = getGroupOrder(groupValue);
  const sortedGroupKeys = Object.keys(groups).sort((a, b) => {
    const indexA = groupOrder.indexOf(a);
    const indexB = groupOrder.indexOf(b);
    if (indexA === -1 && indexB === -1) return a.localeCompare(b, 'ru');
    if (indexA === -1) return 1;
    if (indexB === -1) return -1;
    return indexA - indexB;
  });
  
  sortedGroupKeys.forEach(groupKey => {
    // Add group header
    const header = document.createElement('div');
    header.className = 'group-header col-span-full mb-4 mt-8 first:mt-0';
    header.innerHTML = `
      <div class="flex items-center gap-3">
        <h3 class="text-lg font-semibold text-gray-800">${getGroupDisplayName(groupKey, groupValue)}</h3>
        <span class="text-sm text-gray-500 bg-gray-100 px-2 py-1 rounded-full">${groups[groupKey].length}</span>
      </div>
      <div class="h-px bg-gradient-to-r from-purple-200 to-transparent mt-2"></div>
    `;
    grid.appendChild(header);
    
    // Add cards in this group
    groups[groupKey].forEach((card, index) => {
      card.style.animation = `fadeIn 0.3s ease ${index * 0.05}s both`;
      grid.appendChild(card);
    });
  });
}

function getGroupOrder(groupValue) {
  switch(groupValue) {
    case 'priority':
      return ['critical', 'high', 'medium', 'low', 'none'];
    case 'status':
      return ['С квестами', 'Исследованы', 'Проанализированы', 'Новые'];
    case 'date':
      return ['Сегодня', 'Вчера', 'На этой неделе', 'В этом месяце', 'Раньше'];
    default:
      return [];
  }
}

function getGroupDisplayName(groupKey, groupValue) {
  if (groupValue === 'priority') {
    const priorityNames = {
      'critical': '🔥 Критический приоритет',
      'high': '⭐ Высокий приоритет', 
      'medium': '📝 Средний приоритет',
      'low': '💡 Низкий приоритет',
      'none': '❓ Не проанализированы'
    };
    return priorityNames[groupKey] || groupKey;
  }
  
  return groupKey;
}

function resetFilters() {
  document.getElementById('sortSelect').value = 'date_desc';
  document.getElementById('statusFilter').value = 'all';
  document.getElementById('groupSelect').value = 'none';
  document.getElementById('searchInput').value = '';
  
  // Reset tag filters
  document.querySelectorAll('.tag-filter').forEach(btn => {
    if (btn.dataset.tag === 'all') {
      btn.className = 'tag-filter px-4 py-2 rounded-full text-sm font-medium transition-all bg-gradient-to-r from-violet-600 to-purple-600 text-white shadow-lg';
    } else {
      btn.className = 'tag-filter px-4 py-2 rounded-full text-sm font-medium transition-all bg-white/80 backdrop-blur text-purple-700 hover:bg-white/90 shadow-md border border-purple-200/50';
    }
  });
  
  currentTag = null;
  
  // Show all cards
  document.querySelectorAll('.idea-card').forEach(card => {
    card.style.display = 'block';
  });
  
  applySorting();
}

// Toggle additional notifications
function toggleAllNotifications() {
  const additionalNotifications = document.getElementById('additionalNotifications');
  const button = event.target;
  
  if (additionalNotifications.classList.contains('hidden')) {
    additionalNotifications.classList.remove('hidden');
    button.textContent = 'Скрыть дополнительные уведомления';
  } else {
    additionalNotifications.classList.add('hidden');
    const hiddenCount = additionalNotifications.children.length;
    button.textContent = `Показать ещё ${hiddenCount} уведомлений`;
  }
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', () => {
  // Add staggered animation to cards
  document.querySelectorAll('.idea-card').forEach((card, index) => {
    card.style.animation = `fadeIn 0.5s ease ${index * 0.1}s both`;
  });
  
  // Close all menus when clicking outside
  document.addEventListener('click', (event) => {
    if (!event.target.closest('[id^="ideaActionMenu"]') && !event.target.closest('button[onclick*="toggleIdeaActionMenu"]')) {
      document.querySelectorAll('[id^="ideaActionMenu"]').forEach(menu => {
        menu.classList.add('hidden');
      });
    }
  });
});
