<%= render 'shared/unified_header' %>

<!-- Animated Background -->
<div class="animated-bg"></div>

<style>
  /* Animated Background */
  .animated-bg {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: -1;
    overflow: hidden;
  }

  .animated-bg::before {
    content: '';
    position: absolute;
    top: -50%; left: -50%;
    width: 200%; height: 200%;
    background:
      radial-gradient(circle at 20% 80%, rgba(139, 92, 246, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 40% 40%, rgba(59, 130, 246, 0.08) 0%, transparent 40%);
    animation: gradientMove 20s ease-in-out infinite;
  }

  @keyframes gradientMove {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(2%, 2%) rotate(1deg); }
    50% { transform: translate(-1%, 3%) rotate(-1deg); }
    75% { transform: translate(3%, -2%) rotate(2deg); }
  }

  .idea-card {
    transition: all 0.3s ease;
    transform-style: preserve-3d;
    perspective: 1000px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
  }

  .idea-card:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: var(--border-glow, rgba(139, 92, 246, 0.3));
    background: var(--bg-card-hover);
  }

  .gradient-overlay {
    transition: opacity 0.5s ease;
  }

  .idea-card:hover .gradient-overlay {
    opacity: 0.3;
  }

  .tag-badge {
    backdrop-filter: blur(8px);
  }

  .search-container {
    backdrop-filter: blur(12px);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
  }

  [data-color-scheme="light"] .search-container {
    background: rgba(255, 255, 255, 0.8);
    border-color: rgba(139, 92, 246, 0.15);
  }

  /* Filter selects */
  select {
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  select:focus {
    outline: none;
    border-color: var(--violet-500);
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
  }

  select option {
    background: var(--bg-darkest);
    color: var(--text-primary);
  }

  [data-color-scheme="light"] select {
    background: white;
    border-color: rgba(139, 92, 246, 0.2);
  }

  [data-color-scheme="light"] select:focus {
    border-color: var(--violet-600);
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
  }

  [data-color-scheme="light"] select option {
    background: white;
  }

  /* Filter labels */
  .filter-label-text {
    color: var(--text-secondary);
  }

  /* Tag filters */
  .tag-filter {
    background: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .tag-filter:hover {
    background: var(--bg-card-hover);
  }

  .tag-filter.active {
    background: linear-gradient(135deg, var(--violet-600), var(--violet-500));
    color: white;
    border-color: transparent;
  }

  [data-color-scheme="light"] .tag-filter {
    background: rgba(255, 255, 255, 0.8);
    border-color: rgba(139, 92, 246, 0.2);
  }

  [data-color-scheme="light"] .tag-filter:hover {
    background: rgba(255, 255, 255, 0.95);
  }

  /* Sidebar cards */
  .sidebar-stats-card {
    background: linear-gradient(135deg, var(--bg-card) 0%, rgba(139, 92, 246, 0.05) 100%);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }

  .sidebar-stats-card h3 {
    color: var(--text-primary);
    font-weight: 600;
  }

  .sidebar-stats-card span {
    color: var(--text-primary);
  }

  .sidebar-stats-card .text-sm {
    color: var(--text-secondary);
  }

  [data-color-scheme="light"] .sidebar-stats-card {
    background: linear-gradient(135deg, white 0%, rgba(139, 92, 246, 0.08) 100%);
    border-color: rgba(139, 92, 246, 0.2);
    box-shadow: 0 4px 16px rgba(139, 92, 246, 0.1);
  }

  /* Sidebar inner cards */
  .sidebar-inner-card {
    background: rgba(139, 92, 246, 0.05);
    border: 1px solid rgba(139, 92, 246, 0.1);
    transition: all 0.2s ease;
  }

  .sidebar-inner-card:hover {
    background: rgba(139, 92, 246, 0.1);
    border-color: rgba(139, 92, 246, 0.2);
    transform: translateX(4px);
  }

  [data-color-scheme="light"] .sidebar-inner-card {
    background: rgba(139, 92, 246, 0.05);
    border-color: rgba(139, 92, 246, 0.15);
  }

  [data-color-scheme="light"] .sidebar-inner-card:hover {
    background: rgba(139, 92, 246, 0.12);
    border-color: rgba(139, 92, 246, 0.25);
  }

  /* Input placeholder */
  input::placeholder {
    color: var(--text-muted);
  }

  /* Search input specific */
  #searchInput {
    color: var(--text-primary);
  }

  #searchInput::placeholder {
    color: var(--text-muted);
  }

  @keyframes sparkle {
    0% { transform: rotate(0deg) scale(1); opacity: 0.1; }
    50% { transform: rotate(180deg) scale(1.1); opacity: 0.2; }
    100% { transform: rotate(360deg) scale(1); opacity: 0.1; }
  }

  .sparkle-icon {
    animation: sparkle 8s linear infinite;
  }

  .modal-backdrop {
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  #ideaModal .bg-white {
    transform: scale(0.95);
    transition: transform 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.5s ease;
  }
</style>

<div class="min-h-screen w-full relative">
  <div class="w-full px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Header with animation -->
    <div class="mb-8 animate-fade-in">
      <div class="flex justify-between items-center">
        <div>
          <h1 class="text-4xl font-bold mb-2 flex items-center gap-3" style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 50%, #6366f1 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
            <svg class="w-10 h-10 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
            Мои идеи
          </h1>
          <p class="text-lg font-medium" style="color: var(--text-secondary);">
            Коллекция инновационных идей и концепций
          </p>
        </div>
        <div class="flex gap-3">
          <%= link_to ideas_dashboard_path, class: "bg-gradient-to-r from-blue-600 to-purple-600 text-white px-4 py-2 rounded-lg hover:shadow-lg transition-all hover:scale-105 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
            <span>Дашборд идей</span>
          <% end %>
          <%= link_to quests_path, class: "bg-gradient-to-r from-violet-600 to-purple-600 text-white px-4 py-2 rounded-lg hover:shadow-lg transition-all hover:scale-105 flex items-center gap-2" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Мои квесты</span>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Smart Notifications Panel -->
    <% if @smart_notifications&.any? %>
      <div class="mb-8">
        <div class="sidebar-stats-card rounded-2xl p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-gradient-to-r from-blue-600 to-purple-600 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <h3 class="text-lg font-semibold">AI Помощник</h3>
          </div>
          
          <div class="space-y-3">
            <% @smart_notifications.first(3).each do |notification| %>
              <div class="flex items-center justify-between p-4 sidebar-inner-card rounded-xl transition">
                <div class="flex items-center gap-3">
                  <span class="text-2xl"><%= notification[:icon] %></span>
                  <div>
                    <h4 class="font-medium"><%= notification[:title] %></h4>
                    <p class="text-sm"><%= notification[:message] %></p>
                  </div>
                </div>
                <% if notification[:action_url] %>
                  <%= link_to notification[:action_url], 
                      class: "px-4 py-2 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-lg text-sm font-medium hover:shadow-lg transition-all hover:scale-105" do %>
                    <%= notification[:action_text] %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
          
          <% if @smart_notifications.count > 3 %>
            <button onclick="toggleAllNotifications()" class="mt-3 text-sm text-purple-600 hover:text-purple-800 font-medium">
              Показать ещё <%= @smart_notifications.count - 3 %> уведомлений
            </button>
            <div id="additionalNotifications" class="hidden mt-3 space-y-3">
              <% @smart_notifications[3..-1].each do |notification| %>
                <div class="flex items-center justify-between p-4 sidebar-inner-card rounded-xl">
                  <div class="flex items-center gap-3">
                    <span class="text-2xl"><%= notification[:icon] %></span>
                    <div>
                      <h4 class="font-medium"><%= notification[:title] %></h4>
                      <p class="text-sm"><%= notification[:message] %></p>
                    </div>
                  </div>
                  <% if notification[:action_url] %>
                    <%= link_to notification[:action_url], 
                        class: "px-4 py-2 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-lg text-sm font-medium hover:shadow-lg transition-all hover:scale-105" do %>
                      <%= notification[:action_text] %>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Search and Filters -->
    <div class="mb-8 space-y-4">
      <!-- Search Bar -->
      <div class="search-container rounded-2xl shadow-lg p-1">
        <div class="relative">
          <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input
            type="text"
            id="searchInput"
            placeholder="Поиск идей..."
            class="w-full pl-12 pr-4 py-3 bg-transparent border-0 focus:ring-2 focus:ring-purple-500 rounded-xl outline-none font-medium"
            onkeyup="filterIdeas()"
          >
        </div>
      </div>

      <!-- Smart Sorting and Filters -->
      <div class="flex flex-wrap items-center gap-4 mb-4">
        <!-- Sort Options -->
        <div class="flex items-center gap-2">
          <span class="text-sm font-medium filter-label-text">Сортировка:</span>
          <select id="sortSelect" onchange="applySorting()" class="px-3 py-2 rounded-lg border border-purple-200 focus:ring-2 focus:ring-purple-500 text-sm">
            <option value="date_desc">По дате (новые)</option>
            <option value="date_asc">По дате (старые)</option>
            <option value="priority_desc">По приоритету AI</option>
            <option value="status">По статусу</option>
            <option value="alphabetical">По алфавиту</option>
          </select>
        </div>

        <!-- Status Filters -->
        <div class="flex items-center gap-2">
          <span class="text-sm font-medium filter-label-text">Статус:</span>
          <select id="statusFilter" onchange="applyFilters()" class="px-3 py-2 rounded-lg border border-purple-200 focus:ring-2 focus:ring-purple-500 text-sm">
            <option value="all">Все</option>
            <option value="not_analyzed">Не проанализированы</option>
            <option value="analyzed">Проанализированы AI</option>
            <option value="high_priority">Высокий приоритет</option>
            <option value="ready_for_research">Готовы к исследованию</option>
            <option value="researched">Исследованы</option>
            <option value="with_quests">С квестами</option>
          </select>
        </div>

        <!-- Group Options -->
        <div class="flex items-center gap-2">
          <span class="text-sm font-medium filter-label-text">Группировка:</span>
          <select id="groupSelect" onchange="applyGrouping()" class="px-3 py-2 rounded-lg border border-purple-200 focus:ring-2 focus:ring-purple-500 text-sm">
            <option value="none">Без группировки</option>
            <option value="priority">По приоритету</option>
            <option value="status">По статусу</option>
            <option value="date">По дате создания</option>
            <option value="tags">По тегам</option>
          </select>
        </div>

        <!-- Reset Button -->
        <button onclick="resetFilters()" class="px-3 py-2 rounded-lg text-sm transition sidebar-inner-card">
          Сбросить
        </button>
      </div>

      <!-- Tag Filters -->
      <div class="flex flex-wrap gap-2" id="tagFilters">
        <button
          onclick="filterByTag(null)"
          class="tag-filter active px-4 py-2 rounded-full text-sm font-medium transition-all shadow-lg"
          data-tag="all"
        >
          Все
        </button>
        <% 
          all_tags = @entries.flat_map { |e| e.tags || [] }.uniq.compact
          all_tags.each do |tag| 
        %>
          <button
            onclick="filterByTag('<%= tag %>')"
            class="tag-filter px-4 py-2 rounded-full text-sm font-medium transition-all shadow-md"
            data-tag="<%= tag %>"
          >
            <%= tag %>
          </button>
        <% end %>
      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      
      <!-- Ideas Grid -->
      <div class="lg:col-span-3">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="ideasGrid">
      <% @entries.each_with_index do |entry, index| %>
        <%
          gradients = [
            ['#8b5cf6', '#7c3aed'],
            ['#a78bfa', '#f472b6'],
            ['#c084fc', '#f9a8d4'],
            ['#d8b4fe', '#fbcfe8'],
            ['#e9d5ff', '#fce7f3'],
            ['#ddd6fe', '#fdf2f8']
          ]
          gradient = gradients[index % gradients.length]
          ai_analysis = entry.metadata&.dig('ai_analysis')
          priority_score = ai_analysis&.dig('priority_score') || 0
          priority_level = ai_analysis&.dig('priority_level') || 'none'
          has_research = entry.research_data.present? ? 'yes' : 'no'
          has_quest = entry.quest_generated? ? 'yes' : 'no'
          is_analyzed = ai_analysis.present? ? 'yes' : 'no'
        %>
        
        <div 
          class="idea-card relative cursor-pointer group" 
          data-idea-id="<%= entry.id %>"
          data-tags="<%= entry.tags&.join(',') || '' %>"
          data-title="<%= entry.content.split('.').first&.truncate(100) || '' %>"
          data-created-at="<%= entry.created_at.iso8601 %>"
          data-priority-score="<%= priority_score %>"
          data-priority-level="<%= priority_level %>"
          data-has-research="<%= has_research %>"
          data-has-quest="<%= has_quest %>"
          data-is-analyzed="<%= is_analyzed %>"
          onclick="openIdeaModal(<%= entry.id %>)"
        >
          <div class="relative overflow-hidden rounded-2xl bg-white shadow-xl hover:shadow-2xl transition-all duration-300 border border-purple-100">
            
            <!-- Content -->
            <div class="p-6">
              <!-- Header with gradient accent -->
              <div class="mb-4 flex items-start justify-between">
                <div class="flex items-center gap-3">
                  <div 
                    class="w-12 h-12 rounded-xl flex items-center justify-center shadow-lg"
                    style="background: linear-gradient(135deg, <%= gradient[0] %>, <%= gradient[1] %>);"
                  >
                    <span class="text-xl">💡</span>
                  </div>
                  <div>
                    <p class="text-xs text-gray-500 font-medium">
                      <%= I18n.l(entry.created_at.in_time_zone(@user.timezone), format: :long) %>
                    </p>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <span class="px-2 py-1 bg-purple-100 text-purple-700 text-xs font-semibold rounded-lg">
                    Идея
                  </span>
                  
                  <!-- Action Menu -->
                  <div class="relative" onclick="event.stopPropagation();">
                    <button onclick="toggleIdeaActionMenu(<%= entry.id %>)" class="p-1.5 rounded-full hover:bg-gray-100 transition-colors" title="Действия">
                      <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01"></path>
                      </svg>
                    </button>
                    
                    <!-- Dropdown Menu -->
                    <div id="ideaActionMenu<%= entry.id %>" class="hidden absolute right-0 mt-1 w-36 bg-white/95 backdrop-blur-sm border border-gray-200 rounded-lg shadow-lg z-10">
                      <div class="py-1">
                        <% unless entry.research_data.present? %>
                          <button onclick="researchIdea(<%= entry.id %>)" class="w-full px-3 py-2 text-left text-sm text-blue-600 hover:bg-blue-50 flex items-center gap-2">
                            🔬
                            AI Research
                          </button>
                        <% else %>
                          <a href="/ideas_dashboard/<%= entry.id %>/research" class="w-full px-3 py-2 text-left text-sm text-green-600 hover:bg-green-50 flex items-center gap-2 block">
                            📊
                            Посмотреть анализ
                          </a>
                        <% end %>
                        
                        <% unless entry.quest_generated? %>
                          <button onclick="generateQuest(<%= entry.id %>)" class="w-full px-3 py-2 text-left text-sm text-purple-600 hover:bg-purple-50 flex items-center gap-2">
                            ⚡
                            Создать квест
                          </button>
                        <% end %>
                        
                        <button onclick="editIdeaFromCard(<%= entry.id %>)" class="w-full px-3 py-2 text-left text-sm text-gray-700 hover:bg-purple-50 hover:text-purple-700 flex items-center gap-2">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                          </svg>
                          Редактировать
                        </button>
                        <button onclick="deleteIdeaFromCard(<%= entry.id %>)" class="w-full px-3 py-2 text-left text-sm text-red-600 hover:bg-red-50 flex items-center gap-2">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                          </svg>
                          Удалить
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Title -->
              <h3 class="mb-3 text-lg font-bold leading-tight text-gray-900">
                <%= entry.content.split('.').first&.truncate(60) || "Идея ##{entry.id}" %>
              </h3>

              <!-- Description -->
              <p class="mb-4 text-sm text-gray-600 leading-relaxed line-clamp-3">
                <%= entry.content.truncate(150) %>
              </p>

              <!-- Tags -->
              <% if entry.tags.present? && entry.tags.any? %>
                <div class="flex flex-wrap gap-2">
                  <% entry.tags.first(3).each do |tag| %>
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-purple-50 text-purple-700 text-xs font-medium">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                      </svg>
                      <%= tag %>
                    </span>
                  <% end %>
                </div>
              <% end %>

              <!-- Bottom gradient line -->
              <div class="absolute bottom-0 left-0 right-0 h-1" 
                   style="background: linear-gradient(90deg, <%= gradient[0] %>, <%= gradient[1] %>);">
              </div>
            </div>
          </div>
        </div>
      <% end %>
        </div>

        <!-- Empty State -->
        <% if @entries.empty? %>
          <div class="text-center py-16">
            <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gradient-to-br from-violet-600 to-purple-600 flex items-center justify-center shadow-lg">
              <svg class="w-12 h-12 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.34.208-.646.477-.859a4 4 0 10-4.954 0c.27.213.462.519.476.859h4.002z"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold mb-2" style="background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
              Пока нет идей
            </h3>
            <p class="font-medium max-w-md mx-auto" style="color: var(--text-secondary);">
              Отправьте боту свои идеи, и они появятся здесь в красивом виде
            </p>
          </div>
        <% end %>
      </div>

      <!-- AI Insights Sidebar -->
      <div class="lg:col-span-1">
        <div class="space-y-6 sticky top-8">
          
          <!-- Weekly Stats -->
          <div class="sidebar-stats-card rounded-2xl p-6 shadow-lg">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-gradient-to-r from-violet-600 to-purple-600 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
              </div>
              <h3 class="text-lg font-semibold">Недельная статистика</h3>
            </div>
            
            <div class="space-y-4">
              <div class="flex justify-between items-center">
                <span class="text-sm">Новых идей</span>
                <span class="text-2xl font-bold text-purple-600"><%= @weekly_insights[:new_ideas_count] %></span>
              </div>
              
              <div class="flex justify-between items-center">
                <span class="text-sm">Исследовано</span>
                <span class="text-xl font-semibold text-blue-600"><%= @weekly_insights[:researched_count] %></span>
              </div>
              
              <div class="flex justify-between items-center">
                <span class="text-sm">Квестов создано</span>
                <span class="text-xl font-semibold text-green-600"><%= @weekly_insights[:quests_created] %></span>
              </div>
              
              <div class="pt-4 border-t" style="border-color: var(--border-subtle);">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-sm">Продуктивность</span>
                  <% case @weekly_insights[:productivity_trend]
                     when 'growing' %>
                    <span class="text-green-600 text-sm">📈 Растёт</span>
                  <% when 'declining' %>
                    <span class="text-red-600 text-sm">📉 Снижается</span>
                  <% else %>
                    <span class="text-gray-600 text-sm">➡️ Стабильно</span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <!-- Top Priority Idea -->
          <% if @weekly_insights[:top_priority_idea] %>
            <div class="sidebar-stats-card rounded-2xl p-6 shadow-lg">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-gradient-to-r from-amber-500 to-orange-500 rounded-xl flex items-center justify-center">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                  </svg>
                </div>
                <h3 class="text-lg font-semibold">Топ идея недели</h3>
              </div>
              
              <div class="sidebar-inner-card rounded-xl p-4">
                <p class="text-sm leading-relaxed">
                  <%= truncate(@weekly_insights[:top_priority_idea].content, length: 120) %>
                </p>
                <% ai_analysis = @weekly_insights[:top_priority_idea].metadata&.dig('ai_analysis') %>
                <% if ai_analysis&.dig('priority_score') %>
                  <div class="mt-3 flex items-center gap-2">
                    <span class="text-xs font-bold px-2 py-1 rounded-full bg-amber-600 text-white">
                      🧠 <%= ai_analysis['priority_score'].round(1) %>
                    </span>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <!-- Quick Actions -->
          <div class="sidebar-stats-card rounded-2xl p-6 shadow-lg">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <h3 class="text-lg font-semibold">Быстрые действия</h3>
            </div>
            
            <div class="space-y-3">
              <%= link_to ideas_dashboard_path,
                  class: "w-full flex items-center gap-3 p-3 sidebar-inner-card rounded-xl transition" do %>
                <svg class="w-5 h-5" style="color: var(--violet-500);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
                <span class="text-sm font-medium">Smart Dashboard</span>
              <% end %>

              <%= link_to quests_path,
                  class: "w-full flex items-center gap-3 p-3 sidebar-inner-card rounded-xl transition" do %>
                <svg class="w-5 h-5" style="color: var(--green-500);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="text-sm font-medium">Мои квесты</span>
              <% end %>

              <button onclick="location.reload()"
                      class="w-full flex items-center gap-3 p-3 sidebar-inner-card rounded-xl transition">
                <svg class="w-5 h-5" style="color: var(--blue-500);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                <span class="text-sm font-medium">Обновить AI</span>
              </button>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

<!-- Modal for full idea view -->
<div id="ideaModal" class="fixed inset-0 z-50 hidden">
  <div class="modal-backdrop fixed inset-0 bg-black/70 backdrop-blur-sm" onclick="closeIdeaModal()"></div>
  <div class="fixed inset-4 md:inset-x-8 md:inset-y-16 lg:inset-x-32 lg:inset-y-20 flex items-center justify-center">
    <div class="bg-white rounded-3xl shadow-2xl overflow-hidden max-w-4xl w-full max-h-full flex flex-col">
      <!-- Header with gradient -->
      <div class="relative">
        <div id="modalGradient" class="h-32 md:h-40"></div>
        <button 
          onclick="closeIdeaModal()"
          class="absolute right-4 top-4 p-2.5 rounded-full bg-white/20 backdrop-blur-md hover:bg-white/30 transition-colors group"
        >
          <svg class="w-5 h-5 text-white group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
        
        <!-- Floating icon -->
        <div class="absolute -bottom-6 left-8 w-16 h-16 bg-white rounded-2xl shadow-xl flex items-center justify-center">
          <span class="text-3xl">💡</span>
        </div>
      </div>
      
      <!-- Content -->
      <div class="flex-1 overflow-y-auto px-8 pt-12 pb-8">
        <!-- Title and date -->
        <div class="mb-6">
          <h1 id="modalTitle" class="text-2xl md:text-3xl font-bold text-gray-900 mb-2 leading-tight"></h1>
          <p id="modalDate" class="text-sm text-gray-500 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span></span>
          </p>
        </div>
        
        <!-- Tags -->
        <div id="modalTags" class="flex flex-wrap gap-2 mb-8"></div>
        
        <!-- Main content with better typography -->
        <div class="prose prose-gray max-w-none">
          <div id="modalContent" class="text-gray-700 leading-relaxed text-base md:text-lg whitespace-pre-wrap"></div>
        </div>
      </div>
      
      <!-- Footer actions -->
      <div class="border-t border-gray-200 px-8 py-4 bg-gray-50/50">
        <div class="flex items-center justify-between">
          <div class="flex gap-3">
            <!-- Move to different section dropdown -->
            <div class="relative">
              <button onclick="toggleModalMenu()" class="p-2 hover:bg-purple-100 rounded-lg transition-colors group">
                <svg class="w-5 h-5 text-purple-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                </svg>
              </button>
              
              <!-- Dropdown menu -->
              <div id="modalChangeMenu" class="hidden absolute bottom-full mb-2 left-0 w-40 bg-white/90 backdrop-blur-sm border border-gray-200 rounded-lg shadow-lg z-20">
                <div class="px-3 py-2">
                  <div class="text-xs text-gray-500 mb-2">Переместить в:</div>
                  <div class="space-y-1">
                    <button onclick="changeModalEntryType('plan')" class="w-full px-2 py-1 text-left text-xs text-blue-600 hover:bg-blue-50 rounded flex items-center gap-2">
                      📋 Планы
                    </button>
                    <button onclick="changeModalEntryType('diary')" class="w-full px-2 py-1 text-left text-xs text-purple-600 hover:bg-purple-50 rounded flex items-center gap-2">
                      📔 Дневник
                    </button>
                  </div>
                </div>
              </div>
            </div>
            
            <button onclick="researchIdea(currentModalEntryId)" class="p-2 hover:bg-blue-100 rounded-lg transition-colors group" title="AI Research">
              🔬
            </button>
            
            <button onclick="generateQuest(currentModalEntryId)" class="p-2 hover:bg-purple-100 rounded-lg transition-colors group" title="Создать квест">
              ⚡
            </button>
            
            <button onclick="editIdea(currentModalEntryId)" class="p-2 hover:bg-purple-100 rounded-lg transition-colors group" title="Редактировать">
              <svg class="w-5 h-5 text-purple-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
              </svg>
            </button>
            
            <button onclick="deleteIdea(currentModalEntryId)" class="p-2 hover:bg-red-100 rounded-lg transition-colors group" title="Удалить">
              <svg class="w-5 h-5 text-red-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
              </svg>
            </button>
          </div>
          <button onclick="closeIdeaModal()" class="px-6 py-2 bg-gradient-to-r from-violet-600 to-purple-600 text-white font-medium rounded-full hover:shadow-lg transition-all hover:scale-105">
            Закрыть
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Store ideas data
const ideasData = <%= @entries.to_json.html_safe %>;
const gradients = [
  ['#8b5cf6', '#7c3aed'],
  ['#a78bfa', '#f472b6'],
  ['#c084fc', '#f9a8d4'],
  ['#d8b4fe', '#fbcfe8'],
  ['#e9d5ff', '#fce7f3'],
  ['#ddd6fe', '#fdf2f8']
];

let currentTag = null;

function filterIdeas() {
  const searchValue = document.getElementById('searchInput').value.toLowerCase();
  const cards = document.querySelectorAll('.idea-card');
  
  cards.forEach(card => {
    const title = card.dataset.title.toLowerCase();
    const tags = card.dataset.tags.toLowerCase();
    const matchesSearch = title.includes(searchValue) || tags.includes(searchValue);
    const matchesTag = !currentTag || tags.includes(currentTag.toLowerCase());
    
    if (matchesSearch && matchesTag) {
      card.style.display = 'block';
      card.style.animation = 'fadeIn 0.3s ease';
    } else {
      card.style.display = 'none';
    }
  });
}

function filterByTag(tag) {
  currentTag = tag;
  
  // Update button states
  document.querySelectorAll('.tag-filter').forEach(btn => {
    if ((tag === null && btn.dataset.tag === 'all') || btn.dataset.tag === tag) {
      btn.className = 'tag-filter px-4 py-2 rounded-full text-sm font-medium transition-all bg-gradient-to-r from-violet-600 to-purple-600 text-white shadow-lg';
    } else {
      btn.className = 'tag-filter px-4 py-2 rounded-full text-sm font-medium transition-all bg-white/80 backdrop-blur text-purple-700 hover:bg-white/90 shadow-md border border-purple-200/50';
    }
  });
  
  filterIdeas();
}

function openIdeaModal(ideaId) {
  currentModalEntryId = ideaId; // Save for change type functionality
  const idea = ideasData.find(i => i.id === ideaId);
  if (!idea) return;
  
  const gradientIndex = ideasData.indexOf(idea) % gradients.length;
  const gradient = gradients[gradientIndex];
  
  // Set gradient header
  document.getElementById('modalGradient').style.background = `linear-gradient(135deg, ${gradient[0]}, ${gradient[1]})`;
  
  // Set title
  const title = idea.content.split('.')[0] || `Идея #${idea.id}`;
  document.getElementById('modalTitle').textContent = title;
  
  // Set date
  const dateSpan = document.querySelector('#modalDate span');
  dateSpan.textContent = new Date(idea.created_at).toLocaleDateString('ru-RU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
  
  // Set tags with better styling
  const tagsContainer = document.getElementById('modalTags');
  tagsContainer.innerHTML = (idea.tags || []).map(tag => `
    <span class="inline-flex items-center gap-1 px-4 py-2 rounded-full bg-purple-100 text-purple-700 font-medium text-sm">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
      </svg>
      ${tag}
    </span>
  `).join('');
  
  // Set content with proper formatting
  document.getElementById('modalContent').textContent = idea.content;
  
  // Show modal with animation
  const modal = document.getElementById('ideaModal');
  modal.classList.remove('hidden');
  setTimeout(() => {
    modal.querySelector('.modal-backdrop').style.opacity = '1';
    modal.querySelector('.bg-white').style.transform = 'scale(1)';
  }, 10);
  document.body.style.overflow = 'hidden';
}

function closeIdeaModal() {
  document.getElementById('ideaModal').classList.add('hidden');
  document.body.style.overflow = 'auto';
}

// Add fade-in animation
const style = document.createElement('style');
style.textContent = `
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeOut {
    from { opacity: 1; transform: scale(1); }
    to { opacity: 0; transform: scale(0.95); }
  }
  .animate-fade-in {
    animation: fadeIn 0.5s ease;
  }
`;
document.head.appendChild(style);

// Change entry type functions for ideas modal
let currentModalEntryId = null;

function toggleModalMenu() {
  const menu = document.getElementById('modalChangeMenu');
  menu.classList.toggle('hidden');
}

function changeModalEntryType(newType) {
  if (!currentModalEntryId) {
    alert('Ошибка: ID записи не найден');
    return;
  }
  
  if (!confirm(`Переместить запись в раздел "${getTypeName(newType)}"?`)) {
    return;
  }
  
  const csrfToken = document.querySelector('[name="csrf-token"]');
  if (!csrfToken) {
    alert('CSRF токен не найден');
    return;
  }
  
  fetch(`/entries/${currentModalEntryId}.json`, {
    method: 'PATCH',
    headers: {
      'Accept': 'application/json',
      'Content-Type': 'application/json',
      'X-CSRF-Token': csrfToken.content
    },
    body: JSON.stringify({
      entry: {
        entry_type: newType
      }
    })
  })
  .then(response => response.json())
  .then(data => {
    if (data && data.success) {
      alert(`Запись перемещена в "${getTypeName(newType)}"`);
      closeIdeaModal();
      location.reload();
    } else {
      alert('Ошибка при изменении типа записи');
    }
  })
  .catch(error => {
    console.error('Change type error:', error);
    alert(`Ошибка при изменении типа: ${error.message}`);
  });
}

function getTypeName(type) {
  const typeNames = {
    'idea': 'Идеи',
    'plan': 'Планы', 
    'diary': 'Дневник'
  };
  return typeNames[type] || type;
}

// Edit and delete functions for ideas
function editIdea(ideaId) {
  if (!ideaId) {
    alert('Ошибка: ID идеи не найден');
    return;
  }
  
  // Navigate to edit page
  window.location.href = `/entries/${ideaId}/edit`;
}

function editIdeaFromCard(ideaId) {
  window.location.href = `/entries/${ideaId}/edit`;
}

// Toggle action menu for idea cards
function toggleIdeaActionMenu(ideaId) {
  const menu = document.getElementById(`ideaActionMenu${ideaId}`);
  const allMenus = document.querySelectorAll('[id^="ideaActionMenu"]');
  
  // Close all other menus
  allMenus.forEach(m => {
    if (m.id !== `ideaActionMenu${ideaId}`) {
      m.classList.add('hidden');
    }
  });
  
  // Toggle current menu
  menu.classList.toggle('hidden');
}

function deleteIdeaFromCard(ideaId) {
  if (!ideaId) {
    alert('Ошибка: ID идеи не найден');
    return;
  }
  
  if (!confirm('Вы уверены, что хотите удалить эту идею? Это действие нельзя отменить.')) {
    return;
  }
  
  const csrfToken = document.querySelector('[name="csrf-token"]');
  if (!csrfToken) {
    alert('CSRF токен не найден');
    return;
  }
  
  // Close menu
  const menu = document.getElementById(`ideaActionMenu${ideaId}`);
  if (menu) {
    menu.classList.add('hidden');
  }
  
  fetch(`/entries/${ideaId}.json`, {
    method: 'DELETE',
    headers: {
      'Accept': 'application/json',
      'Content-Type': 'application/json',
      'X-CSRF-Token': csrfToken.content
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data && data.success) {
      alert('Идея успешно удалена');
      // Remove the card from the grid
      const ideaCard = document.querySelector(`[data-idea-id="${ideaId}"]`);
      if (ideaCard) {
        ideaCard.style.animation = 'fadeOut 0.3s ease';
        setTimeout(() => {
          ideaCard.remove();
        }, 300);
      }
    } else {
      alert('Ошибка при удалении идеи');
    }
  })
  .catch(error => {
    console.error('Delete error:', error);
    alert(`Ошибка при удалении: ${error.message}`);
  });
}

function deleteIdea(ideaId) {
  if (!ideaId) {
    alert('Ошибка: ID идеи не найден');
    return;
  }
  
  if (!confirm('Вы уверены, что хотите удалить эту идею? Это действие нельзя отменить.')) {
    return;
  }
  
  const csrfToken = document.querySelector('[name="csrf-token"]');
  if (!csrfToken) {
    alert('CSRF токен не найден');
    return;
  }
  
  // Show loading state
  const deleteButton = event.target.closest('button');
  const originalContent = deleteButton.innerHTML;
  deleteButton.innerHTML = `
    <svg class="w-5 h-5 text-red-600 animate-spin" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="m4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
  `;
  deleteButton.disabled = true;
  
  fetch(`/entries/${ideaId}.json`, {
    method: 'DELETE',
    headers: {
      'Accept': 'application/json',
      'Content-Type': 'application/json',
      'X-CSRF-Token': csrfToken.content
    }
  })
  .then(response => response.json())
  .then(data => {
    if (data && data.success) {
      alert('Идея успешно удалена');
      closeIdeaModal();
      // Remove the card from the grid
      const ideaCard = document.querySelector(`[data-idea-id="${ideaId}"]`);
      if (ideaCard) {
        ideaCard.style.animation = 'fadeOut 0.3s ease';
        setTimeout(() => {
          ideaCard.remove();
        }, 300);
      }
    } else {
      alert('Ошибка при удалении идеи');
      deleteButton.innerHTML = originalContent;
      deleteButton.disabled = false;
    }
  })
  .catch(error => {
    console.error('Delete error:', error);
    alert(`Ошибка при удалении: ${error.message}`);
    deleteButton.innerHTML = originalContent;
    deleteButton.disabled = false;
  });
}

// Research idea function
function researchIdea(ideaId) {
  if (!ideaId) {
    alert('Ошибка: ID идеи не найден');
    return;
  }
  
  if (!confirm('Провести AI-исследование этой идеи? Это может занять несколько минут.')) {
