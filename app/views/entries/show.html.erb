<style>
  /* === AURI ENTRY SHOW PAGE - Linear + Amie Style === */

  :root {
    --bg-darkest: #0a0a0f;
    --bg-card: #1a1a24;
    --bg-card-hover: #22222e;
    --border-subtle: rgba(255, 255, 255, 0.06);
    --border-glow: rgba(139, 92, 246, 0.3);
    --text-primary: #ffffff;
    --text-secondary: #a1a1aa;
    --text-muted: #71717a;
    --violet-500: #8b5cf6;
    --violet-glow: rgba(139, 92, 246, 0.15);
    --amber-500: #f59e0b;
    --blue-500: #3b82f6;
    --green-500: #10b981;
  }

  .animated-bg {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: -1;
    overflow: hidden;
  }

  .animated-bg::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background:
      radial-gradient(circle at 20% 80%, rgba(139, 92, 246, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 40% 40%, rgba(59, 130, 246, 0.08) 0%, transparent 40%);
    animation: gradientMove 20s ease-in-out infinite;
  }

  @keyframes gradientMove {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(2%, 2%) rotate(1deg); }
    50% { transform: translate(-1%, 3%) rotate(-1deg); }
    75% { transform: translate(3%, -2%) rotate(2deg); }
  }

  .glass-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    backdrop-filter: blur(20px);
    transition: all 0.2s ease;
  }

  .gradient-text {
    background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 50%, #6366f1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-link {
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .type-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
  }

  .type-badge.idea {
    background: rgba(245, 158, 11, 0.15);
    color: var(--amber-500);
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .type-badge.diary {
    background: rgba(59, 130, 246, 0.15);
    color: var(--blue-500);
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .type-badge.plan {
    background: rgba(16, 185, 129, 0.15);
    color: var(--green-500);
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
    background: rgba(139, 92, 246, 0.1);
    color: var(--violet-500);
    border: 1px solid rgba(139, 92, 246, 0.2);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in {
    animation: fadeIn 0.4s ease forwards;
  }
</style>

<!-- Animated Background -->
<div class="animated-bg"></div>

<div class="min-h-screen w-full relative">

  <!-- === HEADER === -->
  <header class="sticky top-0 z-50 border-b border-white/5 bg-[#0a0a0f]/80 backdrop-blur-xl">
    <div class="w-full px-6 lg:px-8">
      <div class="flex h-16 items-center justify-between">
        <div class="flex items-center gap-8">
          <a href="/" class="text-2xl font-bold gradient-text">Auri</a>
          <nav class="hidden md:flex items-center gap-1">
            <%= link_to dashboard_path, class: "nav-link" do %>Dashboard<% end %>
            <%= link_to diary_entries_path, class: "nav-link" do %>Дневник<% end %>
            <%= link_to ideas_entries_path, class: "nav-link" do %>Идеи<% end %>
            <%= link_to plans_entries_path, class: "nav-link" do %>Планы<% end %>
            <%= link_to nutrition_entries_path, class: "nav-link" do %>Здоровье<% end %>
            <%= link_to calendar_events_path, class: "nav-link" do %>Календарь<% end %>
          </nav>
        </div>
      </div>
    </div>
  </header>

  <!-- === MAIN CONTENT === -->
  <div class="w-full px-6 lg:px-8 py-8">
    <div class="max-w-4xl mx-auto">

      <!-- Back Button -->
      <div class="mb-6 animate-fade-in">
        <a href="<%= entries_path %>" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white/5 border border-white/5 text-zinc-400 hover:text-white hover:bg-white/10 transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Назад к записям
        </a>
      </div>

      <!-- Entry Card -->
      <div class="glass-card p-8 animate-fade-in" style="animation-delay: 0.1s; opacity: 0;">

        <!-- Entry Header -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6 pb-6 border-b border-white/5">
          <div class="flex items-center gap-4">
            <span class="type-badge <%= @entry.entry_type %>">
              <%= @entry.entry_type == 'idea' ? '💡 Идея' : @entry.entry_type == 'diary' ? '📔 Дневник' : '📋 План' %>
            </span>

            <% if @entry.priority %>
              <span class="text-sm text-zinc-500 flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                </svg>
                Приоритет: <%= @entry.priority %>/10
              </span>
            <% end %>
          </div>

          <div class="flex items-center gap-3 text-sm text-zinc-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <%= @entry.created_at.in_time_zone(@user&.timezone || 'UTC').strftime('%d %B %Y, %H:%M') %>
          </div>
        </div>

        <!-- Entry Content -->
        <div class="mb-8">
          <p class="text-zinc-200 text-lg leading-relaxed whitespace-pre-wrap"><%= @entry.content %></p>
        </div>

        <!-- Tags -->
        <% if @entry.tags.present? %>
          <div class="mb-8">
            <h4 class="text-sm font-medium text-zinc-500 mb-3">Теги</h4>
            <div class="flex flex-wrap gap-2">
              <% @entry.tags.each do |tag| %>
                <span class="tag">#<%= tag %></span>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Calendar Event -->
        <% if @entry.calendar_event %>
          <div class="p-4 rounded-xl bg-blue-500/10 border border-blue-500/20">
            <div class="flex items-center gap-3">
              <div class="p-2 rounded-lg bg-blue-500/20">
                <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <p class="text-white font-medium">Событие в календаре</p>
                <p class="text-sm text-zinc-400">
                  <%= @entry.calendar_event.start_time.in_time_zone(@user&.timezone || 'UTC').strftime('%d %B %Y, %H:%M') %>
                </p>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Child Entries (if any) -->
        <% if @entry.child_entries.any? %>
          <div class="mt-8 pt-8 border-t border-white/5">
            <h4 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
              </svg>
              Связанные размышления (<%= @entry.child_entries.count %>)
            </h4>
            <div class="space-y-4">
              <% @entry.child_entries.each do |child| %>
                <div class="p-4 rounded-xl bg-white/5 border border-white/5">
                  <p class="text-zinc-300 text-sm leading-relaxed"><%= child.content %></p>
                  <p class="text-xs text-zinc-600 mt-2">
                    <%= child.created_at.in_time_zone(@user&.timezone || 'UTC').strftime('%d.%m.%Y %H:%M') %>
                  </p>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Actions -->
        <div class="mt-8 pt-6 border-t border-white/5 flex flex-wrap gap-3">
          <%= link_to edit_entry_path(@entry), class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-violet-500/20 border border-violet-500/30 text-violet-400 hover:bg-violet-500/30 transition-all" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
            Редактировать
          <% end %>

          <%= button_to entry_path(@entry), method: :delete, data: { turbo_confirm: 'Удалить эту запись?' }, class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 hover:bg-red-500/20 transition-all" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
            Удалить
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
