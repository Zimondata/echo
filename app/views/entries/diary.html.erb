<% content_for :title, "Дневник — Echo" %>
<%= render "shared/unified_header" %>
<div class="mx-auto max-w-[1200px] px-4 pb-28 pt-7 sm:px-6 md:pb-12">
  <div class="mb-7"><p class="text-xs font-bold uppercase tracking-[.18em] text-violet-400">Личная запись</p><h1 class="mt-2 text-3xl font-semibold text-white">Дневник</h1><p class="mt-2 text-sm text-zinc-500">Текста достаточно. Теги можно оставить пустыми.</p></div>
  <% if flash[:notice] %><div class="mb-5 rounded-xl border border-emerald-400/20 bg-emerald-400/10 px-4 py-3 text-sm text-emerald-200"><%= flash[:notice] %></div><% end %>

  <section class="mb-6 rounded-2xl border border-white/10 bg-[#12151d] p-5">
    <%= form_with model: @entry, url: entries_path, class: "space-y-3" do |form| %>
      <%= form.text_area :content, rows: 5, placeholder: "Что произошло? Что важно не потерять?", class: "w-full resize-y rounded-xl border border-white/10 bg-[#0d1017] px-4 py-3 text-sm leading-6 text-white outline-none focus:border-violet-400/50", required: true %>
      <div class="grid gap-3 sm:grid-cols-[1fr_220px_auto]"><%= form.text_field :tags, value: @entry.tags, placeholder: "Теги через запятую", class: "rounded-xl border border-white/10 bg-[#0d1017] px-4 py-3 text-sm text-white outline-none focus:border-violet-400/50" %><%= form.datetime_local_field :occurred_at, value: (@entry.occurred_at || Time.current).in_time_zone(current_user.timezone).strftime("%Y-%m-%dT%H:%M"), class: "rounded-xl border border-white/10 bg-[#0d1017] px-3 py-3 text-sm text-zinc-300" %><%= form.submit "Сохранить", class: "cursor-pointer rounded-xl bg-violet-500 px-5 py-3 text-sm font-semibold text-white hover:bg-violet-400" %></div>
      <% if @entry.errors.any? %><p class="text-sm text-red-300"><%= @entry.errors.full_messages.to_sentence %></p><% end %>
    <% end %>
  </section>

  <div class="grid gap-4">
    <% @entries.each do |entry| %>
      <article class="rounded-2xl border border-white/10 bg-[#12151d] p-5" id="entry-<%= entry.id %>">
        <div class="flex flex-wrap items-start justify-between gap-3"><div><time class="text-xs uppercase tracking-wider text-violet-300"><%= russian_datetime(entry.occurred_at, current_user.timezone) %></time><p class="mt-3 whitespace-pre-wrap leading-7 text-zinc-200"><%= entry.content %></p></div><%= button_to "Удалить", entry_path(entry), method: :delete, data: { turbo_confirm: "Удалить запись?" }, class: "rounded-lg border border-white/10 px-3 py-2 text-xs text-zinc-600 hover:border-red-400/20 hover:text-red-300" %></div>
        <% if entry.tag_list.any? %><div class="mt-4 flex flex-wrap gap-2 border-t border-white/[.07] pt-4"><% entry.tag_list.each do |tag| %><span class="rounded-full bg-white/5 px-2.5 py-1 text-xs text-zinc-500">#<%= tag %></span><% end %></div><% end %>

      </article>
    <% end %>
    <% if @entries.empty? %><div class="rounded-2xl border border-dashed border-white/10 p-12 text-center"><p class="text-lg font-medium text-zinc-300">Записей пока нет</p><p class="mt-2 text-sm text-zinc-600">Начни с нескольких слов о том, что произошло.</p></div><% end %>
  </div>
</div>
