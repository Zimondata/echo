<div class="min-h-screen bg-gradient-to-br from-violet-50 via-purple-50 to-fuchsia-50">
  <!-- Header with glassmorphism -->
  <div class="sticky top-0 z-30 backdrop-blur-xl bg-white/60 border-b border-purple-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 bg-gradient-to-br from-violet-500 to-fuchsia-500 rounded-2xl flex items-center justify-center text-white text-2xl shadow-lg shadow-purple-200">
            📔
          </div>
          <div>
            <h1 class="text-3xl font-bold bg-gradient-to-r from-violet-600 to-fuchsia-600 bg-clip-text text-transparent">
              Мой дневник
            </h1>
            <p class="text-sm text-gray-500">Ваши мысли и воспоминания</p>
          </div>
        </div>
        
        <div class="flex items-center gap-3">
          <!-- New Entry Button -->
          <button onclick="window.open('https://t.me/auriAI_bot', '_blank')" class="px-4 py-2.5 bg-gradient-to-r from-violet-600 to-fuchsia-600 text-white rounded-xl font-medium hover:shadow-lg hover:shadow-purple-200 transition-all flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Новая запись
          </button>
          
          <!-- Back to dashboard -->
          <a href="/dashboard" class="px-4 py-2.5 bg-white/50 backdrop-blur-sm border border-purple-200 rounded-xl text-sm font-medium text-gray-700 hover:bg-white/80 transition-all">
            ← Дашборд
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Search and Filters Card -->
    <div class="mb-8 bg-white/60 backdrop-blur-xl rounded-2xl border border-purple-100 shadow-xl shadow-purple-100/20 p-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Search -->
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input type="text" 
                 id="searchInput"
                 placeholder="Поиск записей, тегов..." 
                 class="w-full pl-10 pr-4 py-2.5 bg-white/50 backdrop-blur-sm border border-purple-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/20 focus:border-purple-400">
        </div>
        
        <!-- Mood Filter -->
        <select id="moodFilter" onchange="filterByMood(this.value)" class="px-4 py-2.5 bg-white/50 backdrop-blur-sm border border-purple-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/20 focus:border-purple-400">
          <option value="all">😊 Все настроения</option>
          <option value="happy">😊 Счастливый</option>
          <option value="calm">☁️ Спокойный</option>
          <option value="energetic">⚡ Энергичный</option>
          <option value="thoughtful">🌙 Задумчивый</option>
          <option value="melancholic">☕ Меланхоличный</option>
        </select>
        
        <!-- Date Filter -->
        <select id="dateFilter" onchange="filterByPeriod(this.value)" class="px-4 py-2.5 bg-white/50 backdrop-blur-sm border border-purple-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/20 focus:border-purple-400">
          <option value="all">📅 Все время</option>
          <option value="today">Сегодня</option>
          <option value="week">Эта неделя</option>
          <option value="month">Этот месяц</option>
        </select>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Main Content - Diary Entries -->
      <div class="lg:col-span-2">
        <% if @entries.any? %>
          <div class="space-y-4" id="entriesContainer">
            <% @entries.each_with_index do |entry, index| %>
              <% 
                moods = ['happy', 'calm', 'energetic', 'thoughtful', 'melancholic']
                mood_colors = {
                  'happy' => 'from-yellow-500/20 to-orange-500/20 border-yellow-500/30',
                  'calm' => 'from-blue-500/20 to-cyan-500/20 border-blue-500/30',
                  'energetic' => 'from-purple-500/20 to-pink-500/20 border-purple-500/30',
                  'thoughtful' => 'from-indigo-500/20 to-violet-500/20 border-indigo-500/30',
                  'melancholic' => 'from-gray-500/20 to-slate-500/20 border-gray-500/30'
                }
                mood_emojis = {
                  'happy' => '☀️',
                  'calm' => '☁️',
                  'energetic' => '⚡',
                  'thoughtful' => '🌙',
                  'melancholic' => '☕'
                }
                entry_mood = entry.metadata&.dig('mood') || moods[index % 5]
                mood_color = mood_colors[entry_mood]
                mood_emoji = mood_emojis[entry_mood]
              %>
              
              <div id="entry-<%= entry.id %>" class="diary-entry group bg-gradient-to-br <%= mood_color %> backdrop-blur-xl rounded-2xl border shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-[1.01]" 
                   data-date="<%= entry.created_at.to_date %>"
                   data-mood="<%= entry_mood %>"
                   data-content="<%= entry.content.downcase %>">
                
                <!-- Entry Header -->
                <div class="px-6 py-5">
                  <div class="flex items-start justify-between mb-4">
                    <div class="flex items-start gap-3">
                      <!-- Mood Icon -->
                      <div class="p-2.5 rounded-xl bg-white/50 backdrop-blur-sm border border-white/50">
                        <span class="text-2xl"><%= mood_emoji %></span>
                      </div>
                      
                      <div class="flex-1">
                        <h3 class="text-xl font-semibold text-gray-900 mb-1">
                          <%= entry.metadata&.dig('summary').presence || "Запись от #{entry.created_at.strftime('%d %B')}" %>
                        </h3>
                        <div class="flex items-center gap-3 text-sm text-gray-600">
                          <span class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            <%= entry.created_at.strftime('%d %B %Y') %>
                          </span>
                          <span class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <%= entry.created_at.strftime('%H:%M') %>
                          </span>
                        </div>
                      </div>
                    </div>
                    
                    <!-- Options menu -->
                    <div class="relative">
                      <button onclick="toggleEntryMenu('<%= entry.id %>')" class="p-2 hover:bg-white/30 rounded-lg transition-colors opacity-0 group-hover:opacity-100">
                        <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"/>
                        </svg>
                      </button>
                      
                      <!-- Dropdown menu -->
                      <div id="menu-<%= entry.id %>" class="hidden absolute right-0 top-full mt-1 w-48 bg-white/90 backdrop-blur-sm border border-gray-200 rounded-lg shadow-lg z-10">
                        <!-- Change type section -->
                        <div class="px-3 py-2 border-b border-gray-200">
                          <div class="text-xs text-gray-500 mb-1">Переместить в:</div>
                          <div class="space-y-1">
                            <% if entry.entry_type != 'idea' %>
                              <button onclick="changeEntryType('<%= entry.id %>', 'idea')" class="w-full px-2 py-1 text-left text-xs text-yellow-600 hover:bg-yellow-50 rounded flex items-center gap-2">
                                💡 Идеи
                              </button>
                            <% end %>
                            <% if entry.entry_type != 'plan' %>
                              <button onclick="changeEntryType('<%= entry.id %>', 'plan')" class="w-full px-2 py-1 text-left text-xs text-blue-600 hover:bg-blue-50 rounded flex items-center gap-2">
                                📋 Планы
                              </button>
                            <% end %>
                            <% if entry.entry_type != 'diary' %>
                              <button onclick="changeEntryType('<%= entry.id %>', 'diary')" class="w-full px-2 py-1 text-left text-xs text-purple-600 hover:bg-purple-50 rounded flex items-center gap-2">
                                📔 Дневник
                              </button>
                            <% end %>
                          </div>
                        </div>
                        
                        <!-- Delete button -->
                        <button onclick="deleteEntry('<%= entry.id %>')" class="w-full px-3 py-2 text-left text-sm text-red-600 hover:bg-red-50 rounded-lg flex items-center gap-2">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                          </svg>
                          Удалить
                        </button>
                      </div>
                    </div>
                  </div>
                  
                  <!-- Entry Content -->
                  <p class="text-gray-700 leading-relaxed mb-4">
                    <%= entry.content %>
                  </p>
                  
                  <!-- Tags -->
                  <% if entry.tags.present? && entry.tags.any? %>
                    <div class="flex flex-wrap gap-2">
                      <% entry.tags.each do |tag| %>
                        <span class="px-3 py-1.5 bg-white/50 backdrop-blur-sm rounded-full text-xs font-medium text-gray-700 flex items-center gap-1">
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                          </svg>
                          <%= tag %>
                        </span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <!-- Empty State -->
          <div class="bg-white/60 backdrop-blur-xl rounded-2xl border border-purple-100 shadow-xl p-12 text-center">
            <div class="w-24 h-24 bg-gradient-to-br from-violet-100 to-fuchsia-100 rounded-full flex items-center justify-center mx-auto mb-6">
              <span class="text-5xl">📔</span>
            </div>
            <h3 class="text-2xl font-semibold text-gray-900 mb-3">Начните вести дневник</h3>
            <p class="text-gray-500 max-w-md mx-auto mb-6">
              Отправьте боту свои мысли, чувства и события дня. Все записи будут сохранены здесь.
            </p>
            <a href="https://t.me/auriAI_bot" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-violet-600 to-fuchsia-600 text-white font-medium rounded-xl hover:shadow-lg hover:shadow-purple-200 transition-all">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.56c-.21 2.27-1.13 7.75-1.6 10.29-.2 1.08-.59 1.44-.97 1.47-.82.07-1.45-.54-2.24-.97-1.24-.68-1.94-1.1-3.14-1.77-1.39-.77-.49-1.19.3-1.88.21-.18 3.85-3.52 3.92-3.82.01-.04.02-.18-.07-.26s-.22-.05-.32-.03c-.14.03-2.31 1.47-6.52 4.31-.62.43-1.17.63-1.67.62-.55-.01-1.6-.31-2.39-.56-.96-.31-1.72-.47-1.66-1 .04-.27.42-.55 1.16-.83 4.54-1.97 7.57-3.28 9.08-3.91 4.33-1.82 5.23-2.14 5.82-2.15.13 0 .41.03.59.18.15.12.19.29.21.43.02.14.05.3.04.46z"/>
              </svg>
              Написать боту
            </a>
          </div>
        <% end %>
      </div>

      <!-- Statistics Sidebar -->
      <div class="space-y-4">
        <!-- Main Stats Card -->
        <div class="bg-white/60 backdrop-blur-xl rounded-2xl border border-purple-100 shadow-xl">
          <div class="p-6">
            <h3 class="font-semibold text-gray-900 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
              Статистика
            </h3>
            
            <!-- Total Entries -->
            <div class="p-4 rounded-xl bg-gradient-to-br from-violet-500/10 to-fuchsia-500/10 border border-violet-500/20 mb-4">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm text-gray-600">Всего записей</span>
                <svg class="w-4 h-4 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                </svg>
              </div>
              <p class="text-3xl font-bold bg-gradient-to-r from-violet-600 to-fuchsia-600 bg-clip-text text-transparent">
                <%= @entries.count %>
              </p>
            </div>

            <!-- Mood Distribution -->
            <div class="mb-4">
              <h4 class="text-sm font-semibold text-gray-700 mb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-pink-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
                </svg>
                Распределение настроений
              </h4>
              <div class="space-y-3">
                <% 
                  mood_stats = {
                    'happy' => { name: 'Счастливый', icon: '☀️', color: 'from-yellow-500 to-orange-500', count: @entries.select { |e| (e.metadata&.dig('mood') || 'happy') == 'happy' }.count },
                    'calm' => { name: 'Спокойный', icon: '☁️', color: 'from-blue-500 to-cyan-500', count: @entries.select { |e| e.metadata&.dig('mood') == 'calm' }.count },
                    'energetic' => { name: 'Энергичный', icon: '⚡', color: 'from-purple-500 to-pink-500', count: @entries.select { |e| e.metadata&.dig('mood') == 'energetic' }.count },
                    'thoughtful' => { name: 'Задумчивый', icon: '🌙', color: 'from-indigo-500 to-violet-500', count: @entries.select { |e| e.metadata&.dig('mood') == 'thoughtful' }.count }
                  }
                  max_count = mood_stats.values.map { |s| s[:count] }.max.to_f
                  max_count = 1 if max_count == 0
                %>
                <% mood_stats.each do |key, stat| %>
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <span class="text-lg"><%= stat[:icon] %></span>
                      <span class="text-sm text-gray-600"><%= stat[:name] %></span>
                    </div>
                    <div class="flex items-center gap-2">
                      <div class="w-24 h-2 bg-gray-200 rounded-full overflow-hidden">
                        <div class="h-full bg-gradient-to-r <%= stat[:color] %> transition-all duration-500"
                             style="width: <%= (stat[:count] / max_count * 100).round %>%"></div>
                      </div>
                      <span class="text-sm font-semibold text-gray-700 w-6 text-right"><%= stat[:count] %></span>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>

            <hr class="my-4 border-gray-200">

            <!-- Recent Tags -->
            <div>
              <h4 class="text-sm font-semibold text-gray-700 mb-3">Популярные теги</h4>
              <div class="flex flex-wrap gap-2">
                <% 
                  all_tags = @entries.flat_map(&:tags).compact
                  tag_counts = all_tags.group_by(&:itself).transform_values(&:count)
                  top_tags = tag_counts.sort_by { |_, count| -count }.first(6)
                %>
                <% top_tags.each do |tag, count| %>
                  <span class="px-2.5 py-1.5 bg-white/50 backdrop-blur-sm border border-purple-200 rounded-lg text-xs font-medium text-gray-700 hover:bg-violet-500/10 cursor-pointer transition-colors">
                    <%= tag %> (<%= count %>)
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Streak Card -->
        <div class="bg-gradient-to-br from-violet-500/10 to-fuchsia-500/10 backdrop-blur-xl rounded-2xl border border-violet-500/20 shadow-xl p-6">
          <div class="text-center">
            <div class="w-12 h-12 rounded-full bg-gradient-to-r from-violet-600 to-fuchsia-600 flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Продолжайте писать!</h3>
            <p class="text-sm text-gray-600 mb-4">
              <% 
                days_with_entries = @entries.group_by { |e| e.created_at.to_date }.keys.sort.reverse
                streak = 0
                current_date = Date.current
                days_with_entries.each do |date|
                  if date == current_date - streak.days
                    streak += 1
                  else
                    break
                  end
                end
              %>
              У вас <%= streak %>-дневная серия записей
            </p>
            <div class="flex justify-center gap-1">
              <% 7.times do |i| %>
                <div class="w-2 h-8 rounded-full bg-gradient-to-t from-violet-600 to-fuchsia-600"
                     style="opacity: <%= 1 - (i * 0.1) %>"></div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes fadeOut {
    from {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(0.95);
    }
  }
</style>

<script>
  // Toggle entry options menu
  function toggleEntryMenu(entryId) {
    const menu = document.getElementById(`menu-${entryId}`);
    const allMenus = document.querySelectorAll('[id^="menu-"]');
    
    // Hide all other menus
    allMenus.forEach(m => {
      if (m.id !== `menu-${entryId}`) {
        m.classList.add('hidden');
      }
    });
    
    // Toggle current menu
    menu.classList.toggle('hidden');
  }
  
  // Change entry type
  function changeEntryType(entryId, newType) {
    if (!confirm(`Переместить запись в раздел "${getTypeName(newType)}"?`)) {
      return;
    }
    
    const csrfToken = document.querySelector('[name="csrf-token"]');
    if (!csrfToken) {
      alert('CSRF токен не найден');
      return;
    }
    
    console.log('Changing entry type:', entryId, 'to', newType);
    
    fetch(`/entries/${entryId}.json`, {
      method: 'PATCH',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken.content
      },
      body: JSON.stringify({
        entry: {
          entry_type: newType
        }
      })
    })
    .then(response => {
      console.log('Change type response status:', response.status);
      
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      
      const contentType = response.headers.get('content-type');
      if (contentType && contentType.includes('application/json')) {
        return response.json();
      } else {
        return response.text().then(text => {
          console.error('Expected JSON but got:', text);
          throw new Error('Server returned non-JSON response');
        });
      }
    })
    .then(data => {
      console.log('Change type response data:', data);
      
      if (data && data.success) {
        // Show success message and reload page
        alert(`Запись перемещена в "${getTypeName(newType)}"`);
        location.reload();
      } else {
        alert('Ошибка при изменении типа записи');
      }
    })
    .catch(error => {
      console.error('Change type error:', error);
      alert(`Ошибка при изменении типа: ${error.message}`);
    });
  }
  
  function getTypeName(type) {
    const typeNames = {
      'idea': 'Идеи',
      'plan': 'Планы', 
      'diary': 'Дневник'
    };
    return typeNames[type] || type;
  }

  // Delete entry
  function deleteEntry(entryId) {
    if (!confirm('Вы уверены, что хотите удалить эту запись?')) {
      return;
    }
    
    const csrfToken = document.querySelector('[name="csrf-token"]');
    if (!csrfToken) {
      alert('CSRF токен не найден');
      return;
    }
    
    console.log('Deleting entry:', entryId);
    console.log('Current user ID:', '<%= current_user&.id %>');
    
    fetch(`/entries/${entryId}.json`, {
      method: 'DELETE',
      headers: {
        'Accept': 'application/json',
        'X-CSRF-Token': csrfToken.content
      }
    })
    .then(response => {
      console.log('Delete response status:', response.status);
      console.log('Delete response headers:', response.headers.get('content-type'));
      
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      
      // Check if response is actually JSON
      const contentType = response.headers.get('content-type');
      if (contentType && contentType.includes('application/json')) {
        return response.json();
      } else {
        // If not JSON, get text to see what we actually received
        return response.text().then(text => {
          console.error('Expected JSON but got:', text);
          throw new Error('Server returned non-JSON response');
        });
      }
    })
    .then(data => {
      console.log('Delete response data:', data);
      console.log('Data type:', typeof data);
      
      if (data && data.success) {
        // Remove entry from DOM with animation
        const entryElement = document.getElementById(`entry-${entryId}`);
        entryElement.style.animation = 'fadeOut 0.3s ease';
        setTimeout(() => {
          entryElement.remove();
          // Update stats if needed
          location.reload();
        }, 300);
      } else {
        alert('Ошибка при удалении записи');
      }
    })
    .catch(error => {
      console.error('Delete error:', error);
      alert(`Ошибка при удалении записи: ${error.message}`);
    });
  }
  
  // Close menus when clicking outside
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.relative')) {
      const allMenus = document.querySelectorAll('[id^="menu-"]');
      allMenus.forEach(menu => menu.classList.add('hidden'));
    }
  });

  // Search functionality
  document.getElementById('searchInput').addEventListener('input', function(e) {
    const searchTerm = e.target.value.toLowerCase();
    const entries = document.querySelectorAll('.diary-entry');
    
    entries.forEach(entry => {
      const content = entry.dataset.content;
      if (content.includes(searchTerm) || searchTerm === '') {
        entry.style.display = 'block';
      } else {
        entry.style.display = 'none';
      }
    });
  });

  // Filter by period
  function filterByPeriod(period) {
    const entries = document.querySelectorAll('.diary-entry');
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    
    entries.forEach(entry => {
      const entryDate = new Date(entry.dataset.date);
      entryDate.setHours(0, 0, 0, 0);
      
      let show = false;
      
      switch(period) {
        case 'today':
          show = entryDate.getTime() === today.getTime();
          break;
        case 'week':
          const weekAgo = new Date(today);
          weekAgo.setDate(weekAgo.getDate() - 7);
          show = entryDate >= weekAgo;
          break;
        case 'month':
          const monthAgo = new Date(today);
          monthAgo.setMonth(monthAgo.getMonth() - 1);
          show = entryDate >= monthAgo;
          break;
        case 'all':
        default:
          show = true;
      }
      
      entry.style.display = show ? 'block' : 'none';
    });
  }

  // Filter by mood
  function filterByMood(mood) {
    const entries = document.querySelectorAll('.diary-entry');
    
    entries.forEach(entry => {
      if (mood === 'all' || entry.dataset.mood === mood) {
        entry.style.display = 'block';
      } else {
        entry.style.display = 'none';
      }
    });
  }
</script>