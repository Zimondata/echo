<div class="min-h-screen bg-gradient-to-br from-violet-50 via-purple-50 to-fuchsia-50 py-12">
  <div class="container mx-auto px-4 max-w-3xl">
    
    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-800 mb-2">
        <% if @entry.entry_type == 'idea' %>
          💡 Редактировать идею
        <% elsif @entry.entry_type == 'plan' %>
          📋 Редактировать план
        <% elsif @entry.entry_type == 'diary' %>
          📔 Редактировать запись дневника
        <% else %>
          ✏️ Редактировать запись
        <% end %>
      </h1>
      <p class="text-gray-600">Обновите содержание вашей записи</p>
    </div>

    <!-- Form -->
    <div class="bg-white/80 backdrop-blur-sm rounded-2xl shadow-xl border border-purple-100/50 p-8">
      <%= form_with model: @entry, local: true, data: { turbo: false }, html: { class: "space-y-6" } do |form| %>
        
        <!-- Error handling -->
        <% if @entry.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
            <div class="flex items-center gap-2 text-red-800 font-medium mb-2">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
              </svg>
              Ошибки при сохранении:
            </div>
            <ul class="list-disc list-inside text-red-700 text-sm space-y-1">
              <% @entry.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Entry Type (read-only display) -->
        <div class="form-group">
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Тип записи
          </label>
          <div class="px-4 py-3 bg-gray-50 rounded-lg border border-gray-200">
            <span class="inline-flex items-center gap-2 text-gray-800 font-medium">
              <% case @entry.entry_type %>
              <% when 'idea' %>
                💡 Идея
              <% when 'plan' %>
                📋 План
              <% when 'diary' %>
                📔 Дневник
              <% else %>
                📝 Запись
              <% end %>
            </span>
          </div>
        </div>

        <!-- Content -->
        <div class="form-group">
          <%= form.label :content, "Содержание", class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= form.text_area :content, 
                placeholder: "Введите содержание вашей записи...",
                rows: 12,
                class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent resize-vertical min-h-[200px] transition-colors",
                required: true %>
        </div>

        <!-- Priority (for plans) -->
        <% if @entry.entry_type == 'plan' %>
          <div class="form-group">
            <%= form.label :priority, "Приоритет", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.select :priority, 
                  options_for_select([
                    ['Низкий', 'low'],
                    ['Средний', 'medium'],
                    ['Высокий', 'high'],
                    ['Критический', 'critical']
                  ], @entry.priority),
                  { prompt: 'Выберите приоритет' },
                  { class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent" } %>
          </div>
        <% end %>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 pt-6">
          <%= form.submit "Сохранить изменения", 
                class: "flex-1 bg-gradient-to-r from-violet-600 to-purple-600 text-white py-3 px-6 rounded-lg font-medium hover:shadow-lg transform hover:scale-105 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2" %>
          
          <%= link_to "Отмена", 
                (@entry.entry_type == 'idea' ? ideas_entries_path : entries_path),
                class: "flex-1 bg-gray-100 text-gray-700 py-3 px-6 rounded-lg font-medium hover:bg-gray-200 transition-colors text-center border border-gray-300" %>
        </div>
      <% end %>
    </div>

    <!-- Additional Actions -->
    <div class="mt-8 text-center">
      <%= link_to "← Вернуться к списку", 
            (@entry.entry_type == 'idea' ? ideas_entries_path : entries_path),
            class: "inline-flex items-center gap-2 text-purple-600 hover:text-purple-800 font-medium transition-colors" %>
    </div>
  </div>
</div>